<Window
    x:Class="PuppyMacro.PickPointWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pick a point"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#26000000"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    Cursor="Cross"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White"
    MouseLeftButtonDown="OnClick"
    PreviewKeyDown="OnKeyDown">

    <Canvas>
        <Border x:Name="Instructions" Padding="16,10" CornerRadius="8" BorderThickness="1"
                Background="#F2202020" BorderBrush="#1FFFFFFF" Cursor="Arrow">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="13" Text="Click the point the cursor should go to" VerticalAlignment="Center" />
                <Border Margin="16,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="Esc" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="Cancel" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
