<Window
    x:Class="PuppyMacro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:fsi="clr-namespace:iNKORE.UI.WPF.Modern.Common.IconKeys;assembly=iNKORE.UI.WPF.Modern"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    Title="PuppyMacro"
    Icon="pack://application:,,,/Assets/PuppyMacro.ico"
    Width="800"
    Height="900"
    MinWidth="560"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.Height="48"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed"
    AllowDrop="True"
    PreviewDragEnter="OnFileDragOver"
    PreviewDragOver="OnFileDragOver"
    PreviewDragLeave="OnFileDragLeave"
    PreviewDrop="OnFileDrop">

    <Window.Resources>
        <!-- Cards of a list: 4 apart, as in Windows Settings -->
        <ItemsPanelTemplate x:Key="CardListPanel">
            <ikw:SimpleStackPanel Spacing="4" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Title bar (approved, ui.md): 48 px as in Microsoft Store; icon and name on the left, Enter overlay
             mode, More options (Import…, Export…) and Stop all on the right before the window buttons drawn by the library (as its
             ButtonsOnTitlebar sample) ================= -->
        <!-- Left to right in every language: the window buttons the library draws stay on the right (i18n.md) -->
        <Grid Grid.Row="0" Height="{Binding (ui:TitleBar.Height), RelativeSource={RelativeSource AncestorType=Window}}"
              FlowDirection="LeftToRight">
            <!-- The buttons' column is as wide as they are: two * columns would give it half the window, too little for
                 Enter overlay mode and Stop all at the default 800 px in some languages -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                <!-- 24 px: 12 px above and below it in the 48 px bar -->
                <Image Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/PuppyMacro-256.png" />
                <!-- The name, and DEV in the secondary text color in a development build -->
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}">
                    <Run Text="PuppyMacro" />
                    <Run x:Name="DevBuildRun" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </StackPanel>


            <!-- On the right: Enter overlay mode, More options (Import…, Export…), Stop all, the window buttons. The buttons sit 9 px from the top: the window's
                 1 px border, then 8, so they look 8 px from the top and from the bottom (their bottom line is almost the bar's
                 color), as Microsoft Store's search box -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OverlayModeButton" Margin="0,9,8,0" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{x:Static r:Strings.Main_EnterOverlayMode}" Click="OnOverlayModeClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Margin="0,0,8,0" FontSize="16" Icon="{x:Static ui:SegoeFluentIcons.MapLayers}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Main_EnterOverlayMode}" />
                    </StackPanel>
                </Button>
                <!-- More options: Import… and Export… of loops, macros and remaps as .puppyitems files (MainWindow.Share.cs; not
                     the backup), in a menu (approved design B, the Design canvas "PuppyMacro Import, remap without key, title bar") -->
                <Button x:Name="TitleMoreButton" Margin="0,9,8,0" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{x:Static r:Strings.Card_MoreOptions}" ToolTip="{x:Static r:Strings.Card_MoreOptions}"
                        Click="OnTitleMoreClick">
                    <ui:FontIcon FontSize="16" Icon="{x:Static ui:SegoeFluentIcons.More}" />
                </Button>
                <!-- Shown only while something runs. Approved (ui.md): the accent button with its accent colors replaced by
                     the theme's critical one (WinUI lightweight styling), at 90% and 80% on mouse over and press as the
                     accent ones are. -->
                <Button x:Name="StopAllButton" Margin="0,9,8,0" VerticalAlignment="Top" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Static r:Strings.Main_StopAll}" Click="OnStopAllClick">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource SystemFillColorCritical}" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource SystemFillColorCritical}" Opacity="0.9" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource SystemFillColorCritical}" Opacity="0.8" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Margin="0,0,8,0" FontSize="16" Icon="{x:Static fsi:FluentSystemIcons.Stop_16_Filled}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Main_StopAll}" />
                    </StackPanel>
                </Button>
                <!-- The window buttons' place, 8 more px before them: 16 from our last button -->
                <Rectangle Margin="8,0,0,0"
                           Width="{Binding (ui:TitleBar.SystemOverlayRightInset), RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- ================= Development build (make dev) ================= -->
            <Border x:Name="DevBuildStrip" Padding="0,3" Background="#E8822E" Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A"
                           Text="{x:Static r:Strings.Main_DevelopmentBuild}" />
            </Border>

            <!-- ================= Update available ================= -->
            <!-- Collapsed while closed: a closed InfoBar hides only its content and would keep its margin -->
            <ui:InfoBar x:Name="UpdateBar" Severity="Informational" IsOpen="False" Visibility="Collapsed"
                        CloseButtonClick="OnUpdateLaterClick">
                <ui:InfoBar.ActionButton>
                    <!-- The InfoBar gives its action the rest of the row: on the right, next to the close button -->
                    <Button x:Name="UpdateBarButton" HorizontalAlignment="Right" Click="OnUpdateActionClick" />
                </ui:InfoBar.ActionButton>
                <ui:InfoBar.Content>
                    <!-- 46 on the right: as far from the right edge as it starts from the left (the library's InfoBarContentRootPadding
                         16 + InfoBarIconFontSize 16 + InfoBarIconMargin 14); while downloading no close button ends the row -->
                    <ProgressBar x:Name="UpdateBarProgress" Margin="0,0,46,12" Maximum="100" Visibility="Collapsed" />
                </ui:InfoBar.Content>
            </ui:InfoBar>
        </StackPanel>

        <!-- ================= Side rail (Loops, Macros, Remap, Settings) and the pages ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SideRail x:Name="Rail" />

            <!-- The pages on the content layer, as the NavigationView draws it (Microsoft Store, Windows Settings):
                 slightly lighter, a thin line on the top and left, the top-left corner rounded -->
            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <!-- ================= Status bar (approved design): the AI apps connected right now, each with a green dot whose halo
                     pulses slowly (still when Windows' animations are off). Shown only while one is connected, on the right, inside the content layer (the side rail runs the whole height); a click opens the AI page. ================= -->
                <Border x:Name="AiStatusBar" DockPanel.Dock="Bottom" Height="28" Padding="16,0" BorderThickness="0,1,0,0" Visibility="Collapsed"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="Transparent"
                        MouseLeftButtonUp="OnAiStatusBarClick" ToolTip="{x:Static r:Strings.AiStatus_ToolTip}"
                        AutomationProperties.Name="{x:Static r:Strings.AiStatus_Name}">
                    <ItemsControl x:Name="AiStatusList" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="18" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse x:Name="Halo" Fill="{DynamicResource SystemFillColorSuccessBrush}" RenderTransformOrigin="0.5,0.5"
                                                 Opacity="0" Visibility="{Binding HaloVisibility}">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.8" Duration="0:0:2.4">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.8" Duration="0:0:2.4">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0" Duration="0:0:2.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </Grid>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            <Grid>

                <!-- ================= Loops page ================= -->
                <Grid x:Name="LoopsPage" Margin="40,12,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Static r:Strings.Loops_Title}" />
                        <Button x:Name="AddLoopButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}" Content="{x:Static r:Strings.Loops_Add}"
                                ToolTipService.ShowOnDisabled="True" Click="OnAddLoopClick" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Loops_Search}" TextChanged="OnSearchChanged" />
                        <ComboBox x:Name="FilterBox" Grid.Column="1" Margin="12,0,0,0" MinWidth="130" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="{x:Static r:Strings.Loops_FilterAll}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterEnabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterDisabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterRunning}" />
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="CountText" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:ScrollViewerEx Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="EmptyLoopsText" Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="LoopList" ItemsPanel="{StaticResource CardListPanel}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:LoopItemViewModel}">
                                        <StackPanel>
                                            <Border Height="3" Margin="0,0,0,3" CornerRadius="2"
                                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                    Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:SettingsCard x:Name="Card" AllowDrop="True" Tag="{Binding}"
                                                             PreviewMouseLeftButtonDown="OnCardMouseDown" PreviewMouseMove="OnCardMouseMove"
                                                             DragOver="OnCardDragOver" DragLeave="OnCardDragLeave" Drop="OnCardDrop">
                                                <ui:SettingsCard.HeaderIcon>
                                                    <Grid x:Name="TypeIcon">
                                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}"
                                                                     Visibility="{Binding ShowKeyIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Mouse}"
                                                                     Visibility="{Binding ShowMouseIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Font}"
                                                                     Visibility="{Binding ShowTextIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BulletedList}"
                                                                     Visibility="{Binding ShowListIcon, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </ui:SettingsCard.HeaderIcon>
                                                <ui:SettingsCard.Header>
                                                    <StackPanel x:Name="HeaderPanel" Orientation="Horizontal">
                                                        <TextBlock MaxWidth="260" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <ui:InfoBadge x:Name="StatusBadge" Margin="10,0,6,0" VerticalAlignment="Center" Style="{StaticResource IdleDotInfoBadgeStyle}" />
                                                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Status}" />
                                                        <!-- Specific app: the app it works in -->
                                                        <StackPanel x:Name="AppPanel" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasApp, Converter={StaticResource BoolToVisibility}}"
                                                                    TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <ui:FontIcon FontSize="12" VerticalAlignment="Center" Icon="{x:Static ui:SegoeFluentIcons.AppIconDefault}" />
                                                            <TextBlock x:Name="AppText" Margin="6,0,0,0" MaxWidth="200" Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" Text="{Binding AppExe}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:SettingsCard.Header>
                                                <ui:SettingsCard.Description>
                                                    <!-- Two text lines, as on every list page: the same card height on Loops, Macros and Remap -->
                                                    <StackPanel x:Name="DescriptionPanel">
                                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                                        <!-- MinHeight: the height of a line with keys, so every card is as tall with or without a hotkey -->
                                                        <StackPanel MinHeight="22" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding ActivationLead}" />
                                                            <ItemsControl Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding HotkeyParts}"
                                                                          ItemTemplate="{StaticResource AccentKeyCapItem}" ItemsPanel="{StaticResource KeyCapRow}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:SettingsCard.Description>
                                                <views:ItemCardActions IsHoldMode="{Binding IsHoldMode}" IsRunning="{Binding IsRunning}"
                                                                       CanPlay="{Binding CanStartStop}" CanEdit="{Binding CanEdit}" CanMore="{Binding IsNotRunning}"
                                                                       IsOn="{Binding IsLoopEnabled}" PlayClick="OnStartStopClick" EditClick="OnEditLoopClick"
                                                                       MoreClick="OnMoreClick" />
                                            </ui:SettingsCard>
                                            <Border Height="3" Margin="0,3,0,0" CornerRadius="2"
                                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                    Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                                                <!-- Disabled: greyed like a disabled card, while its switch and menu stay usable (approved, ui.md) -->
                                                <Setter TargetName="TypeIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="HeaderPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="AppPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="DescriptionPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource CautionDotInfoBadgeStyle}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource SuccessDotInfoBadgeStyle}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:ScrollViewerEx>
                </Grid>

                <!-- ================= Macros page ================= -->
                <Grid x:Name="MacrosPage" Margin="40,12,40,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Static r:Strings.Macros_Title}" />
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="NewMacroButton" Style="{StaticResource AccentButtonStyle}" Content="{x:Static r:Strings.Macros_Add}" ToolTipService.ShowOnDisabled="True" Click="OnNewMacroClick" />
                            <!-- A standard button with a red dot before its text (approved, ui.md) -->
                            <Button x:Name="RecordMacroButton" Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static r:Strings.Macros_Record}" ToolTipService.ShowOnDisabled="True" Click="OnRecordMacroClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:InfoBadge Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource CriticalDotInfoBadgeStyle}" />
                                    <TextBlock Text="{x:Static r:Strings.Macros_Record}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MacroSearchBox" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Macros_Search}" TextChanged="OnMacroSearchChanged" />
                        <ComboBox x:Name="MacroFilterBox" Grid.Column="1" Margin="12,0,0,0" MinWidth="130" SelectionChanged="OnMacroFilterChanged">
                            <ComboBoxItem Content="{x:Static r:Strings.Macros_FilterAll}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterEnabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterDisabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterRunning}" />
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="MacroCountText" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:ScrollViewerEx Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="EmptyMacrosText" Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="MacroList" ItemsPanel="{StaticResource CardListPanel}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:MacroItemViewModel}">
                                        <StackPanel>
                                            <Border Height="3" Margin="0,0,0,3" CornerRadius="2"
                                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                    Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:SettingsCard x:Name="Card" AllowDrop="True" Tag="{Binding}"
                                                             PreviewMouseLeftButtonDown="OnCardMouseDown" PreviewMouseMove="OnCardMouseMove"
                                                             DragOver="OnCardDragOver" DragLeave="OnCardDragLeave" Drop="OnCardDrop">
                                                <ui:SettingsCard.HeaderIcon>
                                                    <ui:FontIcon x:Name="TypeIcon" Icon="{x:Static ui:SegoeFluentIcons.BulletedList}" />
                                                </ui:SettingsCard.HeaderIcon>
                                                <ui:SettingsCard.Header>
                                                    <StackPanel x:Name="HeaderPanel" Orientation="Horizontal">
                                                        <TextBlock MaxWidth="260" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <ui:InfoBadge x:Name="StatusBadge" Margin="10,0,6,0" VerticalAlignment="Center" Style="{StaticResource IdleDotInfoBadgeStyle}" />
                                                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Status}" />
                                                        <!-- Specific app: the app it works in -->
                                                        <StackPanel x:Name="AppPanel" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasApp, Converter={StaticResource BoolToVisibility}}"
                                                                    TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <ui:FontIcon FontSize="12" VerticalAlignment="Center" Icon="{x:Static ui:SegoeFluentIcons.AppIconDefault}" />
                                                            <TextBlock x:Name="AppText" Margin="6,0,0,0" MaxWidth="200" Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" Text="{Binding AppExe}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:SettingsCard.Header>
                                                <ui:SettingsCard.Description>
                                                    <!-- Two text lines, as on every list page: the same card height on Loops, Macros and Remap -->
                                                    <StackPanel x:Name="DescriptionPanel">
                                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                                        <!-- MinHeight: the height of a line with keys, so every card is as tall with or without a hotkey -->
                                                        <StackPanel MinHeight="22" Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding ActivationLead}" />
                                                            <ItemsControl Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding HotkeyParts}"
                                                                          ItemTemplate="{StaticResource AccentKeyCapItem}" ItemsPanel="{StaticResource KeyCapRow}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ui:SettingsCard.Description>
                                                <views:ItemCardActions IsHoldMode="{Binding IsHoldMode}" IsRunning="{Binding IsRunning}"
                                                                       CanPlay="{Binding CanStartStop}" CanEdit="{Binding CanEdit}" CanMore="{Binding IsNotRunning}"
                                                                       IsOn="{Binding IsLoopEnabled}" PlayClick="OnMacroStartStopClick" EditClick="OnEditMacroClick"
                                                                       MoreClick="OnMacroMoreClick" />
                                            </ui:SettingsCard>
                                            <Border Height="3" Margin="0,3,0,0" CornerRadius="2"
                                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                    Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                                                <!-- Disabled: greyed like a disabled card, while its switch and menu stay usable (approved, ui.md) -->
                                                <Setter TargetName="TypeIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="HeaderPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="AppPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="DescriptionPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource CautionDotInfoBadgeStyle}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource SuccessDotInfoBadgeStyle}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:ScrollViewerEx>
                </Grid>

                <!-- ================= Remap page ================= -->
                <Grid x:Name="RemapsPage" Margin="40,12,40,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Static r:Strings.Remaps_Title}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Static r:Strings.Remaps_Add}" Click="OnAddRemapClick" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RemapSearchBox" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Remaps_Search}" TextChanged="OnRemapSearchChanged" />
                        <ComboBox x:Name="RemapFilterBox" Grid.Column="1" Margin="12,0,0,0" MinWidth="130" SelectionChanged="OnRemapFilterChanged">
                            <ComboBoxItem Content="{x:Static r:Strings.Remaps_FilterAll}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterEnabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterDisabled}" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="RemapCountText" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ScrollViewerEx Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="EmptyRemapsText" Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="RemapList" ItemsPanel="{StaticResource CardListPanel}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:RemapItemViewModel}">
                                        <ui:SettingsCard>
                                            <ui:SettingsCard.HeaderIcon>
                                                <ui:FontIcon x:Name="TypeIcon" Icon="{x:Static ui:SegoeFluentIcons.Switch}" />
                                            </ui:SettingsCard.HeaderIcon>
                                            <ui:SettingsCard.Header>
                                                <StackPanel x:Name="HeaderPanel" Orientation="Horizontal">
                                                    <!-- The source key → the key or combination it sends, in the accent color; "No hotkey yet"
                                                         for a remap Import left without one (data.md) -->
                                                    <ItemsControl VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding SourceParts}"
                                                                  ItemTemplate="{StaticResource AccentKeyCapItem}" ItemsPanel="{StaticResource KeyCapRow}"
                                                                  Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="{x:Static r:Strings.Remaps_NoHotkey}"
                                                               Visibility="{Binding HasNoSource, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Margin="2,0,6,0" VerticalAlignment="Center" Text="→" />
                                                    <ItemsControl VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding TargetParts}"
                                                                  ItemTemplate="{StaticResource AccentKeyCapItem}" ItemsPanel="{StaticResource KeyCapRow}" />
                                                    <ui:InfoBadge x:Name="StatusBadge" Margin="10,0,6,0" VerticalAlignment="Center" Style="{StaticResource IdleDotInfoBadgeStyle}" />
                                                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}" />
                                                </StackPanel>
                                            </ui:SettingsCard.Header>
                                            <ui:SettingsCard.Description>
                                                <!-- Two text lines, as on every list page; without a note the second one stays empty but keeps its height.
                                                     Without a hotkey the second line says what to do, in the caution color (approved design B,
                                                     the Design canvas "PuppyMacro Import, remap without key, title bar") -->
                                                <StackPanel x:Name="DescriptionPanel">
                                                    <TextBlock x:Name="ScopeText" Text="{Binding ScopeText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasNoSource, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:FontIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.Warning}"
                                                                     Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                   Text="{x:Static r:Strings.Remaps_NoHotkeyHint}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ui:SettingsCard.Description>
                                            <views:ItemCardActions ShowPlay="False" IsOn="{Binding IsLoopEnabled}" CanSwitch="{Binding HasSource}"
                                                                   EditClick="OnEditRemapClick" MoreClick="OnRemapMoreClick" />
                                        </ui:SettingsCard>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                                                <!-- Disabled: greyed like a disabled card, while its switch and menu stay usable (approved, ui.md) -->
                                                <Setter TargetName="TypeIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="HeaderPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="DescriptionPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                                <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource CautionDotInfoBadgeStyle}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:ScrollViewerEx>
                </Grid>

                <!-- ================= AI page: AI apps on this PC use PuppyMacro through its MCP server (MainWindow.Ai.cs) ================= -->
                <ui:ScrollViewerEx x:Name="AiPage" Padding="40,12,40,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ikw:SimpleStackPanel Margin="0,0,0,16" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Static r:Strings.AiPage_Title}" />
                        <TextBlock Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static r:Strings.AiPage_Description}" />

                        <!-- The AI apps feature is in beta (the user asked to say so in the app) -->
                        <ui:InfoBar x:Name="AiBetaBar" Margin="0,12,0,0" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="{x:Static r:Strings.AiPage_Beta}" AutomationProperties.Name="{x:Static r:Strings.AiPage_Beta}"
                                    Message="{x:Static r:Strings.AiPage_BetaMessage}" />
                        <ui:InfoBar x:Name="AiMessage" Margin="0,12,0,0" IsOpen="False" />
                        <!-- PuppyMacro's AI connection could not be opened (AiServer.ListenError) -->
                        <ui:InfoBar x:Name="AiConnectionError" Margin="0,12,0,0" Severity="Warning" IsClosable="False" IsOpen="False" />

                        <!-- Access -->
                        <TextBlock Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.AiPage_Access}" />
                        <!-- Allow AI access, and what the AI apps may do without asking (SwitchSettingsExpander, ui.md) -->
                        <views:SwitchSettingsExpander x:Name="AiAccessExpander" Header="{x:Static r:Strings.AiPage_AllowAccess}"
                                                      Description="{x:Static r:Strings.AiPage_AllowAccessDescription}"
                                                      CanExpand="{Binding IsOn, ElementName=AiAccessSwitch}">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Shield}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="AiAccessSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AllowAccess}" Toggled="OnAiAccessChanged" />
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_AskDelete}">
                                    <ui:ToggleSwitch x:Name="AiAskDeleteSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AskDeleteName}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_AskChange}"
                                                 Description="{x:Static r:Strings.AiPage_AskChangeDescription}">
                                    <ui:ToggleSwitch x:Name="AiAskChangeSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AskChangeName}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_AskSettings}" Description="{x:Static r:Strings.AiPage_AskSettingsDescription}">
                                    <ui:ToggleSwitch x:Name="AiAskSettingsSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AskSettings}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_StartWhenNeeded}"
                                                 Description="{x:Static r:Strings.AiPage_StartWhenNeededDescription}">
                                    <ui:ToggleSwitch x:Name="AiStartSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_StartWhenNeeded}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </views:SwitchSettingsExpander>

                        <!-- Apps: one SettingsCard each, built in MainWindow.Ai.cs (the app's own icon from its exe) -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.AiPage_Apps}" />
                        <ikw:SimpleStackPanel x:Name="AiAppsPanel" Spacing="4" />

                        <!-- Recent activity: the last requests; View all opens the AI activity window -->
                        <Grid Margin="0,29,0,5">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.AiPage_RecentActivity}" />
                            <Button x:Name="AiViewAllButton" HorizontalAlignment="Right" Content="{x:Static r:Strings.AiPage_ViewAll}" Click="OnAiViewAllClick" />
                        </Grid>
                        <Border Padding="16,8" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <TextBlock x:Name="AiNoActivityText" Margin="0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{x:Static r:Strings.AiPage_NoActivity}" TextWrapping="Wrap" />
                                <ItemsControl x:Name="AiRecentList" Focusable="False">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding RecentAccessibleName}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TimeText}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding App}" />
                                                <TextBlock Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Request}" ToolTip="{Binding Request}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ResultText}" />
                                                <!-- What the AI changed or deleted comes back as it was -->
                                                <ui:HyperlinkButton Grid.Column="4" HorizontalAlignment="Right" Content="{x:Static r:Strings.AiActivity_Restore}" Tag="{Binding}"
                                                                    Visibility="{Binding RestoreVisibility}" Click="OnAiRestoreClick"
                                                                    AutomationProperties.Name="{Binding RestoreName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <ikw:SimpleStackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                            <ui:HyperlinkButton Content="{x:Static r:Strings.AiPage_HowToUse}" NavigateUri="https://giuvincenzi.github.io/puppymacro/guide/latest/ai.html" />
                        </ikw:SimpleStackPanel>
                    </ikw:SimpleStackPanel>
                </ui:ScrollViewerEx>

                <!-- ================= Settings page: as the library's Gallery and Windows Settings ================= -->
                <ui:ScrollViewerEx x:Name="SettingsPage" Padding="40,12,40,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ikw:SimpleStackPanel Margin="0,0,0,16" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Static r:Strings.Settings_Title}" />

                        <ui:InfoBar x:Name="SettingsError" Margin="0,12,0,0" Severity="Error" IsOpen="False" />

                        <!-- General -->
                        <TextBlock Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_General}" />
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Theme}" Description="{x:Static r:Strings.Settings_ThemeDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Color}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemeComboBox" SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="{x:Static r:Strings.Theme_System}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Theme_Light}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Theme_Dark}" />
                            </ComboBox>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Language}" Description="{x:Static r:Strings.Settings_LanguageDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.LocaleLanguage}" />
                            </ui:SettingsCard.HeaderIcon>
                            <!-- Use system language, then the languages by their own name (MainWindow.FillLanguages). -->
                            <ComboBox x:Name="LanguageComboBox" SelectionChanged="OnLanguageChanged" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_CloseToTray}"
                                         Description="{x:Static r:Strings.Settings_CloseToTrayDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TVMonitor}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="CloseToTraySwitch" Toggled="OnCloseToTrayChanged" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_StartWithWindows}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.PowerButton}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:SettingsCard.Description>
                                <TextBlock x:Name="StartWithWindowsText" TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_StartWithWindowsDescription}" />
                            </ui:SettingsCard.Description>
                            <ui:ToggleSwitch x:Name="StartWithWindowsSwitch" Toggled="OnStartWithWindowsChanged" />
                        </ui:SettingsCard>

                        <!-- Hotkeys and overlay -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_HotkeysAndOverlay}" />
                        <ui:SettingsExpander x:Name="HotkeysGroup" Tag="Hotkeys" Header="{x:Static r:Strings.Settings_Hotkeys}"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.Main_StopAll}" Description="{x:Static r:Strings.Settings_StopAllDescription}">
                                    <views:KeyCaptureField x:Name="StopAllHotkeyField" IsHotkey="True" CanClear="False"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_OverlayMode}" Description="{x:Static r:Strings.Settings_OverlayModeDescription}">
                                    <views:KeyCaptureField x:Name="OverlayModeHotkeyField" IsHotkey="True" CanClear="False"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_Record}" Description="{x:Static r:Strings.Settings_RecordDescription}">
                                    <views:KeyCaptureField x:Name="RecordHotkeyField" IsHotkey="True" CanClear="False"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- The panel's switch is the group's own; it opens also while off: Position on screen places the
                             floating buttons too -->
                        <views:SwitchSettingsExpander x:Name="OverlayGroup" Tag="Overlay" Header="{x:Static r:Strings.Settings_OverlayPanel}"
                                                      Description="{x:Static r:Strings.Settings_OverlayPanelDescription}" CanExpand="True"
                                                      Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:ToggleSwitch x:Name="ShowPanelSwitch" AutomationProperties.Name="{x:Static r:Strings.Settings_ShowOverlayPanel}" Toggled="OnShowPanelChanged" />
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.MapLayers}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard x:Name="OpacityCard" Header="{x:Static r:Strings.Settings_Opacity}">
                                    <StackPanel Orientation="Horizontal">
                                        <views:ValueSlider x:Name="OpacitySlider" Minimum="20" Maximum="100" Label="{x:Static r:Strings.Settings_OverlayPanelOpacity}"
                                                           ValueChanged="OnOpacityChanged" />
                                        <Border Width="132" Height="36" Margin="14,0,0,0" CornerRadius="6" Background="#3A4A5C" ClipToBounds="True">
                                            <Border x:Name="OpacityPreviewPanel" Margin="10,6,10,0" Padding="8,5" VerticalAlignment="Top"
                                                    CornerRadius="5" BorderThickness="1" BorderBrush="#1AFFFFFF" Background="#D9202020">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#6CCB5F" VerticalAlignment="Center" />
                                                        <TextBlock Margin="5,0,0,0" FontSize="10" Foreground="White" Text="{x:Static r:Strings.Settings_OpacityPreviewItem}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_PositionOnScreen}" Description="{x:Static r:Strings.Settings_PositionOnScreenDescription}">
                                    <views:PlaceButton MovesOverlay="True" Text="{x:Static r:Strings.Settings_PositionOnScreen}" Click="OnPositionOnScreenClick" />
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="ClickInPanelCard" Header="{x:Static r:Strings.Settings_ClickInPanel}"
                                                 Description="{x:Static r:Strings.Settings_ClickInPanelDescription}">
                                    <ui:ToggleSwitch x:Name="ClickInPanelSwitch" Toggled="OnClickInPanelChanged" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </views:SwitchSettingsExpander>

                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Sound}" Description="{x:Static r:Strings.Settings_SoundDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Volume}" />
                            </ui:SettingsCard.HeaderIcon>
                            <views:ValueSlider x:Name="VolumeSlider" Label="{x:Static r:Strings.Settings_SoundVolume}"
                                               ValueChanged="OnVolumeChanged" PreviewMouseLeftButtonUp="OnVolumeReleased" />
                        </ui:SettingsCard>

                        <!-- Data and updates -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_DataAndUpdates}" />
                        <ui:SettingsExpander x:Name="BackupGroup" Tag="Backup" Header="{x:Static r:Strings.Settings_Backup}"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Download}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Description>
                                <TextBlock x:Name="DataFolderText" TextTrimming="CharacterEllipsis" />
                            </ui:SettingsExpander.Description>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_ExportOrImport}"
                                                 Description="{x:Static r:Strings.Settings_ExportOrImportDescription}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{x:Static r:Strings.Settings_ExportButton}" Click="OnExportClick" />
                                        <Button Margin="8,0,0,0" Content="{x:Static r:Strings.Settings_ImportButton}" Click="OnImportClick" />
                                    </StackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_OpenDataFolder}" IsClickEnabled="True" Click="OnOpenDataFolderClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Updates}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="UpdateCardProgress" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed" />
                                </StackPanel>
                            </ui:SettingsCard.Description>
                            <!-- The library's HyperlinkButton opens its NavigateUri in the browser -->
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <ui:HyperlinkButton x:Name="UpdateWhatsNew" Content="{x:Static r:Strings.Settings_WhatsNew}" Visibility="Collapsed" />
                                <Button x:Name="UpdateCardButton" Click="OnUpdateActionClick" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_CheckForUpdates}" Description="{x:Static r:Strings.Settings_CheckForUpdatesDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="CheckForUpdatesSwitch" Toggled="OnCheckForUpdatesChanged" />
                        </ui:SettingsCard>

                        <!-- About -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_About}" />
                        <ui:SettingsExpander x:Name="AboutGroup" Tag="About" Header="PuppyMacro"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <Image Width="20" Height="20" Source="pack://application:,,,/Assets/PuppyMacro-256.png" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Description>
                                <TextBlock x:Name="AboutText" />
                            </ui:SettingsExpander.Description>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard x:Name="UserGuideButton" Header="{x:Static r:Strings.Settings_UserGuide}" IsClickEnabled="True"
                                                 Tag="https://giuvincenzi.github.io/puppymacro/guide/latest/" Click="OnOpenLinkClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="GitHubButton" Header="GitHub" IsClickEnabled="True"
                                                 Tag="https://github.com/giuvincenzi/puppymacro" Click="OnOpenLinkClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </ikw:SimpleStackPanel>
                </ui:ScrollViewerEx>

            </Grid>
            </DockPanel>
            </Border>
        </Grid>
        <!-- ================= A file dragged over the window (MainWindow.Share.cs; approved: the Design canvas "PuppyMacro Import,
             remap without key, title bar") ================= -->
        <!-- Over the whole window, title bar too: what is under it is blurred (MainWindow.Share.cs) and covered by the base color
             at 82%; a dashed line 12 px inside the edges (a Rectangle: a Border cannot be dashed). A .puppyitems file: accent, "Drop
             to import" and its name. A backup: neutral, where to open it, never imported here. Other files: nothing, as before. -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="False" Visibility="Collapsed">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.82" />
            <Rectangle x:Name="DropOverlayLine" Margin="12" RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4 3"
                       Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
            <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- One FontIcon per icon: a FontIcon's Icon must never change (ui.md) -->
                <ui:FontIcon x:Name="DropImportIcon" HorizontalAlignment="Center" FontSize="56"
                             Icon="{x:Static fsi:FluentSystemIcons.ArrowDownload_48_Regular}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <ui:FontIcon x:Name="DropBackupIcon" HorizontalAlignment="Center" FontSize="56" Visibility="Collapsed"
                             Icon="{x:Static fsi:FluentSystemIcons.ArchiveSettings_24_Regular}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DropTitleText" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="DropDescriptionText" Margin="0,8,0,0" MaxWidth="440" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DropFileText" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
