<Window
    x:Class="PuppyMacro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:fsi="clr-namespace:iNKORE.UI.WPF.Modern.Common.IconKeys;assembly=iNKORE.UI.WPF.Modern"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    Title="PuppyMacro"
    Icon="pack://application:,,,/Assets/PuppyMacro.ico"
    Width="1300"
    Height="900"
    MinWidth="560"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.Height="48"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed"
    AllowDrop="True"
    PreviewDragEnter="OnFileDragOver"
    PreviewDragOver="OnFileDragOver"
    PreviewDragLeave="OnFileDragLeave"
    PreviewDrop="OnFileDrop">

    <Window.Resources>
        <!-- Cards of a list: 4 apart, as in Windows Settings -->
        <ItemsPanelTemplate x:Key="CardListPanel">
            <ikw:SimpleStackPanel Spacing="4" />
        </ItemsPanelTemplate>

        <!-- ================= The views of the Loops, Macros and Remap pages (approved: the Design canvas "PuppyMacro lists
             redesign", B + C): List (one clickable SettingsCard per item, grouped by app), Table (a ListView with columns, not
             grouped) and Grid (SettingsCard tiles, grouped by app). A click on an item opens its editor (OnItemClick); its
             buttons are ItemCardActions. MainWindow.Lists.cs switches them and sizes the tiles and the columns. ================= -->

        <!-- Grid: tiles side by side, every tile of a page as wide (MainWindow puts the width in the ItemsControl's Tag) -->
        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel ItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </ItemsPanelTemplate>

        <!-- List and Grid: a title per app (All apps first), as the sections of Windows Settings; only when the page has more than
             one. Only the title and the items: the library's GroupItem puts the title in a ListViewHeaderItem, which draws a
             line under it (not in the approved design; the user's choice). -->
        <GroupStyle x:Key="AppGroups" x:Shared="False">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                    <ContentPresenter />
                                    <ItemsPresenter />
                                </StackPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,12,0,8" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ItemCount}" />
                    </StackPanel>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- Every list's rows have an accessible name (ui.md) -->
        <Style x:Key="ItemRow" TargetType="ContentPresenter">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style x:Key="TableRow" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <!-- A GridView's cells follow these: stretched, every cell has the row's height and centers its content in it -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <!-- A table (approved design B): the rows touch (the library's GridView rows are 4 px apart) and are square, from one
                 side of the card to the other; the card clips them at its rounded corners -->
            <Setter Property="Margin" Value="0" />
            <Setter Property="ui:ControlHelper.CornerRadius" Value="0" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTableRowPress" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnTableRowClick" />
            <EventSetter Event="KeyDown" Handler="OnTableRowKeyDown" />
            <Style.Triggers>
                <!-- Disabled: greyed, while its switch and menu stay usable (approved, ui.md) -->
                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The icon of a loop's or macro's kind: one FontIcon per icon, never a changed Icon (ui.md) -->
        <DataTemplate x:Key="ItemTypeIcon">
            <Grid>
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}" Visibility="{Binding ShowKeyIcon, Converter={StaticResource BoolToVisibility}}" />
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Mouse}" Visibility="{Binding ShowMouseIcon, Converter={StaticResource BoolToVisibility}}" />
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Font}" Visibility="{Binding ShowTextIcon, Converter={StaticResource BoolToVisibility}}" />
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BulletedList}" Visibility="{Binding ShowListIcon, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- A loop's or macro's hotkey as key caps, or "No hotkey" -->
        <DataTemplate x:Key="ItemKeys">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" Text="{x:Static r:Strings.Card_NoHotkey}"
                           Visibility="{Binding HasNoHotkey, Converter={StaticResource BoolToVisibility}}" />
                <views:KeyCaps VerticalAlignment="Center" Keys="{Binding HotkeyParts}" Size="Small" />
            </StackPanel>
        </DataTemplate>

        <!-- A remap's keys: the key or combination pressed, then the one it sends; "No hotkey yet" for a remap Import left
             without one (data.md), the reason in its tooltip -->
        <DataTemplate x:Key="RemapSourceKeys">
            <Grid>
                <views:KeyCaps VerticalAlignment="Center" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" Keys="{Binding SourceParts}" Size="Small" />
                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{x:Static r:Strings.Remaps_NoHotkeyHint}"
                            Visibility="{Binding HasNoSource, Converter={StaticResource BoolToVisibility}}">
                    <ui:FontIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.Warning}"
                                 Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{x:Static r:Strings.Remaps_NoHotkey}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RemapTargetKeys">
            <views:KeyCaps VerticalAlignment="Center" Keys="{Binding TargetParts}" Size="Small" />
        </DataTemplate>
        <DataTemplate x:Key="RemapKeys">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource RemapSourceKeys}" />
                <TextBlock Margin="2,0,6,0" VerticalAlignment="Center" Text="→" />
                <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource RemapTargetKeys}" />
            </StackPanel>
        </DataTemplate>

        <!-- Its state: the library's dots (approved, ui.md) -->
        <DataTemplate x:Key="ItemStatusDot">
            <ui:InfoBadge x:Name="StatusBadge" VerticalAlignment="Center" Style="{StaticResource IdleDotInfoBadgeStyle}" ToolTip="{Binding Status}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                    <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource CautionDotInfoBadgeStyle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="StatusBadge" Property="Style" Value="{StaticResource SuccessDotInfoBadgeStyle}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ItemStatus">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Margin="0,0,8,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatusDot}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Status}" TextWrapping="NoWrap" />
            </StackPanel>
        </DataTemplate>

        <!-- List: a loop or a macro on one line -->
        <DataTemplate x:Key="ItemCard">
            <StackPanel>
                <Border Height="3" Margin="0,0,0,3" CornerRadius="2" Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <ui:SettingsCard x:Name="Card" AllowDrop="True" Tag="{Binding}" IsClickEnabled="{Binding CanEdit}" IsActionIconVisible="False"
                                 AutomationProperties.Name="{Binding AccessibleName}" Click="OnItemClick"
                                 PreviewMouseLeftButtonDown="OnCardMouseDown" PreviewMouseMove="OnCardMouseMove"
                                 DragOver="OnCardDragOver" DragLeave="OnCardDragLeave" Drop="OnCardDrop">
                    <ui:SettingsCard.HeaderIcon>
                        <ContentControl x:Name="TypeIcon" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ItemTypeIcon}" />
                    </ui:SettingsCard.HeaderIcon>
                    <ui:SettingsCard.Header>
                        <DockPanel x:Name="HeaderPanel">
                            <ContentPresenter Margin="0,0,10,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatusDot}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        </DockPanel>
                    </ui:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter x:Name="KeysPart" Margin="0,0,16,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemKeys}" />
                        <views:ItemCardActions IsHoldMode="{Binding IsHoldMode}" IsRunning="{Binding IsRunning}" CanPlay="{Binding CanStartStop}"
                                               CanMore="{Binding IsNotRunning}" IsOn="{Binding IsLoopEnabled}" PlayClick="OnItemPlayClick" MoreClick="OnItemMoreClick" />
                    </StackPanel>
                </ui:SettingsCard>
                <Border Height="3" Margin="0,3,0,0" CornerRadius="2" Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                    <!-- Disabled: greyed like a disabled card, while its switch and menu stay usable (approved, ui.md) -->
                    <Setter TargetName="TypeIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="HeaderPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="KeysPart" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grid: a loop or a macro as a tile (approved design C): the icon in the accent color, the name on up to two lines
             (always two lines high, so every tile is as tall) and the switch on top; the keys, the state, Play / Stop and More
             options at the bottom. A SettingsCard with only its content: the card's background, border, hover and click are the
             library's. The accent line where a dragged tile goes is on its left or right side. -->
        <DataTemplate x:Key="ItemTile">
            <Grid Margin="0,0,8,8">
                <ui:SettingsCard x:Name="Card" AllowDrop="True" Tag="{Binding}" IsClickEnabled="{Binding CanEdit}" IsActionIconVisible="False"
                                 ContentAlignment="Vertical" AutomationProperties.Name="{Binding AccessibleName}" Click="OnItemClick"
                                 PreviewMouseLeftButtonDown="OnCardMouseDown" PreviewMouseMove="OnCardMouseMove"
                                 DragOver="OnCardDragOver" DragLeave="OnCardDragLeave" Drop="OnCardDrop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The icon, 20 px, centered on the name's first line (22 px high) -->
                        <Grid Height="22" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <ContentControl x:Name="TypeIcon" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ItemTypeIcon}"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Viewbox>
                        </Grid>
                        <TextBlock x:Name="NameText" Grid.Column="1" Height="44" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}" ToolTip="{Binding Name}" />
                        <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                         AutomationProperties.Name="{x:Static r:Strings.Card_Enabled}" IsOn="{Binding IsLoopEnabled, Mode=TwoWay}" />
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0">
                            <views:ItemCardActions DockPanel.Dock="Right" ShowSwitch="False" IsHoldMode="{Binding IsHoldMode}" IsRunning="{Binding IsRunning}"
                                                   CanPlay="{Binding CanStartStop}" CanMore="{Binding IsNotRunning}" PlayClick="OnItemPlayClick" MoreClick="OnItemMoreClick" />
                            <StackPanel x:Name="KeysPart" VerticalAlignment="Center" Orientation="Horizontal">
                                <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemKeys}" />
                                <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatus}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </ui:SettingsCard>
                <Border Width="3" Margin="-6,0,0,0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="3" Margin="0,0,-6,0" HorizontalAlignment="Right" CornerRadius="2" Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                    <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="KeysPart" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- List: a remap on one line -->
        <DataTemplate x:Key="RemapCard">
            <ui:SettingsCard Tag="{Binding}" IsClickEnabled="True" IsActionIconVisible="False" AutomationProperties.Name="{Binding AccessibleName}" Click="OnItemClick">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon x:Name="TypeIcon" Icon="{x:Static ui:SegoeFluentIcons.Switch}" />
                </ui:SettingsCard.HeaderIcon>
                <ui:SettingsCard.Header>
                    <DockPanel x:Name="HeaderPanel">
                        <ContentPresenter Margin="0,0,10,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatusDot}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    </DockPanel>
                </ui:SettingsCard.Header>
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter x:Name="KeysPart" Margin="0,0,16,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource RemapKeys}" />
                    <views:ItemCardActions ShowPlay="False" IsOn="{Binding IsLoopEnabled}" CanSwitch="{Binding HasSource}" MoreClick="OnItemMoreClick" />
                </StackPanel>
            </ui:SettingsCard>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                    <Setter TargetName="TypeIcon" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="HeaderPanel" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="KeysPart" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grid: a remap as a tile, as a loop's: its note (or its keys) and the switch on top; its keys from → to, its state
             and More options at the bottom -->
        <DataTemplate x:Key="RemapTile">
            <ui:SettingsCard Margin="0,0,8,8" Tag="{Binding}" IsClickEnabled="True" IsActionIconVisible="False" ContentAlignment="Vertical"
                             AutomationProperties.Name="{Binding AccessibleName}" Click="OnItemClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="22" Margin="0,0,14,0" VerticalAlignment="Top">
                        <ui:FontIcon x:Name="TypeIcon" VerticalAlignment="Center" FontSize="20" Icon="{x:Static ui:SegoeFluentIcons.Switch}"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <TextBlock x:Name="NameText" Grid.Column="1" Height="44" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" LineHeight="22"
                               LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Text="{Binding Title}" ToolTip="{Binding Title}" />
                    <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                     IsEnabled="{Binding HasSource}" AutomationProperties.Name="{x:Static r:Strings.Card_Enabled}"
                                     IsOn="{Binding IsLoopEnabled, Mode=TwoWay}" />
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0">
                        <views:ItemCardActions DockPanel.Dock="Right" ShowPlay="False" ShowSwitch="False" MoreClick="OnItemMoreClick" />
                        <StackPanel x:Name="KeysPart" VerticalAlignment="Center" Orientation="Horizontal">
                            <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource RemapKeys}" />
                            <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatus}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </ui:SettingsCard>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLoopEnabled}" Value="False">
                    <Setter TargetName="TypeIcon" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="KeysPart" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TableHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Table: the columns of loops and macros (each ListView its own copy): Name, Hotkey second (the user's choice), What
             it does, Works in, State, the buttons. MainWindow.Lists.cs sizes them. -->
        <GridView x:Key="ItemColumns" x:Shared="False" AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource TableHeader}">
            <GridViewColumn Width="44">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentControl VerticalAlignment="Center" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource ItemTypeIcon}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_Name}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_Hotkey}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <views:KeyCaps VerticalAlignment="Center" Keys="{Binding HotkeyParts}" Size="Small" />
                            <TextBlock Margin="2,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" Text="{x:Static r:Strings.Card_Hold}"
                                       Visibility="{Binding IsHoldWithHotkey, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" Text="{x:Static r:Strings.Card_NoHotkey}"
                                       Visibility="{Binding HasNoHotkey, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_WhatItDoes}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Summary}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_WorksIn}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center" MaxHeight="32" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding GroupName}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding GroupName}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_State}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatus}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <views:ItemCardActions VerticalAlignment="Center" IsHoldMode="{Binding IsHoldMode}" IsRunning="{Binding IsRunning}" CanPlay="{Binding CanStartStop}"
                                               CanMore="{Binding IsNotRunning}" IsOn="{Binding IsLoopEnabled}" PlayClick="OnItemPlayClick" MoreClick="OnItemMoreClick" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>

        <!-- Table: the columns of remaps -->
        <GridView x:Key="RemapColumns" x:Shared="False" AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource TableHeader}">
            <GridViewColumn Width="44">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ui:FontIcon VerticalAlignment="Center" Icon="{x:Static ui:SegoeFluentIcons.Switch}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_Note}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_From}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource RemapSourceKeys}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_To}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource RemapTargetKeys}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_WorksIn}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center" MaxHeight="32" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding GroupName}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding GroupName}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static r:Strings.Table_State}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ItemStatus}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <views:ItemCardActions VerticalAlignment="Center" ShowPlay="False" IsOn="{Binding IsLoopEnabled}" CanSwitch="{Binding HasSource}" MoreClick="OnItemMoreClick" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Title bar (approved, ui.md): 48 px as in Microsoft Store; icon, name and More options (Import,
             Export) on the left, Enter overlay mode and Stop all on the right before the window buttons drawn by the library (as
             its ButtonsOnTitlebar sample) ================= -->
        <!-- Left to right in every language: the window buttons the library draws stay on the right (i18n.md) -->
        <Grid Grid.Row="0" Height="{Binding (ui:TitleBar.Height), RelativeSource={RelativeSource AncestorType=Window}}"
              FlowDirection="LeftToRight">
            <!-- The buttons' column is as wide as they are: two * columns would give it half the window, too little for
                 Enter overlay mode and Stop all at the default 800 px in some languages -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                <!-- 24 px: 12 px above and below it in the 48 px bar -->
                <Image Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/PuppyMacro-256.png" />
                <!-- The name, and DEV in the secondary text color in a development build -->
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}">
                    <Run Text="PuppyMacro" />
                    <Run x:Name="DevBuildRun" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <!-- More options: Import and Export of loops, macros and remaps as .puppyitems files (MainWindow.Share.cs; not
                     the backup), in a menu (approved design B, the Design canvas "PuppyMacro Import, remap without key, title bar"),
                     16 px after the name (approved: the Design canvas "PuppyMacro title bar, Import, backup window", 1B). Its icon is
                     shorter than a line of text: it takes Enter overlay mode's height, so the two buttons line up -->
                <Button x:Name="TitleMoreButton" Margin="16,9,0,0" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"
                        Height="{Binding ActualHeight, ElementName=OverlayModeButton}"
                        AutomationProperties.Name="{x:Static r:Strings.Card_MoreOptions}" ToolTip="{x:Static r:Strings.Card_MoreOptions}"
                        Click="OnTitleMoreClick">
                    <Button.Resources>
                        <ResourceDictionary Source="Views/SubtleButtons.xaml" />
                    </Button.Resources>
                    <ui:FontIcon FontSize="20" Icon="{x:Static ui:SegoeFluentIcons.More}" />
                </Button>
            </StackPanel>


            <!-- On the right: Enter overlay mode, Stop all, the window buttons. The buttons sit 9 px from the top: the window's
                 1 px border, then 8, so they look 8 px from the top and from the bottom (their bottom line is almost the bar's
                 color), as Microsoft Store's search box -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OverlayModeButton" Margin="0,9,8,0" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{x:Static r:Strings.Main_EnterOverlayMode}" Click="OnOverlayModeClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Margin="0,0,8,0" FontSize="16" Icon="{x:Static ui:SegoeFluentIcons.MapLayers}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Main_EnterOverlayMode}" />
                    </StackPanel>
                </Button>
                <!-- Shown only while something runs. Approved (ui.md): the accent button with its accent colors replaced by
                     the theme's critical one (WinUI lightweight styling), at 90% and 80% on mouse over and press as the
                     accent ones are. -->
                <Button x:Name="StopAllButton" Margin="0,9,8,0" VerticalAlignment="Top" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Static r:Strings.Main_StopAll}" Click="OnStopAllClick">
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource SystemFillColorCritical}" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource SystemFillColorCritical}" Opacity="0.9" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource SystemFillColorCritical}" Opacity="0.8" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Margin="0,0,8,0" FontSize="16" Icon="{x:Static fsi:FluentSystemIcons.Stop_16_Filled}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Main_StopAll}" />
                    </StackPanel>
                </Button>
                <!-- The window buttons' place, 8 more px before them: 16 from our last button -->
                <Rectangle Margin="8,0,0,0"
                           Width="{Binding (ui:TitleBar.SystemOverlayRightInset), RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- ================= Development build (make dev) ================= -->
            <Border x:Name="DevBuildStrip" Padding="0,3" Background="#E8822E" Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A"
                           Text="{x:Static r:Strings.Main_DevelopmentBuild}" />
            </Border>

            <!-- ================= Update available ================= -->
            <!-- Collapsed while closed: a closed InfoBar hides only its content and would keep its margin -->
            <ui:InfoBar x:Name="UpdateBar" Severity="Informational" IsOpen="False" Visibility="Collapsed"
                        CloseButtonClick="OnUpdateLaterClick">
                <ui:InfoBar.ActionButton>
                    <!-- The InfoBar gives its action the rest of the row: on the right, next to the close button -->
                    <Button x:Name="UpdateBarButton" HorizontalAlignment="Right" Click="OnUpdateActionClick" />
                </ui:InfoBar.ActionButton>
                <ui:InfoBar.Content>
                    <!-- 46 on the right: as far from the right edge as it starts from the left (the library's InfoBarContentRootPadding
                         16 + InfoBarIconFontSize 16 + InfoBarIconMargin 14); while downloading no close button ends the row -->
                    <ProgressBar x:Name="UpdateBarProgress" Margin="0,0,46,12" Maximum="100" Visibility="Collapsed" />
                </ui:InfoBar.Content>
            </ui:InfoBar>
        </StackPanel>

        <!-- ================= Side rail (Loops, Macros, Remap, Settings) and the pages ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SideRail x:Name="Rail" />

            <!-- The pages on the content layer, as the NavigationView draws it (Microsoft Store, Windows Settings):
                 slightly lighter, a thin line on the top and left, the top-left corner rounded -->
            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <!-- ================= Status bar (approved design): the AI apps connected right now, each with a green dot whose halo
                     pulses slowly (still when Windows' animations are off). Shown only while one is connected, on the right, inside the content layer (the side rail runs the whole height); a click opens the AI page. ================= -->
                <Border x:Name="AiStatusBar" DockPanel.Dock="Bottom" Height="28" Padding="16,0" BorderThickness="0,1,0,0" Visibility="Collapsed"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="Transparent"
                        MouseLeftButtonUp="OnAiStatusBarClick" ToolTip="{x:Static r:Strings.AiStatus_ToolTip}"
                        AutomationProperties.Name="{x:Static r:Strings.AiStatus_Name}">
                    <ItemsControl x:Name="AiStatusList" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="18" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse x:Name="Halo" Fill="{DynamicResource SystemFillColorSuccessBrush}" RenderTransformOrigin="0.5,0.5"
                                                 Opacity="0" Visibility="{Binding HaloVisibility}">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.8" Duration="0:0:2.4">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.8" Duration="0:0:2.4">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0" Duration="0:0:2.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </Grid>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            <Grid>

                <!-- ================= Loops page ================= -->
                <Grid x:Name="LoopsPage" Margin="40,12,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Static r:Strings.Loops_Title}" />
                        <Button x:Name="AddLoopButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}" Content="{x:Static r:Strings.Loops_Add}"
                                ToolTipService.ShowOnDisabled="True" Click="OnAddLoopClick" />
                    </Grid>

                    <!-- The filter, the search and the view (List, Table, Grid): the search box takes what is left (the filter on the left: the user's choice) -->
                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="12,0,0,0" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Loops_Search}" TextChanged="OnSearchChanged" />
                        <ComboBox x:Name="FilterBox" MinWidth="130" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="{x:Static r:Strings.Loops_FilterAll}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterEnabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterDisabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterRunning}" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" AutomationProperties.Name="{x:Static r:Strings.Main_View}">
                            <ToggleButton x:Name="LoopsListButton" ToolTip="{x:Static r:Strings.Main_ViewList}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewList}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.TextBulletListLtr_16_Regular}" />
                            </ToggleButton>
                            <ToggleButton x:Name="LoopsTableButton" Margin="4,0,0,0" ToolTip="{x:Static r:Strings.Main_ViewTable}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewTable}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.TableFreezeRow_16_Regular}" />
                            </ToggleButton>
                            <ToggleButton x:Name="LoopsGridButton" Margin="4,0,0,0" ToolTip="{x:Static r:Strings.Main_ViewGrid}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewGrid}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.Grid_16_Regular}" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="CountText" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <DockPanel Grid.Row="3">
                        <TextBlock x:Name="EmptyLoopsText" DockPanel.Dock="Top" Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <ui:ScrollViewerEx x:Name="LoopsScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,0,16">
                                    <ItemsControl x:Name="LoopList" ItemsPanel="{StaticResource CardListPanel}" ItemTemplate="{StaticResource ItemCard}"
                                                  ItemContainerStyle="{StaticResource ItemRow}">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="AppGroups" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                    <!-- -8 on the right: the tiles' own 8 px gap after the last column -->
                                    <ItemsControl x:Name="LoopTiles" Margin="0,0,-8,0" ItemsPanel="{StaticResource TilePanel}" ItemTemplate="{StaticResource ItemTile}"
                                                  ItemContainerStyle="{StaticResource ItemRow}" SizeChanged="OnTilesSizeChanged">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="AppGroups" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:ScrollViewerEx>
                            <Border x:Name="LoopTableCard" Margin="0,0,0,16" VerticalAlignment="Top" CornerRadius="{DynamicResource OverlayCornerRadius}"
                                    SizeChanged="OnTableCardSizeChanged"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <ListView x:Name="LoopTable" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionChanged="OnTableSelectionChanged" View="{StaticResource ItemColumns}"
                                          ItemContainerStyle="{StaticResource TableRow}" SizeChanged="OnTableSizeChanged" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ================= Macros page ================= -->
                <Grid x:Name="MacrosPage" Margin="40,12,40,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Static r:Strings.Macros_Title}" />
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="NewMacroButton" Style="{StaticResource AccentButtonStyle}" Content="{x:Static r:Strings.Macros_Add}" ToolTipService.ShowOnDisabled="True" Click="OnNewMacroClick" />
                            <!-- A standard button with the red Record icon before its text, as the macro editor's Record actions
                                 (approved: the user found the InfoBadge dot too small) -->
                            <Button x:Name="RecordMacroButton" Margin="8,0,0,0"
                                    AutomationProperties.Name="{x:Static r:Strings.Macros_Record}" ToolTipService.ShowOnDisabled="True" Click="OnRecordMacroClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.Record}"
                                                 Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Static r:Strings.Macros_Record}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MacroSearchBox" Grid.Column="1" Margin="12,0,0,0" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Macros_Search}" TextChanged="OnMacroSearchChanged" />
                        <ComboBox x:Name="MacroFilterBox" MinWidth="130" SelectionChanged="OnMacroFilterChanged">
                            <ComboBoxItem Content="{x:Static r:Strings.Macros_FilterAll}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterEnabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterDisabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterRunning}" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" AutomationProperties.Name="{x:Static r:Strings.Main_View}">
                            <ToggleButton x:Name="MacrosListButton" ToolTip="{x:Static r:Strings.Main_ViewList}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewList}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.TextBulletListLtr_16_Regular}" />
                            </ToggleButton>
                            <ToggleButton x:Name="MacrosTableButton" Margin="4,0,0,0" ToolTip="{x:Static r:Strings.Main_ViewTable}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewTable}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.TableFreezeRow_16_Regular}" />
                            </ToggleButton>
                            <ToggleButton x:Name="MacrosGridButton" Margin="4,0,0,0" ToolTip="{x:Static r:Strings.Main_ViewGrid}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewGrid}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.Grid_16_Regular}" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="MacroCountText" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <DockPanel Grid.Row="3">
                        <TextBlock x:Name="EmptyMacrosText" DockPanel.Dock="Top" Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <ui:ScrollViewerEx x:Name="MacrosScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,0,16">
                                    <ItemsControl x:Name="MacroList" ItemsPanel="{StaticResource CardListPanel}" ItemTemplate="{StaticResource ItemCard}"
                                                  ItemContainerStyle="{StaticResource ItemRow}">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="AppGroups" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                    <ItemsControl x:Name="MacroTiles" Margin="0,0,-8,0" ItemsPanel="{StaticResource TilePanel}" ItemTemplate="{StaticResource ItemTile}"
                                                  ItemContainerStyle="{StaticResource ItemRow}" SizeChanged="OnTilesSizeChanged">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="AppGroups" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:ScrollViewerEx>
                            <Border x:Name="MacroTableCard" Margin="0,0,0,16" VerticalAlignment="Top" CornerRadius="{DynamicResource OverlayCornerRadius}"
                                    SizeChanged="OnTableCardSizeChanged"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <ListView x:Name="MacroTable" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionChanged="OnTableSelectionChanged" View="{StaticResource ItemColumns}"
                                          ItemContainerStyle="{StaticResource TableRow}" SizeChanged="OnTableSizeChanged" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ================= Remap page ================= -->
                <Grid x:Name="RemapsPage" Margin="40,12,40,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" Text="{x:Static r:Strings.Remaps_Title}" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Static r:Strings.Remaps_Add}" Click="OnAddRemapClick" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RemapSearchBox" Grid.Column="1" Margin="12,0,0,0" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Remaps_Search}" TextChanged="OnRemapSearchChanged" />
                        <ComboBox x:Name="RemapFilterBox" MinWidth="130" SelectionChanged="OnRemapFilterChanged">
                            <ComboBoxItem Content="{x:Static r:Strings.Remaps_FilterAll}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterEnabled}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Main_FilterDisabled}" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" AutomationProperties.Name="{x:Static r:Strings.Main_View}">
                            <ToggleButton x:Name="RemapsListButton" ToolTip="{x:Static r:Strings.Main_ViewList}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewList}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.TextBulletListLtr_16_Regular}" />
                            </ToggleButton>
                            <ToggleButton x:Name="RemapsTableButton" Margin="4,0,0,0" ToolTip="{x:Static r:Strings.Main_ViewTable}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewTable}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.TableFreezeRow_16_Regular}" />
                            </ToggleButton>
                            <ToggleButton x:Name="RemapsGridButton" Margin="4,0,0,0" ToolTip="{x:Static r:Strings.Main_ViewGrid}" AutomationProperties.Name="{x:Static r:Strings.Main_ViewGrid}" Checked="OnLayoutChecked" Unchecked="OnLayoutUnchecked">
                                <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.Grid_16_Regular}" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="RemapCountText" Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <DockPanel Grid.Row="3">
                        <TextBlock x:Name="EmptyRemapsText" DockPanel.Dock="Top" Margin="0,8,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <ui:ScrollViewerEx x:Name="RemapsScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,0,16">
                                    <ItemsControl x:Name="RemapList" ItemsPanel="{StaticResource CardListPanel}" ItemTemplate="{StaticResource RemapCard}"
                                                  ItemContainerStyle="{StaticResource ItemRow}">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="AppGroups" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                    <ItemsControl x:Name="RemapTiles" Margin="0,0,-8,0" ItemsPanel="{StaticResource TilePanel}" ItemTemplate="{StaticResource RemapTile}"
                                                  ItemContainerStyle="{StaticResource ItemRow}" SizeChanged="OnTilesSizeChanged">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="AppGroups" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:ScrollViewerEx>
                            <Border x:Name="RemapTableCard" Margin="0,0,0,16" VerticalAlignment="Top" CornerRadius="{DynamicResource OverlayCornerRadius}"
                                    SizeChanged="OnTableCardSizeChanged"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <ListView x:Name="RemapTable" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" SelectionChanged="OnTableSelectionChanged" View="{StaticResource RemapColumns}"
                                          ItemContainerStyle="{StaticResource TableRow}" SizeChanged="OnTableSizeChanged" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ================= AI page: AI apps on this PC use PuppyMacro through its MCP server (MainWindow.Ai.cs) ================= -->
                <ui:ScrollViewerEx x:Name="AiPage" Padding="40,12,40,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ikw:SimpleStackPanel Margin="0,0,0,16" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Static r:Strings.AiPage_Title}" />
                        <TextBlock Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static r:Strings.AiPage_Description}" />

                        <!-- The AI apps feature is in beta (the user asked to say so in the app) -->
                        <ui:InfoBar x:Name="AiBetaBar" Margin="0,12,0,0" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="{x:Static r:Strings.AiPage_Beta}" AutomationProperties.Name="{x:Static r:Strings.AiPage_Beta}"
                                    Message="{x:Static r:Strings.AiPage_BetaMessage}" />
                        <ui:InfoBar x:Name="AiMessage" Margin="0,12,0,0" IsOpen="False" />
                        <!-- PuppyMacro's AI connection could not be opened (AiServer.ListenError) -->
                        <ui:InfoBar x:Name="AiConnectionError" Margin="0,12,0,0" Severity="Warning" IsClosable="False" IsOpen="False" />

                        <!-- Access -->
                        <TextBlock Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.AiPage_Access}" />
                        <!-- Allow AI access, and what the AI apps may do without asking (SwitchSettingsExpander, ui.md) -->
                        <views:SwitchSettingsExpander x:Name="AiAccessExpander" Header="{x:Static r:Strings.AiPage_AllowAccess}"
                                                      Description="{x:Static r:Strings.AiPage_AllowAccessDescription}"
                                                      CanExpand="{Binding IsOn, ElementName=AiAccessSwitch}">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Shield}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="AiAccessSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AllowAccess}" Toggled="OnAiAccessChanged" />
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_AskDelete}">
                                    <ui:ToggleSwitch x:Name="AiAskDeleteSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AskDeleteName}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_AskChange}"
                                                 Description="{x:Static r:Strings.AiPage_AskChangeDescription}">
                                    <ui:ToggleSwitch x:Name="AiAskChangeSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AskChangeName}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_AskSettings}" Description="{x:Static r:Strings.AiPage_AskSettingsDescription}">
                                    <ui:ToggleSwitch x:Name="AiAskSettingsSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_AskSettings}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_SeeScreen}" Description="{x:Static r:Strings.AiPage_SeeScreenDescription}">
                                    <ui:ToggleSwitch x:Name="AiSeeScreenSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_SeeScreen}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_TestMacros}" Description="{x:Static r:Strings.AiPage_TestMacrosDescription}">
                                    <ui:ToggleSwitch x:Name="AiTestMacrosSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_TestMacros}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.AiPage_StartWhenNeeded}"
                                                 Description="{x:Static r:Strings.AiPage_StartWhenNeededDescription}">
                                    <ui:ToggleSwitch x:Name="AiStartSwitch" AutomationProperties.Name="{x:Static r:Strings.AiPage_StartWhenNeeded}" Toggled="OnAiPermissionChanged" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </views:SwitchSettingsExpander>

                        <!-- Apps: one SettingsCard each, built in MainWindow.Ai.cs (the app's own icon from its exe) -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.AiPage_Apps}" />
                        <ikw:SimpleStackPanel x:Name="AiAppsPanel" Spacing="4" />

                        <!-- Recent activity: the last requests; View all opens the AI activity window -->
                        <Grid Margin="0,29,0,5">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.AiPage_RecentActivity}" />
                            <Button x:Name="AiViewAllButton" HorizontalAlignment="Right" Content="{x:Static r:Strings.AiPage_ViewAll}" Click="OnAiViewAllClick" />
                        </Grid>
                        <Border Padding="16,8" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <TextBlock x:Name="AiNoActivityText" Margin="0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{x:Static r:Strings.AiPage_NoActivity}" TextWrapping="Wrap" />
                                <ItemsControl x:Name="AiRecentList" Focusable="False">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding RecentAccessibleName}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TimeText}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding App}" />
                                                <TextBlock Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Request}" ToolTip="{Binding Request}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ResultText}" />
                                                <!-- What the AI changed or deleted comes back as it was -->
                                                <ui:HyperlinkButton Grid.Column="4" HorizontalAlignment="Right" Content="{x:Static r:Strings.AiActivity_Restore}" Tag="{Binding}"
                                                                    Visibility="{Binding RestoreVisibility}" Click="OnAiRestoreClick"
                                                                    AutomationProperties.Name="{Binding RestoreName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <ikw:SimpleStackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                            <ui:HyperlinkButton Content="{x:Static r:Strings.AiPage_HowToUse}" NavigateUri="https://giuvincenzi.github.io/puppymacro/guide/latest/ai.html" />
                        </ikw:SimpleStackPanel>
                    </ikw:SimpleStackPanel>
                </ui:ScrollViewerEx>

                <!-- ================= Settings page: as the library's Gallery and Windows Settings ================= -->
                <ui:ScrollViewerEx x:Name="SettingsPage" Padding="40,12,40,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ikw:SimpleStackPanel Margin="0,0,0,16" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Static r:Strings.Settings_Title}" />

                        <ui:InfoBar x:Name="SettingsError" Margin="0,12,0,0" Severity="Error" IsOpen="False" />

                        <!-- General -->
                        <TextBlock Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_General}" />
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Theme}" Description="{x:Static r:Strings.Settings_ThemeDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Color}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemeComboBox" SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="{x:Static r:Strings.Theme_System}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Theme_Light}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Theme_Dark}" />
                            </ComboBox>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Language}" Description="{x:Static r:Strings.Settings_LanguageDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.LocaleLanguage}" />
                            </ui:SettingsCard.HeaderIcon>
                            <!-- Use system language, then the languages by their own name (MainWindow.FillLanguages). -->
                            <ComboBox x:Name="LanguageComboBox" SelectionChanged="OnLanguageChanged" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_CloseToTray}"
                                         Description="{x:Static r:Strings.Settings_CloseToTrayDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TVMonitor}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="CloseToTraySwitch" Toggled="OnCloseToTrayChanged" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_StartWithWindows}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.PowerButton}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:SettingsCard.Description>
                                <TextBlock x:Name="StartWithWindowsText" TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_StartWithWindowsDescription}" />
                            </ui:SettingsCard.Description>
                            <ui:ToggleSwitch x:Name="StartWithWindowsSwitch" Toggled="OnStartWithWindowsChanged" />
                        </ui:SettingsCard>

                        <!-- Hotkeys and overlay -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_HotkeysAndOverlay}" />
                        <ui:SettingsExpander x:Name="HotkeysGroup" Tag="Hotkeys" Header="{x:Static r:Strings.Settings_Hotkeys}"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_OpenMain}" Description="{x:Static r:Strings.Settings_OpenMainDescription}">
                                    <views:KeyCaptureField x:Name="OpenMainHotkeyField" IsHotkey="True" CanClear="True"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_OverlayMode}" Description="{x:Static r:Strings.Settings_OverlayModeDescription}">
                                    <views:KeyCaptureField x:Name="OverlayModeHotkeyField" IsHotkey="True" CanClear="False"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Main_StopAll}" Description="{x:Static r:Strings.Settings_StopAllDescription}">
                                    <views:KeyCaptureField x:Name="StopAllHotkeyField" IsHotkey="True" CanClear="False"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_Record}" Description="{x:Static r:Strings.Settings_RecordDescription}">
                                    <views:KeyCaptureField x:Name="RecordHotkeyField" IsHotkey="True" CanClear="False"
                                                           ItemName="hotkey" ValueChanged="OnGlobalHotkeyChanged"
                                                           Started="OnGlobalHotkeyStarted" Rejected="ShowSettingsError" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- The panel's switch is the group's own; it opens also while off: Position on screen places the
                             floating buttons too -->
                        <views:SwitchSettingsExpander x:Name="OverlayGroup" Tag="Overlay" Header="{x:Static r:Strings.Settings_OverlayPanel}"
                                                      Description="{x:Static r:Strings.Settings_OverlayPanelDescription}" CanExpand="True"
                                                      Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:ToggleSwitch x:Name="ShowPanelSwitch" AutomationProperties.Name="{x:Static r:Strings.Settings_ShowOverlayPanel}" Toggled="OnShowPanelChanged" />
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.MapLayers}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard x:Name="OpacityCard" Header="{x:Static r:Strings.Settings_Opacity}">
                                    <StackPanel Orientation="Horizontal">
                                        <views:ValueSlider x:Name="OpacitySlider" Minimum="20" Maximum="100" Label="{x:Static r:Strings.Settings_OverlayPanelOpacity}"
                                                           ValueChanged="OnOpacityChanged" />
                                        <Border Width="132" Height="36" Margin="14,0,0,0" CornerRadius="6" Background="#3A4A5C" ClipToBounds="True">
                                            <Border x:Name="OpacityPreviewPanel" Margin="10,6,10,0" Padding="8,5" VerticalAlignment="Top"
                                                    CornerRadius="5" BorderThickness="1" BorderBrush="#1AFFFFFF" Background="#D9202020">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="#6CCB5F" VerticalAlignment="Center" />
                                                        <TextBlock Margin="5,0,0,0" FontSize="10" Foreground="White" Text="{x:Static r:Strings.Settings_OpacityPreviewItem}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_PositionOnScreen}" Description="{x:Static r:Strings.Settings_PositionOnScreenDescription}">
                                    <views:PlaceButton MovesOverlay="True" Text="{x:Static r:Strings.Settings_PositionOnScreen}" Click="OnPositionOnScreenClick" />
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="ClickInPanelCard" Header="{x:Static r:Strings.Settings_ClickInPanel}"
                                                 Description="{x:Static r:Strings.Settings_ClickInPanelDescription}">
                                    <ui:ToggleSwitch x:Name="ClickInPanelSwitch" Toggled="OnClickInPanelChanged" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </views:SwitchSettingsExpander>

                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Sound}" Description="{x:Static r:Strings.Settings_SoundDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Volume}" />
                            </ui:SettingsCard.HeaderIcon>
                            <views:ValueSlider x:Name="VolumeSlider" Label="{x:Static r:Strings.Settings_SoundVolume}"
                                               ValueChanged="OnVolumeChanged" PreviewMouseLeftButtonUp="OnVolumeReleased" />
                        </ui:SettingsCard>

                        <!-- Screen recognition: how the macros' conditions look at the screen -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_ScreenRecognition}" />
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_RecognitionDevice}" Description="{x:Static r:Strings.Settings_RecognitionDeviceDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Photo2}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="RecognitionDeviceComboBox" SelectionChanged="OnRecognitionDeviceChanged"
                                      AutomationProperties.Name="{x:Static r:Strings.Settings_RecognitionDevice}">
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_RecognitionAutomatic}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_RecognitionGpu}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_RecognitionCpu}" />
                            </ComboBox>
                        </ui:SettingsCard>

                        <!-- Data and updates -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_DataAndUpdates}" />
                        <ui:SettingsExpander x:Name="BackupGroup" Tag="Backup" Header="{x:Static r:Strings.Settings_Backup}"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Download}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Description>
                                <TextBlock x:Name="DataFolderText" TextTrimming="CharacterEllipsis" />
                            </ui:SettingsExpander.Description>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_ExportOrImport}"
                                                 Description="{x:Static r:Strings.Settings_ExportOrImportDescription}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{x:Static r:Strings.Settings_ExportButton}" Click="OnExportClick" />
                                        <Button Margin="8,0,0,0" Content="{x:Static r:Strings.Settings_ImportButton}" Click="OnImportClick" />
                                    </StackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_OpenDataFolder}" IsClickEnabled="True" Click="OnOpenDataFolderClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- The debug data (DebugStore): what it is and the space it takes, its folder, Delete all -->
                        <ui:SettingsExpander x:Name="DebugDataGroup" Tag="DebugData" Header="{x:Static r:Strings.Settings_DebugData}"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Bug}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Description>
                                <TextBlock x:Name="DebugDataText" TextWrapping="Wrap" />
                            </ui:SettingsExpander.Description>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static r:Strings.DebugLog_OpenFolder}" IsClickEnabled="True" Click="OnOpenDebugFolderClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static r:Strings.Settings_DeleteDebugData}"
                                                 Description="{x:Static r:Strings.Settings_DeleteDebugDataDescription}">
                                    <Button Content="{x:Static r:Strings.Settings_DeleteAll}" Click="OnDeleteDebugDataClick" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_Updates}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="UpdateCardProgress" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed" />
                                </StackPanel>
                            </ui:SettingsCard.Description>
                            <!-- The library's HyperlinkButton opens its NavigateUri in the browser -->
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <ui:HyperlinkButton x:Name="UpdateWhatsNew" Content="{x:Static r:Strings.Settings_WhatsNew}" Visibility="Collapsed" />
                                <Button x:Name="UpdateCardButton" Click="OnUpdateActionClick" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static r:Strings.Settings_CheckForUpdates}" Description="{x:Static r:Strings.Settings_CheckForUpdatesDescription}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="CheckForUpdatesSwitch" Toggled="OnCheckForUpdatesChanged" />
                        </ui:SettingsCard>

                        <!-- About -->
                        <TextBlock Margin="0,33,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Settings_About}" />
                        <ui:SettingsExpander x:Name="AboutGroup" Tag="About" Header="PuppyMacro"
                                             Expanded="OnGroupToggled" Collapsed="OnGroupToggled">
                            <ui:SettingsExpander.HeaderIcon>
                                <Image Width="20" Height="20" Source="pack://application:,,,/Assets/PuppyMacro-256.png" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Description>
                                <TextBlock x:Name="AboutText" />
                            </ui:SettingsExpander.Description>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard x:Name="UserGuideButton" Header="{x:Static r:Strings.Settings_UserGuide}" IsClickEnabled="True"
                                                 Tag="https://giuvincenzi.github.io/puppymacro/guide/latest/" Click="OnOpenLinkClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="GitHubButton" Header="GitHub" IsClickEnabled="True"
                                                 Tag="https://github.com/giuvincenzi/puppymacro" Click="OnOpenLinkClick">
                                    <ui:SettingsCard.ActionIcon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenInNewWindow}" />
                                    </ui:SettingsCard.ActionIcon>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>
                    </ikw:SimpleStackPanel>
                </ui:ScrollViewerEx>

            </Grid>
            </DockPanel>
            </Border>
        </Grid>
        <!-- ================= A file dragged over the window (MainWindow.Share.cs; approved: the Design canvas "PuppyMacro Import,
             remap without key, title bar") ================= -->
        <!-- Over the whole window, title bar too: what is under it is blurred (MainWindow.Share.cs) and covered by the base color
             at 82%; a dashed line 12 px inside the edges (a Rectangle: a Border cannot be dashed). A .puppyitems file: accent, "Drop
             to import" and its name. A backup: neutral, where to open it, never imported here. Other files: nothing, as before. -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="False" Visibility="Collapsed">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.82" />
            <Rectangle x:Name="DropOverlayLine" Margin="12" RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4 3"
                       Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
            <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- One FontIcon per icon: a FontIcon's Icon must never change (ui.md) -->
                <ui:FontIcon x:Name="DropImportIcon" HorizontalAlignment="Center" FontSize="56"
                             Icon="{x:Static fsi:FluentSystemIcons.ArrowDownload_48_Regular}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <ui:FontIcon x:Name="DropBackupIcon" HorizontalAlignment="Center" FontSize="56" Visibility="Collapsed"
                             Icon="{x:Static fsi:FluentSystemIcons.ArchiveSettings_24_Regular}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DropTitleText" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="DropDescriptionText" Margin="0,8,0,0" MaxWidth="440" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DropFileText" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
