<Window
    x:Class="PuppyMacro.LoopEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:PuppyMacro"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.MinimizeButtonAvailability="Collapsed"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed"
    Title="Add loop"
    Width="1120"
    Height="780"
    MinWidth="900"
    MinHeight="520"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <!-- The spin buttons step 10 ms, or 1 s / min / h -->
        <local:IntervalStepConverter x:Key="IntervalStep" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Form view: the loop's fields. Code view: the loop's JSON, as in settings.json. -->
        <views:ViewSwitchBar x:Name="ViewBar" Grid.Row="0" Margin="24,4,24,4" />

        <views:CodeView x:Name="CodeView" Grid.Row="1" Margin="24,4,24,12" Visibility="Collapsed" />

        <!-- Form view: what the loop does on the left, how it starts on the right -->
        <Grid x:Name="FormBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ikw:SimpleStackPanel Margin="24,8,24,12" Spacing="4">
                    <TextBox x:Name="NameBox" ui:ControlHelper.Header="Name" ui:ControlHelper.PlaceholderText="e.g. Left click spam"
                             TextChanged="OnNameChanged" />

                    <TextBlock Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Keys and texts" />
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Each one repeats on its own timer; a key can also stay held down while the loop runs. Texts are pasted all at once." />

                    <ItemsControl x:Name="ActionsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ikw:SimpleStackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:ActionEditorViewModel}">
                                <!-- One group per key or text: "Key" or "Text" and a summary; a key row has its key field in the
                                     header, next to Remove; open, the other settings one per line. A key row just added
                                     opens and its key field waits for the key. -->
                                <ui:SettingsExpander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <ui:SettingsExpander.HeaderIcon>
                                        <Grid>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}"
                                                         Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Font}"
                                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </ui:SettingsExpander.HeaderIcon>
                                    <ui:SettingsExpander.Header>
                                        <Grid>
                                            <TextBlock Text="Key" Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="Text" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </ui:SettingsExpander.Header>
                                    <ui:SettingsExpander.Description>
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                    </ui:SettingsExpander.Description>

                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <views:KeyCaptureField VerticalAlignment="Center" Value="{Binding Key}" StartOnLoad="{Binding CaptureOnLoad}"
                                                               KeyOnly="True" AllowPrimaryMouse="True" CanClear="True" ItemName="key"
                                                               Prompt="Press a key or mouse button (Esc cancels)"
                                                               Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}" />
                                        <Button VerticalAlignment="Center" ToolTip="Remove" Tag="{Binding}" Click="OnRemoveActionClick"
                                                AutomationProperties.Name="Remove">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" />
                                        </Button>
                                    </ikw:SimpleStackPanel>

                                    <ui:SettingsExpander.Items>
                                        <ui:SettingsCard Header="Mode" Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}">
                                            <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" AutomationProperties.Name="Repeat or hold down">
                                                <ComboBoxItem Content="Repeat" />
                                                <ComboBoxItem Content="Hold down" />
                                            </ComboBox>
                                        </ui:SettingsCard>
                                        <ui:SettingsCard Header="Text" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"
                                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBox MinHeight="64" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" ui:ControlHelper.PlaceholderText="Text to paste"
                                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <CheckBox Margin="0,0,16,0" Content="Press Enter before pasting" IsChecked="{Binding EnterBefore, Mode=TwoWay}" />
                                                    <CheckBox Content="Press Enter after pasting" IsChecked="{Binding EnterAfter, Mode=TwoWay}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </ui:SettingsCard>
                                        <ui:SettingsCard Header="Every" Visibility="{Binding ShowInterval, Converter={StaticResource BoolToVisibility}}">
                                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                                <ui:NumberBox MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="0" Maximum="86400000"
                                                              SpinButtonPlacementMode="Inline"
                                                              SmallChange="{Binding UnitIndex, Converter={StaticResource IntervalStep}}"
                                                              Value="{Binding IntervalValue, Mode=TwoWay}" AutomationProperties.Name="Interval" />
                                                <ComboBox SelectedIndex="{Binding UnitIndex, Mode=TwoWay}" AutomationProperties.Name="Unit">
                                                    <ComboBoxItem Content="ms" />
                                                    <ComboBoxItem Content="s" />
                                                    <ComboBoxItem Content="min" />
                                                    <ComboBoxItem Content="h" />
                                                </ComboBox>
                                            </ikw:SimpleStackPanel>
                                        </ui:SettingsCard>
                                    </ui:SettingsExpander.Items>
                                </ui:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ikw:SimpleStackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Add key" Click="OnAddKeyClick" />
                        <Button Content="Add text" Click="OnAddTextClick" />
                    </ikw:SimpleStackPanel>
                </ikw:SimpleStackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ikw:SimpleStackPanel Margin="0,8,24,12" Spacing="4">
                    <ui:SettingsCard Header="Activation" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                        <ui:SettingsCard.Description>
                            <TextBlock x:Name="ActivationHint" />
                        </ui:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToggleRadio" Content="Toggle" GroupName="Activation" Checked="OnActivationChanged" />
                            <RadioButton x:Name="HoldRadio" Content="Hold" GroupName="Activation" Checked="OnActivationChanged" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="Hotkey" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <views:KeyCaptureField x:Name="HotkeyField" IsHotkey="True" ValueChanged="OnHotkeyFieldChanged" />
                            <!-- The help, under all the options -->
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Optional. Press any key or mouse button, like F2 or A; for a combination, hold Ctrl, Alt, Shift or Win first. With one of them held, left and right click, the scroll wheel and Esc work too. Without a hotkey, start it with Play or from the overlay panel. Hold needs a hotkey." />
                        </StackPanel>
                    </ui:SettingsCard>

                    <views:FloatingButtonEditor x:Name="FloatingEditor" />

                    <views:SwitchSettingsExpander x:Name="SoundExpander" CanExpand="{Binding IsOn, ElementName=SoundSwitch}" Header="Sound" Description="Plays when the loop starts and stops">
                        <ui:ToggleSwitch x:Name="SoundSwitch" Toggled="OnSoundSwitchChanged" />
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard x:Name="SoundCard" ContentAlignment="Vertical" HorizontalContentAlignment="Left"
                                             Description="Click a sound to pick it and hear the start and stop versions.">
                                <!-- Scrolls on its own so the long list does not make the editor scroll (approved, ui.md). -->
                                <ScrollViewer x:Name="SoundScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ui:RadioButtons x:Name="SoundChoices" MaxColumns="3"
                                                     SelectionChanged="OnSoundSelectionChanged" />
                                </ScrollViewer>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </views:SwitchSettingsExpander>
                </ikw:SimpleStackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <Button x:Name="SaveButton" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="Save" Click="OnSaveClick" />
                <Button x:Name="CancelButton" Grid.Column="3" HorizontalAlignment="Stretch" Content="Cancel" Click="OnCancelClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
