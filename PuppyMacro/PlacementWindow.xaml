<Window
    x:Class="PuppyMacro.PlacementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    Title="{x:Static r:Strings.Placement_Title}"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#59000000"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White"
    PreviewKeyDown="OnKeyDown">

    <!-- Left to right in every language: its children sit at the screen's coordinates (i18n.md) -->
    <Canvas x:Name="Surface" FlowDirection="LeftToRight">
        <!-- Instructions, centered at the top of the main screen -->
        <Border x:Name="Instructions" Padding="16,10" CornerRadius="8" BorderThickness="1"
                Background="#F2202020" BorderBrush="#1FFFFFFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="InstructionsText" FontSize="13" Text="{x:Static r:Strings.Placement_DragPanel}" VerticalAlignment="Center" />
                <Border Margin="16,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="Enter" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="{x:Static r:Strings.Placement_Save}" VerticalAlignment="Center" />
                <Border Margin="14,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="Esc" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="{x:Static r:Strings.Placement_Cancel}" VerticalAlignment="Center" />
                <Border Margin="14,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="{x:Static r:Strings.Placement_Arrows}" />
                </Border>
                <TextBlock x:Name="NudgeText" FontSize="13" Foreground="#C5C5C5" Text="{x:Static r:Strings.Placement_Nudge}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- The ghost panel: same content as overlay mode, dashed pink outline -->
        <Grid x:Name="Ghost" Cursor="SizeAll" Background="Transparent">
            <views:OverlayPanel x:Name="GhostPanel" />
            <Rectangle x:Name="GhostOutline" Margin="-2" RadiusX="9" RadiusY="9" Stroke="#FF5FA2" StrokeThickness="2"
                       StrokeDashArray="4 3" IsHitTestVisible="False" />
        </Grid>

        <!-- Floating buttons are added here in code, above the panel -->

        <!-- Name and position of the selected element, above it -->
        <Border x:Name="SelectionTag" Padding="8,3" CornerRadius="6,6,6,0" Background="#FF5FA2" IsHitTestVisible="False">
            <TextBlock x:Name="SelectionText" FontSize="12" FontWeight="SemiBold" Foreground="#2A0016" />
        </Border>
    </Canvas>
</Window>
