<Window
    x:Class="PuppyMacro.PlacementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    Title="Position the game mode panel"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#59000000"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White"
    PreviewKeyDown="OnKeyDown">

    <Canvas x:Name="Surface">
        <!-- Instructions, centered at the top of the main screen -->
        <Border x:Name="Instructions" Padding="16,10" CornerRadius="8" BorderThickness="1"
                Background="#F2202020" BorderBrush="#1FFFFFFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="13" Text="Drag the panel where you want it" VerticalAlignment="Center" />
                <Border Margin="16,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="Enter" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="Save" VerticalAlignment="Center" />
                <Border Margin="14,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="Esc" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="Cancel" VerticalAlignment="Center" />
                <Border Margin="14,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="Arrows" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="Nudge (Shift ×10)" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- The ghost panel: same content as game mode, dashed pink outline -->
        <Grid x:Name="Ghost" Cursor="SizeAll" Background="Transparent"
              MouseLeftButtonDown="OnGhostMouseDown" MouseMove="OnGhostMouseMove" MouseLeftButtonUp="OnGhostMouseUp">
            <Border Margin="-2,-28,0,0" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                    CornerRadius="6,6,6,0" Background="#FF5FA2">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2A0016" Text="Press Enter to place here" />
            </Border>
            <views:GameModePanel x:Name="GhostPanel" />
            <Rectangle Margin="-2" RadiusX="9" RadiusY="9" Stroke="#FF5FA2" StrokeThickness="2"
                       StrokeDashArray="4 3" IsHitTestVisible="False" />
            <Border Margin="0,0,-2,-26" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    CornerRadius="0,0,6,6" Background="#E6FF5FA2">
                <TextBlock x:Name="CoordinatesText" FontSize="11" FontWeight="SemiBold" Foreground="#2A0016" />
            </Border>
        </Grid>
    </Canvas>
</Window>
