<Window
    x:Class="PuppyMacro.MacroEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:fsi="clr-namespace:iNKORE.UI.WPF.Modern.Common.IconKeys;assembly=iNKORE.UI.WPF.Modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    Title="{x:Static r:Strings.MacroEditor_EditTitle}"
    Width="1420"
    Height="820"
    MinWidth="1020"
    MinHeight="520"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.MinimizeButtonAvailability="Collapsed"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Form view: the actions as rows. Code view: the macro file's JSON in a code editor. -->
        <StackPanel Grid.Row="0">
            <views:ViewSwitchBar x:Name="ViewBar" Margin="24,0,24,8" />
            <!-- A version restored from the History, waiting for Save -->
            <ui:InfoBar x:Name="NoticeBar" Margin="24,0,24,8" Severity="Informational" IsOpen="False" />
        </StackPanel>

        <views:CodeView x:Name="CodeView" Grid.Row="1" Margin="24,0,24,12" Visibility="Collapsed" />
        <views:HistoryView x:Name="HistoryPanel" Grid.Row="1" Margin="24,0,24,12" Visibility="Collapsed" />

        <Grid x:Name="ListBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>

            <!-- Left column: name and the action list, which takes all the height -->
            <Grid Grid.Column="0" Margin="24,8,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="NameBox" Grid.Row="0" TextChanged="OnNameChanged"
                         ui:ControlHelper.Header="{x:Static r:Strings.Editor_Name}"
                         ui:ControlHelper.PlaceholderText="{x:Static r:Strings.MacroEditor_NamePlaceholder}" />

                <TextBlock Grid.Row="1" Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Editor_Actions}" />

                <!-- The commands, on the left in one command bar (standard AppBarButtons, label under the icon): adding
                     and recording in its content, a separator, what works on the selected rows, more in ⋯ (dynamic
                     overflow off, so no command moves into ⋯ while it fits). On the right the list's density (it acts on
                     the view, not on the actions). The same commands on right-click (OnListContextMenuOpening). The
                     buttons are centered in the bar (their style puts them at the top, and the bar is taller than them
                     because of ⋯). -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Bottom"
                                   VerticalContentAlignment="Center" IsDynamicOverflowEnabled="False">
                        <!-- Opening ⋯ does not light up the whole bar (approved, ui.md): its open background and border
                             transparent -->
                        <ui:CommandBar.Resources>
                            <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                            <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />
                        </ui:CommandBar.Resources>
                        <ui:CommandBar.Content>
                            <StackPanel Orientation="Horizontal">
                                <!-- The main command in the accent color (approved, ui.md: an AppBarButton has no accent style) -->
                                <ui:AppBarButton x:Name="AddActionButton" VerticalAlignment="Center" Label="{x:Static r:Strings.MacroEditor_AddAction}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                 Click="OnAddActionClick">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <!-- An If: its conditions on the screen, with Then and Else (approved: the Design canvas "Macro
                                     Conditions"), in the accent color as Add action -->
                                <ui:AppBarButton x:Name="AddConditionButton" VerticalAlignment="Center" Label="{x:Static r:Strings.Condition_Add}"
                                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Click="OnAddConditionClick">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.BranchFork_20_Regular}" />
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <!-- A red record dot (approved, ui.md: the theme's critical color, as the InfoBadge's) -->
                                <ui:AppBarButton Label="{x:Static r:Strings.MacroEditor_Record}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static r:Strings.MacroEditor_RecordActions}" ToolTip="{x:Static r:Strings.MacroEditor_RecordActions}" Click="OnRecordClick">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Record}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                            </StackPanel>
                        </ui:CommandBar.Content>
                        <ui:AppBarSeparator />
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="TestActionButton" Label="{x:Static r:Strings.Editor_Test}" AutomationProperties.Name="{x:Static r:Strings.MacroEditor_TestAction}"
                                         ToolTip="{x:Static r:Strings.MacroEditor_TestTooltip}" Click="OnTestActionClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="EditActionButton" Label="{x:Static r:Strings.MacroEditor_Edit}" AutomationProperties.Name="{x:Static r:Strings.MacroEditor_EditAction}" Click="OnEditActionClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="CopyButton" Label="{x:Static r:Strings.MacroEditor_Copy}"
                                         ToolTip="{x:Static r:Strings.MacroEditor_CopyTooltip}" Click="OnCopySelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="PasteButton" Label="{x:Static r:Strings.MacroEditor_Paste}" ToolTip="{x:Static r:Strings.MacroEditor_PasteTooltip}" Click="OnPasteClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Paste}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="DuplicateButton" Label="{x:Static r:Strings.MacroEditor_Duplicate}"
                                         ToolTip="{x:Static r:Strings.MacroEditor_DuplicateTooltip}" Click="OnDuplicateSelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="GroupButton" Label="{x:Static r:Strings.MacroEditor_Group}"
                                         ToolTip="{x:Static r:Strings.MacroEditor_GroupTooltip}" Click="OnGroupSelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.GroupList}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="DeleteButton" Label="{x:Static r:Strings.MacroEditor_Delete}"
                                         ToolTip="{x:Static r:Strings.MacroEditor_DeleteTooltip}" Click="OnDeleteSelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:CommandBar.SecondaryCommands>
                            <ui:AppBarButton x:Name="RenameGroupButton" Label="{x:Static r:Strings.MacroEditor_RenameGroup}" Click="OnRenameGroupClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Rename}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton x:Name="UngroupButton" Label="{x:Static r:Strings.MacroEditor_Ungroup}"
                                             ToolTip="{x:Static r:Strings.MacroEditor_UngroupTooltip}" Click="OnUngroupClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.RemoveFrom}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarSeparator />
                            <!-- All the groups at once: not on the right-click menu, which acts on the clicked rows -->
                            <ui:AppBarButton x:Name="ExpandAllGroupsButton" Label="{x:Static r:Strings.MacroEditor_ExpandAllGroups}" Click="OnExpandAllGroupsClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.ArrowMaximizeVertical_20_Regular}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton x:Name="CollapseAllGroupsButton" Label="{x:Static r:Strings.MacroEditor_CollapseAllGroups}" Click="OnCollapseAllGroupsClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.ArrowMinimizeVertical_20_Regular}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarSeparator />
                            <ui:AppBarButton Label="{x:Static r:Strings.MacroEditor_Shortcuts}" Click="OnShortcutsClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardShortcut}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar.SecondaryCommands>
                    </ui:CommandBar>
                    <!-- The list's density: click to switch normal / compact, the arrow to choose; normal by
                         default, compact as the library's Gallery does it (DensityStyles/Compact.xaml) -->
                    <ui:ToggleSplitButton x:Name="DensityButton" Grid.Column="1" VerticalAlignment="Center"
                                          AutomationProperties.Name="{x:Static r:Strings.MacroEditor_CompactList}" ToolTip="{x:Static r:Strings.MacroEditor_CompactListTooltip}"
                                          IsCheckedChanged="OnDensityChanged">
                        <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.RowTriple_20_Regular}" />
                        <ui:ToggleSplitButton.Flyout>
                            <ui:MenuFlyout Placement="Bottom">
                                <MenuItem x:Name="NormalDensityItem" Header="{x:Static r:Strings.MacroEditor_DensityNormal}" IsCheckable="True" IsChecked="True" Click="OnNormalDensityClick" />
                                <MenuItem x:Name="CompactDensityItem" Header="{x:Static r:Strings.MacroEditor_DensityCompact}" IsCheckable="True" Click="OnCompactDensityClick" />
                            </ui:MenuFlyout>
                        </ui:ToggleSplitButton.Flyout>
                    </ui:ToggleSplitButton>
                </Grid>

                <!-- What is selected, and where new actions go -->
                <TextBlock x:Name="SelectionText" Grid.Row="3" Margin="0,0,0,4" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <!-- The actions: a standard list (normal or the library's compact density), one line per action with its
                     delay on the right; a group is a row that opens and closes. A thin divider under each row
                     (asked by the user). -->
                <ListView x:Name="ActionList" Grid.Row="4" MinHeight="120" SelectionMode="Extended" AllowDrop="True"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown" MouseDoubleClick="OnListDoubleClick"
                          ContextMenuOpening="OnListContextMenuOpening" PreviewDragOver="OnListPreviewDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Tag" Value="{Binding}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowMouseDown" />
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowMouseUp" />
                            <EventSetter Event="PreviewMouseMove" Handler="OnRowMouseMove" />
                            <Style.Triggers>
                                <!-- Drag to move: a line where the dragged actions go -->
                                <DataTrigger Binding="{Binding DropBefore}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DropAfter}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Resources>
                        <ResourceDictionary>
                            <!-- Hover and selection fill the whole row, square, so they reach the lines between the rows
                                 (approved, ui.md): the library's 4 px inset and rounded corners set to 0 for this list -->
                            <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">0</Thickness>
                            <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
                            <!-- A group: open / close, its name and what it holds -->
                            <DataTemplate DataType="{x:Type views:MacroGroupViewModel}">
                                <Grid Margin="{Binding IndentMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Open / close: just the arrow (no background, border or hover), in the actions' icon column -->
                                    <Button Margin="0,0,12,0" Padding="0" VerticalAlignment="Center" Tag="{Binding}" Click="OnToggleGroupClick"
                                            ToolTip="{Binding ToggleText}" AutomationProperties.Name="{Binding ToggleText}">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </Button.Resources>
                                        <!-- Two fixed icons: in 0.10.2 a FontIcon whose Icon changes after load can clear it.
                                             As wide as an action's icon (16), so the group name lines up with the actions. -->
                                        <Grid Width="16">
                                            <ui:FontIcon FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}"
                                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:FontIcon FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}"
                                                         Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Info, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="{Binding DividerMargin}" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                            <!-- An If's Then or Else: its name (a global word) and when it runs; its actions are indented under it -->
                            <DataTemplate DataType="{x:Type views:MacroBranchViewModel}">
                                <Grid Margin="{Binding IndentMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Info, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Grid.Row="1" Margin="{Binding DividerMargin}" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                            <!-- An action: its icon, its name or description and its details, its delay -->
                            <DataTemplate DataType="{x:Type views:MacroActionRowViewModel}">
                                <!-- The actions of a group, a Then or an Else are indented under it -->
                                <Grid Margin="{Binding IndentMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}"
                                                     Visibility="{Binding IsKeyIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Mouse}"
                                                     Visibility="{Binding IsMouseIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Move}"
                                                     Visibility="{Binding IsMoveIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ScrollUpDown}"
                                                     Visibility="{Binding IsScrollIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Font}"
                                                     Visibility="{Binding IsTextIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.BranchFork_20_Regular}"
                                                     Visibility="{Binding IsIfIcon, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Title, Mode=OneWay}">
                                            <Run.Style>
                                                <!-- A named action shows its name in bold -->
                                                <Style TargetType="Run">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNamed}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text="  " />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{x:Static r:Strings.MacroEditor_DelayTooltip}"
                                               Text="{Binding DelayText}" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="{Binding DividerMargin}" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ResourceDictionary>
                    </ListView.Resources>
                </ListView>
                <TextBlock x:Name="EmptyActionsText" Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.MacroEditor_NoActions}" />
                <TextBlock x:Name="TotalText" Grid.Row="6" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Right column: how the macro plays and starts -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ikw:SimpleStackPanel Margin="0,8,24,12" Spacing="4">
                    <ui:SettingsCard Header="{x:Static r:Strings.Editor_Enabled}">
                        <ui:ToggleSwitch x:Name="EnabledSwitch" AutomationProperties.Name="{x:Static r:Strings.Editor_Enabled}" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static r:Strings.MacroEditor_Repeat}" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                        <!-- The library's group of choices: columns as wide as the longest choice, with its spacing, in every language -->
                        <ikw:SimpleStackPanel Spacing="4">
                            <ui:RadioButtons MaxColumns="3" AutomationProperties.Name="{x:Static r:Strings.MacroEditor_Repeat}">
                                <RadioButton x:Name="OnceRadio" Content="{x:Static r:Strings.MacroEditor_Once}" GroupName="Repeat" Checked="OnRepeatChanged" />
                                <RadioButton x:Name="LoopRadio" Content="{x:Static r:Strings.MacroEditor_Loop}" GroupName="Repeat" Checked="OnRepeatChanged" />
                                <RadioButton x:Name="TimesRadio" Content="{x:Static r:Strings.MacroEditor_NTimes}" GroupName="Repeat" Checked="OnRepeatChanged" />
                            </ui:RadioButtons>
                            <ui:NumberBox x:Name="TimesBox" HorizontalAlignment="Left" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="1" Maximum="100000" AutomationProperties.Name="{x:Static r:Strings.MacroEditor_Times}" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static r:Strings.MacroEditor_Speed}">
                        <!-- The index of MacroDefinition.SpeedSteps; its text is the speed (×0.25 to ×4) -->
                        <views:ValueSlider x:Name="SpeedSlider" Minimum="0" Maximum="4" Step="1" Label="{x:Static r:Strings.MacroEditor_Speed}" />
                    </ui:SettingsCard>

                    <!-- Shown when the macro has an If: how often its conditions look at the screen -->
                    <ui:SettingsCard x:Name="ChecksCard" Header="{x:Static r:Strings.MacroEditor_ChecksPerSecond}"
                                     Description="{x:Static r:Strings.MacroEditor_ChecksPerSecondDescription}" Visibility="Collapsed">
                        <ComboBox x:Name="ChecksBox" MinWidth="160" AutomationProperties.Name="{x:Static r:Strings.MacroEditor_ChecksPerSecond}" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static r:Strings.Editor_Activation}" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                        <ui:SettingsCard.Description>
                            <TextBlock x:Name="ActivationHint" />
                        </ui:SettingsCard.Description>
                        <ui:RadioButtons MaxColumns="2" AutomationProperties.Name="{x:Static r:Strings.Editor_Activation}">
                            <RadioButton x:Name="ToggleRadio" Content="{x:Static r:Strings.Editor_Toggle}" GroupName="Activation" Checked="OnActivationChanged" />
                            <RadioButton x:Name="HoldRadio" Content="{x:Static r:Strings.Editor_Hold}" GroupName="Activation" Checked="OnActivationChanged" />
                        </ui:RadioButtons>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static r:Strings.Editor_Hotkey}" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <views:KeyCaptureField x:Name="HotkeyField" IsHotkey="True" ValueChanged="OnHotkeyFieldChanged" />
                            <!-- The help, under all the options -->
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{x:Static r:Strings.Editor_HotkeyHelp}" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <views:AppScopeEditor x:Name="AppScopeCard" StopsWhenAppChanges="True" Changed="OnAppScopeChanged" />

                    <views:OverlayOptionsEditor x:Name="OverlayOptions" />

                    <views:FloatingButtonEditor x:Name="FloatingEditor" />

                    <views:SwitchSettingsExpander x:Name="SoundExpander" CanExpand="{Binding IsOn, ElementName=SoundSwitch}" Header="{x:Static r:Strings.Editor_Sound}" Description="{x:Static r:Strings.MacroEditor_SoundDescription}">
                        <ui:ToggleSwitch x:Name="SoundSwitch" Toggled="OnSoundSwitchChanged" />
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard x:Name="SoundCard" ContentAlignment="Vertical" HorizontalContentAlignment="Left"
                                             Description="{x:Static r:Strings.Editor_SoundChoose}">
                                <!-- Scrolls on its own so the long list does not make the editor scroll (approved, ui.md). -->
                                <ScrollViewer x:Name="SoundScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ui:RadioButtons x:Name="SoundChoices" MaxColumns="3"
                                                     SelectionChanged="OnSoundSelectionChanged" />
                                </ScrollViewer>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </views:SwitchSettingsExpander>
                </ikw:SimpleStackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <Button x:Name="SaveButton" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Static r:Strings.Editor_Save}" Click="OnSaveClick" />
                <Button x:Name="CancelButton" Grid.Column="3" HorizontalAlignment="Stretch" Content="{x:Static r:Strings.Editor_Cancel}" Click="OnCancelClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
