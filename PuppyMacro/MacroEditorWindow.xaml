<ui:FluentWindow
    x:Class="PuppyMacro.MacroEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    Title="Edit macro"
    Width="1180"
    Height="820"
    MinWidth="900"
    MinHeight="520"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="SoundTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" Height="44" Padding="10,0" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="22" Height="22">
                                    <Ellipse x:Name="Circle" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Path x:Name="Play" Data="M0,0 L6,4 L0,8 Z" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="Play" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop indicators: indented when the dragged actions go into a group. -->
        <Style x:Key="DropLineBefore" TargetType="Border">
            <Setter Property="Height" Value="3" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Visibility" Value="{Binding DropBefore, Converter={StaticResource BoolToVisibility}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropIndented}" Value="True">
                    <Setter Property="Margin" Value="28,0,0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DropLineAfter" TargetType="Border" BasedOn="{StaticResource DropLineBefore}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Visibility" Value="{Binding DropAfter, Converter={StaticResource BoolToVisibility}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DropIndented}" Value="True">
                    <Setter Property="Margin" Value="28,3,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type views:MacroGroupViewModel}">
            <StackPanel>
                <Border Style="{StaticResource DropLineBefore}" />
                <Border Height="40" CornerRadius="6" BorderThickness="1" Tag="{Binding}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseLeftButtonUp="OnRowMouseUp" PreviewMouseMove="OnRowMouseMove">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Style="{StaticResource SubtleButton}" Padding="6" Margin="2,0,0,0" Tag="{Binding}"
                                   ToolTip="{Binding ToggleText}" AutomationProperties.Name="{Binding ToggleText}" Click="OnToggleGroupClick">
                            <ui:SymbolIcon FontSize="14">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ChevronDown24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Symbol" Value="ChevronRight24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>
                        <ui:SymbolIcon Grid.Column="1" Margin="6,0,10,0" Symbol="GroupList24" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        <TextBlock Grid.Column="3" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Info}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Rename24}" ToolTip="Rename group" AutomationProperties.Name="Rename group"
                                       Tag="{Binding}" Click="OnRenameGroupClick" />
                            <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Duplicate group" AutomationProperties.Name="Duplicate group"
                                       Tag="{Binding}" Click="OnDuplicateGroupClick" />
                            <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon GroupDismiss24}" ToolTip="Ungroup (keep the actions)" AutomationProperties.Name="Ungroup"
                                       Tag="{Binding}" Click="OnUngroupClick" />
                            <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove the group and its actions" AutomationProperties.Name="Remove group"
                                       Tag="{Binding}" Click="OnRemoveGroupClick" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DropLineAfter}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:MacroActionRowViewModel}">
            <StackPanel>
                <Border Style="{StaticResource DropLineBefore}" />
                <Grid Tag="{Binding}"
                      PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseLeftButtonUp="OnRowMouseUp" PreviewMouseMove="OnRowMouseMove">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInGroup}" Value="True">
                                    <Setter Property="Margin" Value="22,0,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Number}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="Delay before this action">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="+" VerticalAlignment="Center" />
                        <ui:NumberBox Width="96" Margin="2,0,0,0" Minimum="0" Maximum="86400000" MaxDecimalPlaces="0"
                                      SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" FontSize="12"
                                      Value="{Binding Delay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="4,0,10,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="2" Width="30" Height="30" Margin="0,0,10,0" CornerRadius="6" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding IsKeyIcon, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="CursorClick24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding IsMouseIcon, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="ArrowMove24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding IsMoveIcon, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="ArrowSortDown24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding IsScrollIcon, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding IsTextIcon, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Title, Mode=OneWay}">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNamed}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                        <Run Text="  " />
                        <Run FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Test action: PuppyMacro hides and plays it once in the window behind it"
                                   AutomationProperties.Name="Test action" Tag="{Binding}" Click="OnTestActionClick">
                            <ui:Button.Style>
                                <!-- Accent color, except on a selected row (accent background): there like the other buttons. -->
                                <Style TargetType="ui:Button" BasedOn="{StaticResource SubtleButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Edit action" AutomationProperties.Name="Edit action"
                                   Tag="{Binding}" Click="OnEditActionClick" Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Duplicate action (Ctrl+D)" AutomationProperties.Name="Duplicate action"
                                   Tag="{Binding}" Click="OnDuplicateActionClick" />
                        <ui:Button Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove action" AutomationProperties.Name="Remove action"
                                   Tag="{Binding}" Click="OnRemoveActionClick" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource DropLineAfter}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="EditorTitleBar" Grid.Row="0" Title="Edit macro" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <!-- Form view: the actions as rows. Code view: the macro file's JSON in a code editor. -->
        <views:ViewSwitchBar x:Name="ViewBar" Grid.Row="1" Margin="24,0,24,8" />

        <views:CodeView x:Name="CodeView" Grid.Row="2" Margin="24,0,24,12" Visibility="Collapsed" />

        <Grid x:Name="ListBody" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Left column: name and the action list, which takes all the height -->
            <Grid Grid.Column="0" Margin="24,8,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="Name" />
                <ui:TextBox x:Name="NameBox" Grid.Row="1" PlaceholderText="e.g. Craft and salvage" TextChanged="OnNameChanged" />

                <TextBlock Grid.Row="2" Margin="0,18,0,8" Text="Actions" />
                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="AddActionButton" Content="Add action" Icon="{ui:SymbolIcon Add24}" Click="OnAddActionClick" />
                        <ui:Button Margin="8,0,0,0" Click="OnRecordClick">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Text="Record actions" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <TextBlock x:Name="InsertHint" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Grid>

                <!-- Selection bar: always there, so the list does not move when the selection changes. -->
                <Grid Grid.Row="4" Height="44" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectionBarBack" Grid.ColumnSpan="2" CornerRadius="6" Opacity="0.15" Visibility="Collapsed"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Border Grid.ColumnSpan="2" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <!-- Left-aligned: the info icon follows the text, which is trimmed when space runs out. -->
                    <DockPanel Grid.Column="0" Margin="14,0,8,0" HorizontalAlignment="Left" LastChildFill="True">
                        <!-- The shortcuts, in a tooltip -->
                        <Border x:Name="ShortcutsInfo" DockPanel.Dock="Right" Width="18" Height="18" Margin="8,0,0,0" CornerRadius="9" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" AutomationProperties.Name="Shortcuts"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                            <Border.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Ctrl+click or Shift+click to select more actions. Drag them (or Alt+Up / Alt+Down) to move them, into or out of a group. Ctrl+G groups them, Ctrl+D duplicates them, Ctrl+C / Ctrl+V copy and paste them. New actions go after the selected one, or at the end. ▶ tests an action: PuppyMacro hides and plays it once in the window behind it." />
                                </ToolTip>
                            </Border.ToolTip>
                            <TextBlock Text="i" FontSize="12" FontWeight="Bold" FontStyle="Italic" FontFamily="Georgia"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                        <ui:Button x:Name="GroupButton" Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon GroupList24}" Content="Group"
                                   ToolTip="Put the selected actions in a group (Ctrl+G)" Click="OnGroupSelectedClick" />
                        <ui:Button x:Name="DuplicateButton" Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Copy24}" Content="Duplicate"
                                   ToolTip="Duplicate the selected actions (Ctrl+D)" Click="OnDuplicateSelectedClick" />
                        <ui:Button x:Name="CopyButton" Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Clipboard24}" Content="Copy"
                                   ToolTip="Copy the selected actions, also to paste them in another macro (Ctrl+C)" Click="OnCopySelectedClick" />
                        <ui:Button x:Name="PasteButton" Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon ClipboardPaste24}" Content="Paste"
                                   ToolTip="Paste the copied actions where new actions go (Ctrl+V)" Click="OnPasteClick" />
                        <ui:Button x:Name="DeleteButton" Style="{StaticResource SubtleButton}" Icon="{ui:SymbolIcon Delete24}" Content="Delete"
                                   ToolTip="Delete the selected actions (Delete)" Click="OnDeleteSelectedClick" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="ActionList" Grid.Row="5" MinHeight="120" SelectionMode="Extended" AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown"
                         PreviewDragOver="OnListPreviewDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="EmptyActionsText" Grid.Row="6" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No actions yet. Record actions or add them one by one." />
                <TextBlock x:Name="TotalText" Grid.Row="7" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Right column: how the macro plays and starts -->
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,8,24,12">
                        <TextBlock Margin="0,0,0,6" Text="Repeat" />
                        <WrapPanel>
                            <RadioButton x:Name="OnceRadio" MinWidth="0" Margin="0,0,12,0" Content="Once" GroupName="Repeat" Checked="OnRepeatChanged" />
                            <RadioButton x:Name="LoopRadio" MinWidth="0" Margin="0,0,12,0" Content="Loop" GroupName="Repeat" Checked="OnRepeatChanged" />
                            <RadioButton x:Name="TimesRadio" MinWidth="0" Content="N times" GroupName="Repeat" Checked="OnRepeatChanged" />
                            <ui:NumberBox x:Name="TimesBox" Width="80" Margin="8,0,0,0" Minimum="1" Maximum="100000" MaxDecimalPlaces="0"
                                          SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                        </WrapPanel>

                        <TextBlock x:Name="SpeedLabel" Margin="0,18,0,6" Text="Speed" />
                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Speed" ValueChanged="OnSpeedChanged" />
                        <Grid>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×0.25" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×1" HorizontalAlignment="Center" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="×4" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Activation -->
                        <TextBlock Margin="0,18,0,6" Text="Activation" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToggleRadio" Content="Toggle" GroupName="Activation" Checked="OnActivationChanged" />
                            <RadioButton x:Name="HoldRadio" Margin="16,0,0,0" Content="Hold" GroupName="Activation" Checked="OnActivationChanged" />
                        </StackPanel>
                        <TextBlock x:Name="ActivationHint" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Hotkey -->
                        <TextBlock Margin="0,18,0,6" Text="Hotkey" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="HotkeyCaps" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,0" Padding="8,2" Style="{StaticResource KeyCap}">
                                            <TextBlock FontSize="13" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HotkeyCaptureText" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Press the hotkey (Esc cancels)" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button MinWidth="80" Content="Change" Click="OnChangeHotkeyClick" />
                                <ui:Button x:Name="ClearHotkeyButton" Margin="8,0,0,0" MinWidth="70" Content="Clear" Click="OnClearHotkeyClick" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Optional. With Ctrl, Alt, Shift or Win held, left and right click, the scroll wheel and Esc work too. Without a hotkey, start it with Play or from the overlay panel. Hold needs a hotkey." />

                        <!-- Floating button -->
                        <views:FloatingButtonEditor x:Name="FloatingEditor" Margin="0,18,0,0" />

                        <!-- Sound, in a card like the floating button's -->
                        <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Sound" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Plays when the macro starts and stops" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="SoundSwitch" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     OffContent="Off" OnContent="On" Checked="OnSoundSwitchChanged" Unchecked="OnSoundSwitchChanged" />
                                </Grid>
                                <StackPanel x:Name="SoundPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <UniformGrid x:Name="SoundGrid" Columns="3" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <ui:Button x:Name="SaveButton" Grid.Column="1" HorizontalAlignment="Stretch" Appearance="Primary" Content="Save" Click="OnSaveClick" />
                <ui:Button x:Name="CancelButton" Grid.Column="3" HorizontalAlignment="Stretch" Content="Cancel" Click="OnCancelClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
