<Window
    x:Class="PuppyMacro.MacroEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:fsi="clr-namespace:iNKORE.UI.WPF.Modern.Common.IconKeys;assembly=iNKORE.UI.WPF.Modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    Title="Edit macro"
    Width="1180"
    Height="820"
    MinWidth="900"
    MinHeight="520"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.MinimizeButtonAvailability="Collapsed"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Form view: the actions as rows. Code view: the macro file's JSON in a code editor. -->
        <views:ViewSwitchBar x:Name="ViewBar" Grid.Row="0" Margin="24,0,24,8" />

        <views:CodeView x:Name="CodeView" Grid.Row="1" Margin="24,0,24,12" Visibility="Collapsed" />

        <Grid x:Name="ListBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Left column: name and the action list, which takes all the height -->
            <Grid Grid.Column="0" Margin="24,8,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="NameBox" Grid.Row="0" TextChanged="OnNameChanged"
                         ui:ControlHelper.Header="Name"
                         ui:ControlHelper.PlaceholderText="e.g. Craft and salvage" />

                <TextBlock Grid.Row="1" Margin="0,16,10,5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Actions" />

                <!-- The commands, on the left in one command bar (standard AppBarButtons, label under the icon): adding
                     and recording in its content, a separator, what works on the selected rows, more in ⋯ (dynamic
                     overflow off, so no command moves into ⋯ while it fits). On the right the list's density (it acts on
                     the view, not on the actions). The same commands on right-click (OnListContextMenuOpening). The
                     buttons are centered in the bar (their style puts them at the top, and the bar is taller than them
                     because of ⋯). -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Bottom"
                                   VerticalContentAlignment="Center" IsDynamicOverflowEnabled="False">
                        <!-- Opening ⋯ does not light up the whole bar (approved, ui.md): its open background and border
                             transparent -->
                        <ui:CommandBar.Resources>
                            <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="Transparent" />
                            <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="Transparent" />
                        </ui:CommandBar.Resources>
                        <ui:CommandBar.Content>
                            <StackPanel Orientation="Horizontal">
                                <!-- The main command in the accent color (approved, ui.md: an AppBarButton has no accent style) -->
                                <ui:AppBarButton x:Name="AddActionButton" VerticalAlignment="Center" Label="Add action" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                 Click="OnAddActionClick">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" />
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                                <!-- A red record dot (approved, ui.md: the theme's critical color, as the InfoBadge's) -->
                                <ui:AppBarButton Label="Record" VerticalAlignment="Center" AutomationProperties.Name="Record actions" ToolTip="Record actions" Click="OnRecordClick">
                                    <ui:AppBarButton.Icon>
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Record}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </ui:AppBarButton.Icon>
                                </ui:AppBarButton>
                            </StackPanel>
                        </ui:CommandBar.Content>
                        <ui:AppBarSeparator />
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="TestActionButton" Label="Test" AutomationProperties.Name="Test action"
                                         ToolTip="PuppyMacro hides and plays the selected action once in the window behind it" Click="OnTestActionClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="EditActionButton" Label="Edit" AutomationProperties.Name="Edit action" Click="OnEditActionClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="CopyButton" Label="Copy"
                                         ToolTip="Copy the selected actions, also to paste them in another macro (Ctrl+C)" Click="OnCopySelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="PasteButton" Label="Paste" ToolTip="Paste the copied actions where new actions go (Ctrl+V)" Click="OnPasteClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Paste}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="DuplicateButton" Label="Duplicate"
                                         ToolTip="Duplicate the selected actions (Ctrl+D)" Click="OnDuplicateSelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Copy}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="GroupButton" Label="Group"
                                         ToolTip="Put the selected actions in a group (Ctrl+G)" Click="OnGroupSelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.GroupList}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:AppBarButton VerticalAlignment="Center" x:Name="DeleteButton" Label="Delete"
                                         ToolTip="Delete the selected actions (Delete)" Click="OnDeleteSelectedClick">
                            <ui:AppBarButton.Icon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" />
                            </ui:AppBarButton.Icon>
                        </ui:AppBarButton>
                        <ui:CommandBar.SecondaryCommands>
                            <ui:AppBarButton x:Name="RenameGroupButton" Label="Rename group" Click="OnRenameGroupClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Rename}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarButton x:Name="UngroupButton" Label="Ungroup"
                                             ToolTip="Ungroup (keep the actions)" Click="OnUngroupClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.RemoveFrom}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                            <ui:AppBarSeparator />
                            <ui:AppBarButton Label="Shortcuts" Click="OnShortcutsClick">
                                <ui:AppBarButton.Icon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardShortcut}" />
                                </ui:AppBarButton.Icon>
                            </ui:AppBarButton>
                        </ui:CommandBar.SecondaryCommands>
                    </ui:CommandBar>
                    <!-- The list's density: click to switch normal / compact, the arrow to choose; normal by
                         default, compact as the library's Gallery does it (DensityStyles/Compact.xaml) -->
                    <ui:ToggleSplitButton x:Name="DensityButton" Grid.Column="1" VerticalAlignment="Center"
                                          AutomationProperties.Name="Compact list" ToolTip="Compact list: smaller rows"
                                          IsCheckedChanged="OnDensityChanged">
                        <ui:FontIcon Icon="{x:Static fsi:FluentSystemIcons.RowTriple_20_Regular}" />
                        <ui:ToggleSplitButton.Flyout>
                            <ui:MenuFlyout Placement="Bottom">
                                <MenuItem x:Name="NormalDensityItem" Header="Normal" IsCheckable="True" IsChecked="True" Click="OnNormalDensityClick" />
                                <MenuItem x:Name="CompactDensityItem" Header="Compact" IsCheckable="True" Click="OnCompactDensityClick" />
                            </ui:MenuFlyout>
                        </ui:ToggleSplitButton.Flyout>
                    </ui:ToggleSplitButton>
                </Grid>

                <!-- What is selected, and where new actions go -->
                <TextBlock x:Name="SelectionText" Grid.Row="3" Margin="0,0,0,4" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <!-- The actions: a standard list (normal or the library's compact density), one line per action with its
                     delay on the right; a group is a row that opens and closes. A thin divider under each row
                     (asked by the user). -->
                <ListView x:Name="ActionList" Grid.Row="4" MinHeight="120" SelectionMode="Extended" AllowDrop="True"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown" MouseDoubleClick="OnListDoubleClick"
                          ContextMenuOpening="OnListContextMenuOpening" PreviewDragOver="OnListPreviewDragOver" DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Tag" Value="{Binding}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowMouseDown" />
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowMouseUp" />
                            <EventSetter Event="PreviewMouseMove" Handler="OnRowMouseMove" />
                            <Style.Triggers>
                                <!-- Drag to move: a line where the dragged actions go -->
                                <DataTrigger Binding="{Binding DropBefore}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DropAfter}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Resources>
                        <ResourceDictionary>
                            <!-- Hover and selection fill the whole row, square, so they reach the lines between the rows
                                 (approved, ui.md): the library's 4 px inset and rounded corners set to 0 for this list -->
                            <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">0</Thickness>
                            <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
                            <!-- A group: open / close, its name and what it holds -->
                            <DataTemplate DataType="{x:Type views:MacroGroupViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Open / close: just the arrow (no background, border or hover), in the actions' icon column -->
                                    <Button Margin="0,0,12,0" Padding="0" VerticalAlignment="Center" Tag="{Binding}" Click="OnToggleGroupClick"
                                            ToolTip="{Binding ToggleText}" AutomationProperties.Name="{Binding ToggleText}">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </Button.Resources>
                                        <!-- Two fixed icons: in 0.10.2 a FontIcon whose Icon changes after load can clear it.
                                             As wide as an action's icon (16), so the group name lines up with the actions. -->
                                        <Grid Width="16">
                                            <ui:FontIcon FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}"
                                                         Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:FontIcon FontSize="12" Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}"
                                                         Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Info, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="-12,0,-12,0" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                            <!-- An action: its icon, its name or description and its details, its delay -->
                            <DataTemplate DataType="{x:Type views:MacroActionRowViewModel}">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <!-- The actions of a group are indented under it -->
                                                <DataTrigger Binding="{Binding IsInGroup}" Value="True">
                                                    <Setter Property="Margin" Value="24,0,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}"
                                                     Visibility="{Binding IsKeyIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Mouse}"
                                                     Visibility="{Binding IsMouseIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Move}"
                                                     Visibility="{Binding IsMoveIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ScrollUpDown}"
                                                     Visibility="{Binding IsScrollIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Font}"
                                                     Visibility="{Binding IsTextIcon, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Title, Mode=OneWay}">
                                            <Run.Style>
                                                <!-- A named action shows its name in bold -->
                                                <Style TargetType="Run">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNamed}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text="  " />
                                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="Delay before this action"
                                               Text="{Binding DelayText}" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Out of the item's 12 px padding, and of the group indent -->
                                                <Setter Property="Margin" Value="-12,0,-12,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInGroup}" Value="True">
                                                        <Setter Property="Margin" Value="-36,0,-12,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ResourceDictionary>
                    </ListView.Resources>
                </ListView>
                <TextBlock x:Name="EmptyActionsText" Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No actions yet. Record actions or add them one by one." />
                <TextBlock x:Name="TotalText" Grid.Row="6" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Right column: how the macro plays and starts -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ikw:SimpleStackPanel Margin="0,8,24,12" Spacing="4">
                    <ui:SettingsCard Header="Repeat" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                        <WrapPanel>
                            <RadioButton x:Name="OnceRadio" Content="Once" GroupName="Repeat" Checked="OnRepeatChanged" />
                            <RadioButton x:Name="LoopRadio" Content="Loop" GroupName="Repeat" Checked="OnRepeatChanged" />
                            <RadioButton x:Name="TimesRadio" Content="N times" GroupName="Repeat" Checked="OnRepeatChanged" />
                            <ui:NumberBox x:Name="TimesBox" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="1" Maximum="100000" AutomationProperties.Name="Times" />
                        </WrapPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard x:Name="SpeedCard" Header="Speed" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="Speed" ValueChanged="OnSpeedChanged" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="Activation" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                        <ui:SettingsCard.Description>
                            <TextBlock x:Name="ActivationHint" />
                        </ui:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToggleRadio" Content="Toggle" GroupName="Activation" Checked="OnActivationChanged" />
                            <RadioButton x:Name="HoldRadio" Content="Hold" GroupName="Activation" Checked="OnActivationChanged" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="Hotkey" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <views:KeyCaptureField x:Name="HotkeyField" IsHotkey="True" ValueChanged="OnHotkeyFieldChanged" />
                            <!-- The help, under all the options -->
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Optional. With Ctrl, Alt, Shift or Win held, left and right click, the scroll wheel and Esc work too. Without a hotkey, start it with Play or from the overlay panel. Hold needs a hotkey." />
                        </StackPanel>
                    </ui:SettingsCard>

                    <views:FloatingButtonEditor x:Name="FloatingEditor" />

                    <views:SwitchSettingsExpander x:Name="SoundExpander" CanExpand="{Binding IsOn, ElementName=SoundSwitch}" Header="Sound" Description="Plays when the macro starts and stops">
                        <ui:ToggleSwitch x:Name="SoundSwitch" Toggled="OnSoundSwitchChanged" />
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard x:Name="SoundCard" ContentAlignment="Vertical" HorizontalContentAlignment="Left"
                                             Description="Click a sound to pick it and hear the start and stop versions.">
                                <!-- Scrolls on its own so the long list does not make the editor scroll (approved, ui.md). -->
                                <ScrollViewer x:Name="SoundScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ui:RadioButtons x:Name="SoundChoices" MaxColumns="3"
                                                     SelectionChanged="OnSoundSelectionChanged" />
                                </ScrollViewer>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </views:SwitchSettingsExpander>
                </ikw:SimpleStackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <Button x:Name="SaveButton" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="Save" Click="OnSaveClick" />
                <Button x:Name="CancelButton" Grid.Column="3" HorizontalAlignment="Stretch" Content="Cancel" Click="OnCancelClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
