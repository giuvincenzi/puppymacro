<Window
    x:Class="PuppyMacro.ItemsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.MinimizeButtonAvailability="Collapsed"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed"
    Width="800"
    Height="1000"
    MinWidth="560"
    MinHeight="520"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Import or Export of loops, macros and remaps (MainWindow.Share.cs): a window of its own opened as the editors are
         (MainWindow.ShowDialogWithoutHotkeys: the main window hidden meanwhile), with Views/ImportItemsView or
         Views/ExportItemsView; the buttons' area as the editors' -->
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton" Grid.Column="1" MinWidth="160" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                        Click="OnPrimaryClick" />
                <Button Grid.Column="3" MinWidth="160" Content="{x:Static r:Strings.Main_Cancel}" IsCancel="True" />
            </Grid>
        </Border>
        <ContentPresenter x:Name="Body" Margin="24,8,24,24" />
    </DockPanel>
</Window>
