<ui:FluentWindow
    x:Class="PuppyMacro.MacroActionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Action"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel>
        <ui:TitleBar x:Name="ActionTitleBar" Title="Action" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <StackPanel Margin="24,4,24,12">
            <!-- Name -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Name (optional)" />
                <ui:TextBox x:Name="ActionNameBox" PlaceholderText="e.g. Open inventory" MaxLength="100" />
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Shown in the list in bold, before the description of the action." />
            </StackPanel>

            <!-- Key -->
            <StackPanel x:Name="KeyGroup" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Key" />
                <ui:Button x:Name="KeyButton" MinWidth="120" Content="Choose key" Click="OnChooseKeyClick"
                           ToolTip="Click, then press the key" />
                <StackPanel x:Name="HoldKeyRow" Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock Width="110" VerticalAlignment="Center" Text="Hold for" />
                    <ui:NumberBox x:Name="KeyHoldBox" Width="120" Minimum="1" Maximum="60000" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" />
                </StackPanel>
            </StackPanel>

            <!-- Mouse button -->
            <StackPanel x:Name="ButtonGroup" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Mouse button" />
                <ComboBox x:Name="ButtonBox" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Left" Tag="1" />
                    <ComboBoxItem Content="Right" Tag="2" />
                    <ComboBoxItem Content="Middle" Tag="4" />
                    <ComboBoxItem Content="Back (X1)" Tag="5" />
                    <ComboBoxItem Content="Forward (X2)" Tag="6" />
                </ComboBox>
                <StackPanel x:Name="ClickOptions" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SingleClickRadio" Content="Single click" GroupName="ClickCount" />
                        <RadioButton x:Name="DoubleClickRadio" Margin="16,0,0,0" Content="Double click" GroupName="ClickCount" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock Width="110" VerticalAlignment="Center" Text="Hold for" />
                        <ui:NumberBox x:Name="ClickHoldBox" Width="120" Minimum="1" Maximum="60000" MaxDecimalPlaces="0"
                                      SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Repeat (Press key, Click) -->
            <StackPanel x:Name="RepeatGroup" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RepeatLabel" Width="110" VerticalAlignment="Center" Text="Press" />
                    <ui:NumberBox x:Name="RepeatBox" Width="120" Minimum="1" Maximum="100000" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="times" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock Width="110" VerticalAlignment="Center" Text="Pause between" />
                    <ui:NumberBox x:Name="RepeatPauseBox" Width="120" Minimum="0" Maximum="86400000" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                           Text="Pause between only applies when it is repeated more than once. Default is 1 time." />
            </StackPanel>

            <!-- Position -->
            <StackPanel x:Name="PositionGroup" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Position" />
                <WrapPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="X" />
                        <ui:NumberBox x:Name="XBox" Width="100" Minimum="-100000" Maximum="100000" MaxDecimalPlaces="0"
                                      SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Y" />
                        <ui:NumberBox x:Name="YBox" Width="100" Minimum="-100000" Maximum="100000" MaxDecimalPlaces="0"
                                      SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                    </StackPanel>
                    <ui:Button Margin="0,16,0,0" VerticalAlignment="Bottom" Content="Pick on screen"
                               Icon="{ui:SymbolIcon Target24}" Click="OnPickClick" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Screen pixels, from the top-left corner of the main screen." TextWrapping="Wrap" />
            </StackPanel>

            <!-- Movement -->
            <StackPanel x:Name="MoveGroup" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Movement" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="InstantRadio" Content="Instantly" GroupName="Movement" Checked="OnMovementChanged" />
                    <RadioButton x:Name="SmoothRadio" Margin="16,0,0,0" Content="Smoothly" GroupName="Movement" Checked="OnMovementChanged" />
                </StackPanel>
                <StackPanel x:Name="SpeedRow" Margin="0,12,0,0">
                    <TextBlock x:Name="SpeedLabel" Text="Speed" />
                    <Slider x:Name="SpeedSlider" Margin="0,6,0,0" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Movement speed" ValueChanged="OnSpeedChanged" />
                    <Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Very slow" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Very fast" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Scroll -->
            <StackPanel x:Name="ScrollGroup" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Scroll" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DirectionBox" Width="120">
                        <ComboBoxItem Content="Up" />
                        <ComboBoxItem Content="Down" />
                        <ComboBoxItem Content="Left" />
                        <ComboBoxItem Content="Right" />
                    </ComboBox>
                    <ui:NumberBox x:Name="StepsBox" Width="90" Margin="10,0,0,0" Minimum="1" Maximum="1000" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="steps" />
                </StackPanel>
            </StackPanel>

            <!-- Text -->
            <StackPanel x:Name="TextGroup" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,6" Text="Text to paste" />
                <ui:TextBox x:Name="PasteTextBox" MinHeight="70" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" PlaceholderText="Text to paste" TextChanged="OnTextChanged" />
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox x:Name="EnterBeforeBox" Margin="0,0,16,0" Content="Press Enter before pasting" />
                    <CheckBox x:Name="EnterAfterBox" Content="Press Enter after pasting" />
                </WrapPanel>
            </StackPanel>

            <!-- Delay -->
            <TextBlock Margin="0,0,0,6" Text="Delay before this action" />
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox x:Name="DelayBox" Width="140" Minimum="0" Maximum="86400000" MaxDecimalPlaces="0"
                              SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="ms" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
        </StackPanel>

        <Border Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="SaveButton" Grid.Column="0" HorizontalAlignment="Stretch" Appearance="Primary" Content="Save" Click="OnSaveClick" />
                <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Cancel" Click="OnCancelClick" />
            </Grid>
        </Border>
    </StackPanel>
</ui:FluentWindow>
