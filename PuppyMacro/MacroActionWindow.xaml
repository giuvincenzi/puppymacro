<Window
    x:Class="PuppyMacro.MacroActionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:fsi="clr-namespace:iNKORE.UI.WPF.Modern.Common.IconKeys;assembly=iNKORE.UI.WPF.Modern"
    Title="{x:Static r:Strings.ActionWindow_Title}"
    Width="760"
    Height="660"
    MinWidth="520"
    MinHeight="440"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.MinimizeButtonAvailability="Collapsed"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed">

    <DockPanel LastChildFill="True">
        <!-- Form view: the action's fields. Code view: the action's JSON, as in the macro file. -->
        <views:ViewSwitchBar x:Name="ViewBar" DockPanel.Dock="Top" Margin="24,4,24,8" />

        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TestButton" Grid.Column="0" Click="OnTestClick" AutomationProperties.Name="{x:Static r:Strings.Editor_Test}"
                        ToolTip="{x:Static r:Strings.ActionWindow_TestTooltip}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ui:FontIcon FontSize="14" Icon="{x:Static fsi:FluentSystemIcons.Play_16_Filled}" />
                        <TextBlock Text="{x:Static r:Strings.Editor_Test}" />
                    </ikw:SimpleStackPanel>
                </Button>
                <Button x:Name="SaveButton" Grid.Column="2" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Static r:Strings.Editor_Save}" Click="OnSaveClick" />
                <Button x:Name="CancelButton" Grid.Column="4" HorizontalAlignment="Stretch" Content="{x:Static r:Strings.Editor_Cancel}" Click="OnCancelClick" />
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Margin="24,0,24,12" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

        <Grid>
            <views:CodeView x:Name="CodeView" Margin="24,0,24,12" Visibility="Collapsed" />
            <!-- Form view: the action's Name and Delay (the macro's), then the action's box, open: the same box as a
                 loop row (Views/ActionBox) -->
            <ScrollViewer x:Name="FormBody" VerticalScrollBarVisibility="Auto">
                <ikw:SimpleStackPanel Margin="24,4,24,12" Spacing="4">
                    <!-- An If with a Text condition: text recognition is slower than looking for an image (approved: above
                         the cards, outside them) -->
                    <ui:InfoBar x:Name="TextNotice" Margin="0,0,0,8" Severity="Informational" IsClosable="False" IsOpen="False"
                                Message="{x:Static r:Strings.Condition_TextNotice}" />
                    <ui:SettingsCard Header="{x:Static r:Strings.ActionWindow_Name}" Description="{x:Static r:Strings.ActionWindow_NameDescription}">
                        <TextBox x:Name="ActionNameBox" Width="260" MaxLength="100" AutomationProperties.Name="{x:Static r:Strings.Editor_Name}"
                                 ui:ControlHelper.PlaceholderText="{x:Static r:Strings.ActionWindow_NamePlaceholder}" />
                    </ui:SettingsCard>
                    <ui:SettingsCard Header="{x:Static r:Strings.ActionWindow_Delay}" Description="{x:Static r:Strings.ActionWindow_DelayDescription}">
                        <!-- Inside a component: a list before it, "A value" or "From …" (as the If's Wait card) -->
                        <ikw:SimpleStackPanel x:Name="DelayFrom" Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="160" ItemsSource="{Binding DelayMs.Choices}" SelectedIndex="{Binding DelayMs.Index, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                      Visibility="{Binding DelayMs.Show, Converter={StaticResource BoolToVisibility}}" />
                            <ui:NumberBox x:Name="DelayBox" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="0" Maximum="86400000"
                                          AutomationProperties.Name="{x:Static r:Strings.ActionWindow_Delay}"
                                          Visibility="{Binding DelayMs.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.Editor_Ms}"
                                       Visibility="{Binding DelayMs.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>
                    <views:ActionBox x:Name="Box" Margin="0,12,0,0" Rejected="ShowError" />
                    <!-- An If: its conditions and when its Then runs -->
                    <views:ConditionsEditor x:Name="Conditions" Visibility="Collapsed" />
                </ikw:SimpleStackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
