<Window
    x:Class="PuppyMacro.ScreenPickWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    Title="{x:Static r:Strings.ScreenPick_PixelTitle}"
    WindowStyle="None"
    Background="Black"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    Cursor="Cross"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White"
    PreviewKeyDown="OnKeyDown">

    <!-- A still picture of the screen as the conditions see it, with the pick drawn over it (approved: the Design canvas
         "Macro Conditions", Pick the pixel, Take the image, Draw the search area; fixed dark look, like the other
         overlays). Left to right in every language: its children sit at the screen's coordinates (i18n.md). -->
    <Canvas x:Name="Surface" FlowDirection="LeftToRight" Background="Transparent"
            MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">

        <!-- Taking an image or drawing an area: the rectangle, its size, and its buttons once it is drawn -->
        <Border x:Name="Selection" BorderThickness="2" BorderBrush="#60CDFF" Background="#1A60CDFF"
                IsHitTestVisible="False" Visibility="Collapsed" />
        <Border x:Name="SizeLabel" Padding="8,2" CornerRadius="4" Background="#60CDFF" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" FontSize="12" Foreground="Black" />
        </Border>
        <ikw:SimpleStackPanel x:Name="SelectionButtons" Orientation="Horizontal" Spacing="8" Cursor="Arrow" Visibility="Collapsed">
            <Button x:Name="UseButton" Style="{StaticResource AccentButtonStyle}" Click="OnUseClick" />
            <!-- Draw the rectangle again, on the same picture of the screen -->
            <Button x:Name="RetryButton" Content="{x:Static r:Strings.ScreenPick_Retry}" Click="OnRetryClick" />
            <Button Content="{x:Static r:Strings.Pick_Cancel}" Click="OnCancelClick" />
        </ikw:SimpleStackPanel>

        <!-- Picking a pixel: the pixels around the pointer, enlarged, with the one in the middle outlined, its color and where it is -->
        <Border x:Name="Lens" BorderThickness="1" BorderBrush="#1FFFFFFF" Background="#F2202020" CornerRadius="8" Padding="6"
                IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel>
                <Grid Width="121" Height="121">
                    <Image x:Name="LensImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                    <Border Width="13" Height="13" BorderThickness="1.5" BorderBrush="White" />
                </Grid>
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <Border x:Name="LensSwatch" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="#6A6A6A" VerticalAlignment="Center" />
                    <TextBlock x:Name="LensText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="Instructions" Padding="16,10" CornerRadius="8" BorderThickness="1"
                Background="#F2202020" BorderBrush="#1FFFFFFF" Cursor="Arrow">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="InstructionsText" FontSize="13" VerticalAlignment="Center" />
                <Border Margin="16,0,6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737">
                    <TextBlock FontSize="12" Text="{x:Static r:Strings.Keys_Esc}" />
                </Border>
                <TextBlock FontSize="13" Foreground="#C5C5C5" Text="{x:Static r:Strings.Pick_Cancel}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
