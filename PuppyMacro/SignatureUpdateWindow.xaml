<Window
    x:Class="PuppyMacro.SignatureUpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    Title="{x:Static r:Strings.Signature_Title}"
    Width="720"
    Height="620"
    MinWidth="520"
    MinHeight="400"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica">

    <!-- Saving a component whose parameters changed updates the calls (approved: the Design canvas "PuppyMacro Component
         functions", Update the calls): one value for each parameter every call now needs, the parameters taken out, the
         macros and components whose calls change; all saved together, or nothing -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Static r:Strings.Signature_Heading}" />
                <TextBlock x:Name="IntroText" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ItemsControl x:Name="ValuesList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:SettingsCard Margin="0,0,0,4" Header="{Binding Header}" Description="{Binding Description}" AutomationProperties.Name="{Binding Header}">
                                <views:ValueEditor DataContext="{Binding Value}" />
                            </ui:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="RemovedList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:SettingsCard Margin="0,0,0,4" Header="{Binding Header}" Description="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,16,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Signature_Changing}" />
                <ItemsControl x:Name="SitesList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:SettingsCard Margin="0,0,0,4" Header="{Binding Name}" Description="{Binding Kind}" AutomationProperties.Name="{Binding Name}">
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Calls}" />
                            </ui:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Margin="24,0,24,12" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

        <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateButton" MinWidth="140" Style="{StaticResource AccentButtonStyle}" Content="{x:Static r:Strings.Signature_UpdateAndSave}"
                        IsDefault="True" Click="OnUpdateClick" />
                <Button Margin="8,0,0,0" MinWidth="120" Content="{x:Static r:Strings.Editor_Cancel}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
