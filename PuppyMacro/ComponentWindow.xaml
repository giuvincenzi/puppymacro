<Window
    x:Class="PuppyMacro.ComponentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Width="640"
    Height="600"
    MinWidth="480"
    MinHeight="360"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica">

    <!-- A row linked to a Library component, read only (approved: the Design canvas "PuppyMacro Library") -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,16">
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,8"
                            Message="{x:Static r:Strings.Component_LinkedInfo}" />
                <ui:SettingsCard x:Name="CollectionCard" Header="{x:Static r:Strings.Library_Collection}" Margin="0,0,0,4">
                    <TextBlock x:Name="CollectionText" TextWrapping="Wrap" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="{x:Static r:Strings.Library_UsedIn}">
                    <TextBlock x:Name="UsedInText" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right" />
                </ui:SettingsCard>
                <TextBlock Margin="0,24,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Static r:Strings.Component_WhatItPlays}" />
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,4">
                    <ItemsControl x:Name="ActionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="{Binding Indent}" Padding="0,8" TextWrapping="Wrap">
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="UnlinkButton" Content="{x:Static r:Strings.Component_UnlinkRow}" Click="OnUnlinkClick" />
                <Button x:Name="OpenLibraryButton" Grid.Column="2" MinWidth="120" Content="{x:Static r:Strings.Component_OpenInLibrary}" Click="OnOpenLibraryClick" />
                <Button Grid.Column="4" MinWidth="120" Style="{StaticResource AccentButtonStyle}" Content="{x:Static r:Strings.Editor_Close}"
                        IsDefault="True" IsCancel="True" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
