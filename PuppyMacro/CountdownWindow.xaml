<Window
    x:Class="PuppyMacro.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recording countdown"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    FontFamily="Segoe UI Variable Text, Segoe UI">

    <StackPanel>
        <Grid Width="300" Height="300">
            <Ellipse Fill="#385A5A5A" />
            <Ellipse Width="288" Height="288" Stroke="#1FFFFFFF" StrokeThickness="8" />
            <!-- Empties during each second: dash and gap are the ring's length in stroke widths. -->
            <Ellipse x:Name="Ring" Width="288" Height="288" Stroke="#BFC8C8C8" StrokeThickness="8" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock x:Name="NumberText" FontSize="200" FontWeight="SemiBold" Foreground="#CCC8C8C8" Text="3"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" />
        </Grid>
        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="22" Foreground="#D9FFFFFF" Text="Recording starts…">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>
    </StackPanel>
</Window>
