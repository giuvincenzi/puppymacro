<Window
    x:Class="PuppyMacro.FloatingButtonWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    Title="{x:Static r:Strings.Floating_WindowTitle}"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual">

    <views:FloatingButtonView x:Name="ButtonView" />
</Window>
