<Window
    x:Class="PuppyMacro.RecordPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Ready to record"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica">

    <StackPanel>
        <StackPanel Margin="24,4,24,20">
            <!-- A red dot before the title, as on the record buttons (approved, ui.md) -->
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <ui:InfoBadge Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource CriticalDotInfoBadgeStyle}" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ready to record" />
            </StackPanel>
            <WrapPanel>
                <TextBlock Text="Press " VerticalAlignment="Center" />
                <Border Margin="4,0" Style="{StaticResource KeyCap}">
                    <TextBlock x:Name="HotkeyText" />
                </Border>
                <TextBlock Text=" or select " VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Start recording" VerticalAlignment="Center" />
                <TextBlock Text=" to start recording" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock x:Name="DescriptionText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <CheckBox x:Name="MouseMovementBox" Margin="0,12,0,0" Content="Record mouse movement"
                      Checked="OnMouseMovementChanged" Unchecked="OnMouseMovementChanged" />
        </StackPanel>

        <Border Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="Start recording" Click="OnStartNowClick" />
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Cancel" Click="OnCancelClick" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
