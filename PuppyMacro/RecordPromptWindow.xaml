<ui:FluentWindow
    x:Class="PuppyMacro.RecordPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Ready to record"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel>
        <ui:TitleBar Title="Ready to record" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />
        <StackPanel Margin="24,4,24,20">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="#C42B1C" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold" Text="Ready to record" />
            </StackPanel>
            <WrapPanel Margin="0,14,0,0">
                <TextBlock FontSize="15" Text="Press " VerticalAlignment="Center" />
                <Border Margin="4,0" Padding="10,1" Style="{StaticResource KeyCap}">
                    <TextBlock x:Name="HotkeyText" FontSize="14" />
                </Border>
                <TextBlock FontSize="15" Text=" or select " VerticalAlignment="Center" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Start recording" VerticalAlignment="Center" />
                <TextBlock FontSize="15" Text=" to start recording" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock x:Name="DescriptionText" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <CheckBox x:Name="MouseMovementBox" Margin="0,14,0,0" Content="Record mouse movement"
                      Checked="OnMouseMovementChanged" Unchecked="OnMouseMovementChanged" />
            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="100" Content="Cancel" Click="OnCancelClick" />
                <ui:Button Margin="8,0,0,0" Appearance="Primary" Click="OnStartNowClick">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="Start recording" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
