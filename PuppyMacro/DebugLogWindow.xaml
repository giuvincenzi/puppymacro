<Window
    x:Class="PuppyMacro.DebugLogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Width="820"
    Height="600"
    MinWidth="480"
    MinHeight="320"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica">

    <!-- A macro's Debug log (RunLog): the last run, in English, read only; its pictures are in its folder -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,4,24,12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static r:Strings.DebugLog_Description}" />

        <TextBox x:Name="LogBox" Grid.Row="1" Margin="24,0,24,16" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static r:Strings.DebugLog_Log}" />

        <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyButton" Grid.Column="0" MinWidth="120" Content="{x:Static r:Strings.DebugLog_Copy}" Click="OnCopyClick" />
                <Button x:Name="OpenFolderButton" Grid.Column="2" MinWidth="120" Content="{x:Static r:Strings.DebugLog_OpenFolder}" Click="OnOpenFolderClick" />
                <Button Grid.Column="4" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Static r:Strings.Editor_Close}" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
