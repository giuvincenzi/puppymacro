<Window
    x:Class="PuppyMacro.RemapEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:TitleBar.MinimizeButtonAvailability="Collapsed"
    ui:TitleBar.MaximizeButtonAvailability="Collapsed"
    Title="{x:Static r:Strings.RemapEditor_AddTitle}"
    Width="1140"
    Height="560"
    MinWidth="880"
    MinHeight="440"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterOwner"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <DockPanel LastChildFill="True">
        <!-- Form view: the remap's fields. Code view: the remap's JSON, as in settings.json. -->
        <views:ViewSwitchBar x:Name="ViewBar" DockPanel.Dock="Top" Margin="24,4,24,8" />
        <!-- A version restored from the History, waiting for Save -->
        <ui:InfoBar x:Name="NoticeBar" DockPanel.Dock="Top" Margin="24,0,24,8" Severity="Informational" IsOpen="False" />

        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Static r:Strings.Editor_Save}" Click="OnSaveClick" />
                <Button x:Name="CancelButton" Grid.Column="3" HorizontalAlignment="Stretch" Content="{x:Static r:Strings.Editor_Cancel}" Click="OnCancelClick" />
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Margin="24,0,24,12" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

        <Grid>
            <views:CodeView x:Name="CodeView" Margin="24,0,24,12" Visibility="Collapsed" />
            <views:HistoryView x:Name="HistoryPanel" Margin="24,0,24,12" Visibility="Collapsed" />
            <!-- Form view: the keys on the left, where and why on the right -->
            <Grid x:Name="FormBody">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="520" />
                </Grid.ColumnDefinitions>

                <ikw:SimpleStackPanel Grid.Column="0" Margin="24,4,24,12" Spacing="4">
                    <!-- Source -->
                    <ui:SettingsCard Header="{x:Static r:Strings.RemapEditor_WhenIPress}"
                                     Description="{x:Static r:Strings.RemapEditor_KeyDescription}"
                                     ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <views:KeyCaptureField x:Name="SourceField" AllowPrimaryMouse="True" AllowModifierAlone="True" CanClear="False"
                                               ItemName="key" Prompt="{x:Static r:Strings.RemapEditor_KeyPrompt}"
                                               ValueChanged="OnSourceFieldChanged" Rejected="ShowError" />
                    </ui:SettingsCard>

                    <!-- Target -->
                    <ui:SettingsCard Header="{x:Static r:Strings.RemapEditor_SendInstead}"
                                     Description="{x:Static r:Strings.RemapEditor_KeyDescription}"
                                     ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <views:KeyCaptureField x:Name="TargetField" AllowPrimaryMouse="True" AllowModifierAlone="True" CanClear="False"
                                               ItemName="key" Prompt="{x:Static r:Strings.RemapEditor_KeyPrompt}"
                                               ValueChanged="OnTargetFieldChanged" Rejected="ShowError" />
                    </ui:SettingsCard>
                </ikw:SimpleStackPanel>

                <ikw:SimpleStackPanel Grid.Column="1" Margin="0,4,24,12" Spacing="4">
                    <!-- Scope -->
                    <ui:SettingsCard Header="{x:Static r:Strings.Editor_Enabled}">
                        <ui:ToggleSwitch x:Name="EnabledSwitch" AutomationProperties.Name="{x:Static r:Strings.Editor_Enabled}" />
                    </ui:SettingsCard>

                    <views:AppScopeEditor x:Name="AppScopeCard" Changed="OnAppScopeChanged" />

                    <!-- Note -->
                    <ui:SettingsCard Header="{x:Static r:Strings.RemapEditor_Note}" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <TextBox x:Name="NoteBox" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.RemapEditor_NotePlaceholder}" />
                    </ui:SettingsCard>
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
