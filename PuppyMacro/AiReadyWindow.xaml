<Window
    x:Class="PuppyMacro.AiReadyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    Title="{x:Static r:Strings.AiRequest_Title}"
    Width="480"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White">

    <!-- Before an AI app's pick or placement (approved design): what it asks, why and the steps, in the middle of the screen
         on top of the game or app the user prepares, and dragged anywhere; Enter (from any app) or Start when ready, Esc
         cancels. Fixed dark look, like the other windows over apps. -->
    <Border CornerRadius="8" BorderThickness="1" Background="#F22B2B2B" BorderBrush="#1FFFFFFF" MouseLeftButtonDown="OnDragStart" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd">
        <StackPanel>
            <StackPanel Margin="20,16,20,18">
                <TextBlock x:Name="AskedByText" FontSize="12" Foreground="#C5C5C5" />
                <TextBlock x:Name="TitleText" Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" Margin="0,6,0,0" FontSize="13" Foreground="#C5C5C5" TextWrapping="Wrap" LineHeight="19" />
                <TextBlock Margin="0,16,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#C5C5C5" Text="{x:Static r:Strings.AiRequest_Instructions}" />
                <ItemsControl x:Name="StepsList" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#60CDFF" Text="{Binding Number}" />
                                <TextBlock Grid.Column="1" FontSize="14" TextWrapping="Wrap" LineHeight="20" Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Border Padding="20,12" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0" BorderBrush="#1FFFFFFF" Background="#F2202020">
                <DockPanel>
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Click="OnStartClick" Focusable="False" AutomationProperties.Name="{x:Static r:Strings.AiReady_Start}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" Height="32" Padding="18,0" CornerRadius="4" Background="#60CDFF">
                                    <TextBlock FontSize="14" Foreground="Black" Text="{x:Static r:Strings.AiReady_Start}" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="Background" Value="#7DD6FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- "Press [Enter] when you're ready · [Esc] cancels": the sentence is one text (AiReady_Hint), its parts and
                         the two keycaps put in its order in code (BuildHint) -->
                    <StackPanel x:Name="HintPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="EnterCap" Margin="6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Text="{x:Static r:Strings.Keys_Enter}" />
                        </Border>
                        <Border x:Name="EscCap" Margin="6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Text="{x:Static r:Strings.Keys_Esc}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
