<Window
    x:Class="PuppyMacro.AiReadyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI request"
    Width="440"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    ShowInTaskbar="True"
    ShowActivated="False"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="Manual"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White">

    <!-- Before an AI app's pick or key request (approved design): what it asks and why, on top of the game or app the user
         prepares; Enter (from any app) or Start when ready, Esc cancels. Fixed dark look, like the other windows over apps. -->
    <Border CornerRadius="8" BorderThickness="1" Background="#F22B2B2B" BorderBrush="#1FFFFFFF">
        <StackPanel>
            <StackPanel Margin="20,16,20,18">
                <TextBlock x:Name="AskedByText" FontSize="12" Foreground="#C5C5C5" />
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#C5C5C5" Text="Context" />
                <TextBlock x:Name="ContextText" Margin="0,4,0,0" FontSize="13" Foreground="#C5C5C5" TextWrapping="Wrap" LineHeight="19" />
            </StackPanel>
            <Border Padding="20,12" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0" BorderBrush="#1FFFFFFF" Background="#F2202020">
                <DockPanel>
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Click="OnStartClick" Focusable="False" AutomationProperties.Name="Start">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" Height="32" Padding="18,0" CornerRadius="4" Background="#60CDFF">
                                    <TextBlock FontSize="14" Foreground="Black" Text="Start" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="Background" Value="#7DD6FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="#C5C5C5" Text="Press" VerticalAlignment="Center" />
                        <Border Margin="6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Text="Enter" />
                        </Border>
                        <TextBlock FontSize="13" Foreground="#C5C5C5" Text="when you're ready ·" VerticalAlignment="Center" />
                        <Border Margin="6,0" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2" BorderBrush="#5A5A5A" Background="#373737" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Text="Esc" />
                        </Border>
                        <TextBlock FontSize="13" Foreground="#C5C5C5" Text="cancels" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
