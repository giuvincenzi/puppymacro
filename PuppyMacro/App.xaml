<Application
    x:Class="PuppyMacro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Small key label, e.g. [F9] -->
            <Style x:Key="KeyCap" TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Icon button like the ⋯ of Windows Settings: no border, a light fill on mouse over.
                 WPF-UI's Transparent appearance keeps the standard button's border on mouse over. -->
            <Style x:Key="SubtleButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="Transparent" />
                <Setter Property="PressedBackground" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
            </Style>

            <!-- The ⋯ "More options" button of a list card, standard padding. Its content is the "More" glyph
                 of the Windows icon font: <ui:FontIcon Glyph="&#xE712;" Style="{StaticResource MoreGlyph}" />. -->
            <Style x:Key="MoreButton" TargetType="ui:Button" BasedOn="{StaticResource SubtleButton}">
                <Setter Property="ToolTip" Value="More options" />
            </Style>
            <Style x:Key="MoreGlyph" TargetType="ui:FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </Style>

            <!-- Side rail item (Loops / Settings) -->
            <Style x:Key="RailButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Width="56" Height="54">
                                <Border x:Name="Back" CornerRadius="6" Background="Transparent" />
                                <Border x:Name="Mark" Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Back" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- Settings and loop card -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
