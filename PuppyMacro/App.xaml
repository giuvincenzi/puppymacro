<Application
    x:Class="PuppyMacro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources>
                    <!-- The Idle status dot (approved, ui.md): Windows' default blue for each theme, as the
                         library's Gallery adds its own theme colors -->
                    <ui:ThemeResources.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light" ui:ThemeDictionary.Key="Light">
                            <SolidColorBrush x:Key="IdleDotBrush" Color="#005FB8" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark" ui:ThemeDictionary.Key="Dark">
                            <SolidColorBrush x:Key="IdleDotBrush" Color="#60CDFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast" ui:ThemeDictionary.Key="HighContrast">
                            <SolidColorBrush x:Key="IdleDotBrush" Color="{DynamicResource SystemColorHighlightColor}" />
                        </ResourceDictionary>
                    </ui:ThemeResources.ThemeDictionaries>
                </ui:ThemeResources>
                <ui:XamlControlsResources />
                <!-- The InfoBadge styles by name (status dots), as the library's Gallery loads them -->
                <ResourceDictionary Source="/iNKORE.UI.WPF.Modern.Controls;component/Controls/Windows/InfoBadge/InfoBadge.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- iNKORE 0.10.2 bug: SettingsCard styles a NumberBox inside it with MinWidth="{StaticResource
                 SettingsCardContentMinWidth}", which its theme style cannot find: the layout throws. Every
                 NumberBox in a SettingsCard sets MinWidth from this key itself (a local value wins over that
                 style). Same key and value as the library's theme. -->
            <sys:Double x:Key="SettingsCardContentMinWidth">120</sys:Double>

            <!-- Small key label, e.g. [F9] -->
            <Style x:Key="KeyCap" TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Idle (enabled, not running) in the lists: the informational dot in blue instead of its grey -->
            <Style x:Key="IdleDotInfoBadgeStyle" TargetType="ui:InfoBadge" BasedOn="{StaticResource InformationalDotInfoBadgeStyle}">
                <Setter Property="Background" Value="{DynamicResource IdleDotBrush}" />
            </Style>

            <!-- A hotkey or key the user chose, in the accent color (approved, ui.md): the key field and the list
                 cards. An ItemsControl with ItemTemplate="{StaticResource AccentKeyCapItem}" and
                 ItemsPanel="{StaticResource KeyCapRow}" over the key names (KeyNames.Parts). -->
            <DataTemplate x:Key="AccentKeyCapItem">
                <Border Margin="0,0,4,0" Style="{StaticResource KeyCap}" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding}" />
                </Border>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="KeyCapRow">
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
