<UserControl
    x:Class="PuppyMacro.Views.ViewSwitchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- Form view: the editor's fields. Code view: the item's JSON in a code editor.
         The standard NavigationView at the top switches the view; Format sits in its pane footer. -->
    <ui:NavigationView
        x:Name="Views"
        PaneDisplayMode="Top"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        SelectionChanged="OnSelectionChanged">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="FormViewButton" Content="Form view" IsSelected="True" />
            <ui:NavigationViewItem x:Name="CodeViewButton" Content="Code view"
                                   ToolTip="The JSON as it is saved, in a code editor: Ctrl+Space suggests what can go where" />
        </ui:NavigationView.MenuItems>
        <ui:NavigationView.PaneFooter>
            <Button x:Name="FormatButton" Margin="0,0,8,0" VerticalAlignment="Center" Content="Format"
                    ToolTip="Format the code (Shift+Alt+F)" Visibility="Collapsed" Click="OnFormatClick" />
        </ui:NavigationView.PaneFooter>
    </ui:NavigationView>
</UserControl>
