<UserControl
    x:Class="PuppyMacro.Views.ViewSwitchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- The checked view has a fill and an accent bar -->
        <Style x:Key="ViewSwitch" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Back" Padding="14,6" CornerRadius="4" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Bar" Width="16" Height="3" Margin="0,0,0,1" CornerRadius="1.5" VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                <Setter TargetName="Back" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Form view: the editor's fields. Code view: the item's JSON in a code editor. -->
    <Grid>
        <Border HorizontalAlignment="Left" Padding="2" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FormViewButton" Style="{StaticResource ViewSwitch}" IsChecked="True"
                             AutomationProperties.Name="Form view" Checked="OnChecked">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16" />
                        <TextBlock Margin="8,0,0,0" Text="Form view" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CodeViewButton" Margin="2,0,0,0" Style="{StaticResource ViewSwitch}"
                             AutomationProperties.Name="Code view" Checked="OnChecked"
                             ToolTip="The JSON as it is saved, in a code editor: Ctrl+Space suggests what can go where">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CodeBlock24" FontSize="16" />
                        <TextBlock Margin="8,0,0,0" Text="Code view" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>
        <ui:Button x:Name="FormatButton" HorizontalAlignment="Right" Content="Format" Icon="{ui:SymbolIcon TextAlignLeft24}"
                   ToolTip="Format the code (Shift+Alt+F)" Visibility="Collapsed" Click="OnFormatClick" />
    </Grid>
</UserControl>
