<UserControl
    x:Class="PuppyMacro.Views.MouseButtonBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The mouse button of a Click or Mouse button down / up, in loops and macros -->
    <ComboBox x:Name="Box" MinWidth="140" AutomationProperties.Name="Mouse button" SelectionChanged="OnSelectionChanged">
        <ComboBoxItem Content="Left" Tag="1" />
        <ComboBoxItem Content="Right" Tag="2" />
        <ComboBoxItem Content="Middle" Tag="4" />
        <ComboBoxItem Content="Back (X1)" Tag="5" />
        <ComboBoxItem Content="Forward (X2)" Tag="6" />
    </ComboBox>
</UserControl>
