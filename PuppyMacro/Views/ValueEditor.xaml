<UserControl
    x:Class="PuppyMacro.Views.ValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:r="clr-namespace:PuppyMacro.Resources">

    <!-- One value of a component's parameter (DataContext: ValueEditorViewModel), with the controls the app uses for that kind
         of field: a point (PositionPicker), a number and its unit, a text, a key (KeyCaptureField), a color picked on the
         screen, images taken on the screen, an area drawn on the screen. On one line, for the right of a SettingsCard. -->
    <Grid>
        <views:PositionPicker X="{Binding X, Mode=TwoWay}" Y="{Binding Y, Mode=TwoWay}"
                              Visibility="{Binding IsPoint, Converter={StaticResource BoolToVisibility}}" />

        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
            <ui:NumberBox MinWidth="{StaticResource SettingsCardContentMinWidth}" Value="{Binding Number, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Static r:Strings.Param_Value}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UnitText}" />
        </ikw:SimpleStackPanel>

        <TextBox Width="260" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static r:Strings.Param_Value}"
                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />

        <views:KeyCaptureField x:Name="KeyField" Value="{Binding Key, Mode=TwoWay}" KeyOnly="False" CanClear="False" ItemName="key"
                               Prompt="{x:Static r:Strings.KeyField_PromptCombination}"
                               Visibility="{Binding IsKey, Converter={StaticResource BoolToVisibility}}" />

        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibility}}">
            <Border Width="32" Height="32" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                    Background="{Binding Swatch}" />
            <TextBox Width="110" MaxLength="7" Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static r:Strings.Condition_Color}" />
            <views:PlaceButton VerticalAlignment="Center" Text="{x:Static r:Strings.Position_PickOnScreen}" Click="OnPickColorClick" />
        </ikw:SimpleStackPanel>

        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ImagesText}" />
            <views:PlaceButton VerticalAlignment="Center" Text="{x:Static r:Strings.Condition_TakeOnScreen}" Click="OnTakeImageClick" />
        </ikw:SimpleStackPanel>

        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding IsArea, Converter={StaticResource BoolToVisibility}}">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AreaText}" />
            <views:PlaceButton VerticalAlignment="Center" Text="{x:Static r:Strings.Condition_DrawOnScreen}" Click="OnDrawAreaClick" />
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>
