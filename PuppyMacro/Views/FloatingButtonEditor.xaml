<UserControl
    x:Class="PuppyMacro.Views.FloatingButtonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:views="clr-namespace:PuppyMacro.Views">

    <!-- Floating button expander, shared by the loop and macro editors -->
    <views:SwitchSettingsExpander x:Name="FloatingExpander" Header="{x:Static r:Strings.FloatingButton_Header}" CanExpand="False"
                         Description="{x:Static r:Strings.FloatingButton_Description}">
        <ui:ToggleSwitch x:Name="FloatingSwitch" Toggled="OnSwitchChanged" />

        <ui:SettingsExpander.Items>
            <!-- Preview on a dark disc, as it looks over a fullscreen app -->
            <ui:SettingsCard ContentAlignment="Left">
                <Border Width="72" Height="72" CornerRadius="8" Background="#2E4157" HorizontalAlignment="Left">
                    <views:FloatingButtonView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ui:SettingsCard>

            <ui:SettingsCard Header="{x:Static r:Strings.FloatingButton_Label}">
                <TextBox x:Name="LabelBox" MaxLength="2" TextChanged="OnLabelChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard Header="{x:Static r:Strings.FloatingButton_Size}">
                <ComboBox x:Name="SizeBox" SelectionChanged="OnSizeChanged">
                    <ComboBoxItem Content="{x:Static r:Strings.FloatingButton_Small}" />
                    <ComboBoxItem Content="{x:Static r:Strings.FloatingButton_Medium}" />
                    <ComboBoxItem Content="{x:Static r:Strings.FloatingButton_Large}" />
                </ComboBox>
            </ui:SettingsCard>

            <!-- Position shows the whole overlay to drag it -->
            <ui:SettingsCard Header="{x:Static r:Strings.FloatingButton_PositionOnScreen}">
                <views:PlaceButton MovesOverlay="True" Text="{x:Static r:Strings.FloatingButton_Position}" Click="OnPositionClick" />
            </ui:SettingsCard>

            <ui:SettingsCard Header="{x:Static r:Strings.FloatingButton_Opacity}">
                <views:ValueSlider x:Name="OpacitySlider" Minimum="20" Maximum="100" Label="{x:Static r:Strings.FloatingButton_OpacityLabel}"
                                   ValueChanged="OnOpacityChanged" />
            </ui:SettingsCard>

        </ui:SettingsExpander.Items>
    </views:SwitchSettingsExpander>
</UserControl>
