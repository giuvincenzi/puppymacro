<UserControl
    x:Class="PuppyMacro.Views.FloatingButtonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:views="clr-namespace:PuppyMacro.Views">

    <!-- Floating button expander, shared by the loop and macro editors -->
    <views:SwitchSettingsExpander x:Name="FloatingExpander" Header="Floating button" CanExpand="False"
                         Description="A round button in overlay mode that starts and stops it. It replaces its row in the overlay panel.">
        <ui:ToggleSwitch x:Name="FloatingSwitch" Toggled="OnSwitchChanged" />

        <ui:SettingsExpander.Items>
            <!-- Preview on a dark disc, as it looks over a fullscreen app -->
            <ui:SettingsCard ContentAlignment="Left">
                <Border Width="72" Height="72" CornerRadius="8" Background="#2E4157" HorizontalAlignment="Left">
                    <views:FloatingButtonView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ui:SettingsCard>

            <ui:SettingsCard Header="Label">
                <TextBox x:Name="LabelBox" MaxLength="2" TextChanged="OnLabelChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard Header="Size">
                <ComboBox x:Name="SizeBox" SelectionChanged="OnSizeChanged">
                    <ComboBoxItem Content="Small" />
                    <ComboBoxItem Content="Medium" />
                    <ComboBoxItem Content="Large" />
                </ComboBox>
            </ui:SettingsCard>

            <ui:SettingsCard Header="Opacity" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                <ui:SettingsCard.Description>
                    <TextBlock x:Name="OpacityValueText" />
                </ui:SettingsCard.Description>
                <Slider x:Name="OpacitySlider"
                        Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                        AutomationProperties.Name="Floating button opacity" ValueChanged="OnOpacityChanged" />
            </ui:SettingsCard>

            <ui:SettingsCard Description="Position… shows the whole overlay: drag this button, the other floating buttons and the overlay panel.">
                <ui:SettingsCard.Header>
                    <TextBlock x:Name="PositionText" TextWrapping="Wrap" />
                </ui:SettingsCard.Header>
                <Button Content="Position…" Click="OnPositionClick" />
            </ui:SettingsCard>
        </ui:SettingsExpander.Items>
    </views:SwitchSettingsExpander>
</UserControl>
