<UserControl
    x:Class="PuppyMacro.Views.FloatingButtonEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views">

    <!-- Floating button card, shared by the loop and macro editors -->
    <Border Padding="14,12" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Floating button" />
                    <TextBlock x:Name="DescriptionText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="A round button in overlay mode that starts and stops it. It replaces its row in the overlay panel." />
                </StackPanel>
                <ui:ToggleSwitch x:Name="FloatingSwitch" Grid.Column="1" VerticalAlignment="Center"
                                 OffContent="Off" OnContent="On"
                                 Checked="OnSwitchChanged" Unchecked="OnSwitchChanged" />
            </Grid>

            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                <Border Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Preview on a dark disc, as it looks over a fullscreen app -->
                        <Border Width="72" Height="72" CornerRadius="8" Background="#2E4157" HorizontalAlignment="Left">
                            <views:FloatingButtonView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Label" />
                            <ui:TextBox x:Name="LabelBox" Margin="0,4,0,0" Width="64" MaxLength="2"
                                        ClearButtonEnabled="False" TextChanged="OnLabelChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Size" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <RadioButton x:Name="SmallRadio" MinWidth="0" Content="S" GroupName="FloatingSize" Checked="OnSizeChanged" />
                                <RadioButton x:Name="MediumRadio" Margin="12,0,0,0" MinWidth="0" Content="M" GroupName="FloatingSize" Checked="OnSizeChanged" />
                                <RadioButton x:Name="LargeRadio" Margin="12,0,0,0" MinWidth="0" Content="L" GroupName="FloatingSize" Checked="OnSizeChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Opacity" VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                            Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                            AutomationProperties.Name="Floating button opacity" ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="2" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PositionText" FontSize="12" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Position… shows the whole overlay: drag this button, the other floating buttons and the overlay panel." />
                    </StackPanel>
                    <ui:Button x:Name="PositionButton" Grid.Column="1" Content="Position…" Click="OnPositionClick" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
