<UserControl
    x:Class="PuppyMacro.Views.MacroCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The macro editor's Code view: Monaco in a WebView2 (added in code) and the Problems panel -->
    <Border CornerRadius="6" BorderThickness="1" ClipToBounds="True"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Grid x:Name="EditorHost" Grid.Row="0" />
            <TextBlock x:Name="StatusText" Grid.Row="0" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Loading the code editor…" />

            <!-- Problems, VS Code style: click one to go to its line -->
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,8,14,4" Orientation="Horizontal">
                        <TextBlock Text="Problems" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:Name="ProblemCountBadge" Margin="8,0,0,0" MinWidth="20" Height="18" Padding="6,0" CornerRadius="9"
                                VerticalAlignment="Center" Background="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed">
                            <TextBlock x:Name="ProblemCountText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="NoProblemsText" DockPanel.Dock="Top" Margin="14,4,14,0" FontSize="12" Text="No problems."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ListBox x:Name="ProblemList" Margin="4,0,4,4" AutomationProperties.Name="Problems"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnProblemClick" KeyDown="OnProblemKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,12,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Text="{Binding Message}" ToolTip="{Binding Message}" />
                                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Position}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
