<UserControl
    x:Class="PuppyMacro.Views.ImportItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- Import's content, in its ContentDialog (approved design: the Design canvas "PuppyMacro Import and Export", A2): the
         file, then its loops, macros and remaps by kind, each with a check box, what changes on import or why it can't -->
    <UserControl.Resources>
        <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:FontIcon VerticalAlignment="Center" FontSize="24" Icon="{x:Static ui:SegoeFluentIcons.Page}" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="ImportFileText" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ImportFromText" Style="{StaticResource Description}" />
            </StackPanel>
            <Button x:Name="OtherFileButton" Grid.Column="2" VerticalAlignment="Center" Content="Choose another file…"
                    Click="OnOtherFileClick" />
        </Grid>

        <TextBlock x:Name="ImportErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel x:Name="ImportListPanel">
            <CheckBox x:Name="ImportSelectAllBox" Margin="0,12,0,8" Content="Select all" IsThreeState="True" Click="OnSelectAllClick" />
            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ImportItemList" Margin="12,0,12,8" Focusable="False">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,12,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanImport}"
                                          AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource Description}"
                                                       Text="{Binding Summary}" />
                                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource Description}"
                                                       Text="{Binding Lead}" />
                                            <ItemsControl VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding HotkeyParts}"
                                                          ItemTemplate="{StaticResource AccentKeyCapItem}" ItemsPanel="{StaticResource KeyCapRow}" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Notes}"
                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Problem}"
                                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <ui:InfoBar Margin="0,12,0,0" IsOpen="True" IsClosable="False" Severity="Informational"
                        Title="Imported items start disabled." Message="Turn each one on when you have checked what it does." />
        </StackPanel>
    </StackPanel>
</UserControl>
