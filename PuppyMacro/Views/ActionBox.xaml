<UserControl
    x:Class="PuppyMacro.Views.ActionBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:PuppyMacro"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    xmlns:r="clr-namespace:PuppyMacro.Resources">

    <!-- One action, the same box in a loop row and in the macro's action window (DataContext: ActionBoxViewModel).
         The header has the action's main field (key, mouse button, direction or point). Opened, the rows in this order,
         each shown where it belongs (ActionBoxViewModel.Show…): the loop's While the loop runs and Every, then the
         action's own options. Position and Mode are twice: first in a macro, later in a loop. Key down and Key up
         have no options: a plain card. Inside a component, a field that can take one of its parameters' values has a list
         before it, as the If's Wait card ("A value" or "From Hold"), and shows only with "A value" (Slots). -->
    <UserControl.Resources>
        <local:IntervalStepConverter x:Key="IntervalStep" />

        <!-- The box's header fields -->
        <DataTemplate x:Key="HeaderFields" DataType="{x:Type views:ActionBoxViewModel}">
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                <!-- Inside a component: the key from a parameter -->
                <ComboBox MinWidth="160" ItemsSource="{Binding Slots.Key.Choices}" SelectedIndex="{Binding Slots.Key.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.Key.Show, Converter={StaticResource BoolToVisibility}}" />
                <views:KeyCaptureField VerticalAlignment="Center" Value="{Binding Key}" StartOnLoad="{Binding CaptureOnLoad}"
                                       KeyOnly="{Binding KeyFieldKeyOnly}" AllowModifierAlone="{Binding KeyFieldModifierAlone}"
                                       CanClear="{Binding InLoop}" ItemName="key" Prompt="{Binding KeyPrompt}"
                                       Loaded="OnKeyFieldLoaded"
                                       Visibility="{Binding KeyFieldShown, Converter={StaticResource BoolToVisibility}}" />
                <views:MouseButtonBox VerticalAlignment="Center" Vk="{Binding MouseVk}" Rejected="OnMouseRejected"
                                      Visibility="{Binding IsMouseKind, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox VerticalAlignment="Center" MinWidth="120" SelectedIndex="{Binding DirectionIndex, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Static r:Strings.Action_Direction}"
                          Visibility="{Binding IsScroll, Converter={StaticResource BoolToVisibility}}">
                    <ComboBoxItem Content="{x:Static r:Strings.Action_DirectionUp}" />
                    <ComboBoxItem Content="{x:Static r:Strings.Action_DirectionDown}" />
                    <ComboBoxItem Content="{x:Static r:Strings.Action_DirectionLeft}" />
                    <ComboBoxItem Content="{x:Static r:Strings.Action_DirectionRight}" />
                </ComboBox>
                <views:PositionPicker VerticalAlignment="Center" X="{Binding X}" Y="{Binding Y}"
                                      Visibility="{Binding ShowHeaderPoint, Converter={StaticResource BoolToVisibility}}" />
                <Button VerticalAlignment="Center" ToolTip="{x:Static r:Strings.Action_Remove}" AutomationProperties.Name="{x:Static r:Strings.Action_Remove}" Click="OnRemoveClick"
                        Visibility="{Binding InLoop, Converter={StaticResource BoolToVisibility}}">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" />
                </Button>
            </ikw:SimpleStackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ui:SettingsExpander x:Name="Expander" Header="{Binding Title}" Description="{Binding Summary}"
                             IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                             Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
            <!-- One icon per kind (a FontIcon's Icon must never change, ui.md) -->
            <ui:SettingsExpander.HeaderIcon>
                <Grid>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}"
                                 Visibility="{Binding IsKeyKind, Converter={StaticResource BoolToVisibility}}" />
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Mouse}"
                                 Visibility="{Binding IsMouseKind, Converter={StaticResource BoolToVisibility}}" />
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Move}"
                                 Visibility="{Binding IsMoveTo, Converter={StaticResource BoolToVisibility}}" />
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ScrollUpDown}"
                                 Visibility="{Binding IsScroll, Converter={StaticResource BoolToVisibility}}" />
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Font}"
                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ui:SettingsExpander.HeaderIcon>

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource HeaderFields}" Focusable="False" />

            <ui:SettingsExpander.Items>
                <!-- Loop: kept held down, or repeated -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_WhileLoopRuns}" Visibility="{Binding ShowRun, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox MinWidth="140" SelectedIndex="{Binding RunIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_WhileLoopRuns}">
                        <ComboBoxItem Content="{x:Static r:Strings.Action_Repeat}" />
                        <ComboBoxItem Content="{x:Static r:Strings.Action_HoldDown}" />
                    </ComboBox>
                </ui:SettingsCard>

                <!-- Loop: how often -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Every}" Visibility="{Binding ShowEvery, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ui:NumberBox MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="0" Maximum="86400000"
                                      SpinButtonPlacementMode="Inline"
                                      SmallChange="{Binding UnitIndex, Converter={StaticResource IntervalStep}}"
                                      Value="{Binding IntervalValue, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Interval}" />
                        <ComboBox SelectedIndex="{Binding UnitIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Unit}">
                            <ComboBoxItem Content="{x:Static r:Strings.Action_UnitMs}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Action_UnitS}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Action_UnitMin}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Action_UnitH}" />
                        </ComboBox>
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <!-- Macro: where the button is pressed, first -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Position}" Visibility="{Binding ShowPositionFirst, Converter={StaticResource BoolToVisibility}}">
                    <views:PositionPicker X="{Binding X}" Y="{Binding Y}" />
                </ui:SettingsCard>

                <!-- Macro, inside an If's Then: Position chooses a fixed point or where a condition found its image or text, then
                     either the point or how far from the found center -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Position}" Description="{x:Static r:Strings.Action_PositionDescription}"
                                 Visibility="{Binding ShowFoundPosition, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox x:Name="PositionChoice" MinWidth="200" ItemsSource="{Binding PositionChoices}"
                              SelectedIndex="{Binding PositionIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Position}" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Point}"
                                 Visibility="{Binding ShowFixedPoint, Converter={StaticResource BoolToVisibility}}">
                    <views:PositionPicker X="{Binding X}" Y="{Binding Y}" />
                </ui:SettingsCard>
                <!-- Inside a component, with A cell of a Grid parameter chosen: which cell, a number or From a Number parameter
                     (approved: the Design canvas "PuppyMacro Component functions", The component's click: a cell of a Grid) -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Cell}" Description="{x:Static r:Strings.Action_CellDescription}"
                                 Visibility="{Binding UsesGrid, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="160" ItemsSource="{Binding Slots.Cell.Choices}" SelectedIndex="{Binding Slots.Cell.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.Cell.Show, Converter={StaticResource BoolToVisibility}}" />
                        <ui:NumberBox MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="1" Maximum="10000" SmallChange="1"
                                      Value="{Binding Cell, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Cell}"
                                      Visibility="{Binding Slots.Cell.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>
                <ui:SettingsCard Header="{x:Static r:Strings.Action_MoveFromCenter}" Description="{x:Static r:Strings.Action_MoveFromCenterDescription}"
                                 Visibility="{Binding UsesFound, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.Position_X}" />
                        <ui:NumberBox MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="-100000" Maximum="100000"
                                      Value="{Binding OffsetX, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_MoveRight}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.Position_Y}" />
                        <ui:NumberBox MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="-100000" Maximum="100000"
                                      Value="{Binding OffsetY, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_MoveDown}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <!-- Macro: single or double click, before Hold for -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Mode}" Visibility="{Binding ShowModeFirst, Converter={StaticResource BoolToVisibility}}">
                    <ui:RadioButtons MaxColumns="2" SelectedIndex="{Binding ClickModeIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Mode}">
                        <RadioButton Content="{x:Static r:Strings.Action_Single}" />
                        <RadioButton Content="{x:Static r:Strings.Action_Double}" />
                    </ui:RadioButtons>
                </ui:SettingsCard>

                <ui:SettingsCard Header="{x:Static r:Strings.Action_HoldFor}" Description="{Binding HoldDescription}"
                                 Visibility="{Binding ShowHoldFor, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="160" ItemsSource="{Binding Slots.HoldMs.Choices}" SelectedIndex="{Binding Slots.HoldMs.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.HoldMs.Show, Converter={StaticResource BoolToVisibility}}" />
                        <ui:NumberBox x:Name="HoldBox" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="1" Maximum="60000"
                                      Value="{Binding HoldMs, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_HoldFor}" Visibility="{Binding Slots.HoldMs.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.Action_UnitMs}" Visibility="{Binding Slots.HoldMs.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <!-- Loop: single or double click, after Hold for -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Mode}" Visibility="{Binding ShowModeAfterHold, Converter={StaticResource BoolToVisibility}}">
                    <ui:RadioButtons MaxColumns="2" SelectedIndex="{Binding ClickModeIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Mode}">
                        <RadioButton Content="{x:Static r:Strings.Action_Single}" />
                        <RadioButton Content="{x:Static r:Strings.Action_Double}" />
                    </ui:RadioButtons>
                </ui:SettingsCard>

                <ui:SettingsCard Header="{x:Static r:Strings.Action_Times}" Visibility="{Binding ShowTimes, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="160" ItemsSource="{Binding Slots.Repeat.Choices}" SelectedIndex="{Binding Slots.Repeat.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.Repeat.Show, Converter={StaticResource BoolToVisibility}}" />
                        <ui:NumberBox x:Name="TimesBox" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="1" Maximum="100000"
                                      Value="{Binding Times, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Times}" Visibility="{Binding Slots.Repeat.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <ui:SettingsCard Header="{x:Static r:Strings.Action_PauseBetween}" Description="{x:Static r:Strings.Action_PauseBetweenDescription}"
                                 IsEnabled="{Binding PauseEnabled}"
                                 Visibility="{Binding ShowTimes, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="160" ItemsSource="{Binding Slots.RepeatPauseMs.Choices}" SelectedIndex="{Binding Slots.RepeatPauseMs.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.RepeatPauseMs.Show, Converter={StaticResource BoolToVisibility}}" />
                        <ui:NumberBox x:Name="PauseBox" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="0" Maximum="86400000"
                                      Value="{Binding PauseMs, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_PauseBetween}" Visibility="{Binding Slots.RepeatPauseMs.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static r:Strings.Action_UnitMs}" Visibility="{Binding Slots.RepeatPauseMs.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <!-- Loop: where the pointer is, or a fixed point, last -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Position}" Description="{Binding PointText}"
                                 Visibility="{Binding ShowPositionLast, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="16">
                        <views:PositionPicker X="{Binding X}" Y="{Binding Y}"
                                              Visibility="{Binding FixedPoint, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ToggleSwitch VerticalAlignment="Center" IsOn="{Binding FixedPoint, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_FixedPoint}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <!-- Paste text -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Text}" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"
                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Spacing="8">
                        <ComboBox HorizontalAlignment="Left" MinWidth="160" ItemsSource="{Binding Slots.Text.Choices}" SelectedIndex="{Binding Slots.Text.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.Text.Show, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox x:Name="PasteTextBox" MinHeight="64" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" ui:ControlHelper.PlaceholderText="{x:Static r:Strings.Action_TextToPaste}"
                                 AutomationProperties.Name="{x:Static r:Strings.Action_TextToPaste}"
                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Slots.Text.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>
                <ui:SettingsCard Header="{x:Static r:Strings.Action_EnterBefore}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <ui:ToggleSwitch IsOn="{Binding EnterBefore, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_EnterBefore}" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="{x:Static r:Strings.Action_EnterAfter}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <ui:ToggleSwitch IsOn="{Binding EnterAfter, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_EnterAfter}" />
                </ui:SettingsCard>

                <!-- Move to -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Movement}" Visibility="{Binding ShowMovement, Converter={StaticResource BoolToVisibility}}">
                    <ui:RadioButtons MaxColumns="2" SelectedIndex="{Binding MovementIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Movement}">
                        <RadioButton Content="{x:Static r:Strings.Action_Instantly}" />
                        <RadioButton Content="{x:Static r:Strings.Action_Smoothly}" />
                    </ui:RadioButtons>
                </ui:SettingsCard>
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Speed}" Description="{Binding SpeedText}"
                                 Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVisibility}}">
                    <Slider Width="200" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SmoothSpeed, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_MovementSpeed}" />
                </ui:SettingsCard>

                <!-- Scroll -->
                <ui:SettingsCard Header="{x:Static r:Strings.Action_Steps}" Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVisibility}}">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="160" ItemsSource="{Binding Slots.ScrollSteps.Choices}" SelectedIndex="{Binding Slots.ScrollSteps.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.ScrollSteps.Show, Converter={StaticResource BoolToVisibility}}" />
                        <ui:NumberBox x:Name="StepsBox" MinWidth="{StaticResource SettingsCardContentMinWidth}" Minimum="1" Maximum="1000"
                                      Value="{Binding Steps, Mode=TwoWay}" AutomationProperties.Name="{x:Static r:Strings.Action_Steps}" Visibility="{Binding Slots.ScrollSteps.ShowValue, Converter={StaticResource BoolToVisibility}}" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <!-- Key down, Key up: nothing to open. Its own key field, which never waits on its own (only the box's
             field of a new loop row does). -->
        <ui:SettingsCard Header="{Binding Title}" Description="{Binding Summary}"
                         Visibility="{Binding HasNoOptions, Converter={StaticResource BoolToVisibility}}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardClassic}" />
            </ui:SettingsCard.HeaderIcon>
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox MinWidth="160" ItemsSource="{Binding Slots.Key.Choices}" SelectedIndex="{Binding Slots.Key.Index, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static r:Strings.Param_ValueFrom}"
                                  Visibility="{Binding Slots.Key.Show, Converter={StaticResource BoolToVisibility}}" />
                <views:KeyCaptureField Value="{Binding Key}" StartOnLoad="{Binding CaptureOnLoad}" KeyOnly="True" AllowModifierAlone="True"
                                       CanClear="False" ItemName="key" Prompt="{Binding KeyPrompt}" Loaded="OnKeyFieldLoaded" Visibility="{Binding Slots.Key.ShowValue, Converter={StaticResource BoolToVisibility}}" />
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>
    </Grid>
</UserControl>
