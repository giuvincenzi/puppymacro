<UserControl
    x:Class="PuppyMacro.Views.ExportOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- What Export saves, shown in its ContentDialog: Everything, or the parts chosen below (approved design, ui.md) -->
    <UserControl.Resources>
        <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ui:RadioButtons x:Name="WhatBox" SelectedIndex="0" SelectionChanged="OnWhatChanged" AutomationProperties.Name="What to export">
            <RadioButton x:Name="EverythingButton" AutomationProperties.Name="Everything">
                <StackPanel>
                    <TextBlock Text="Everything" />
                    <TextBlock x:Name="EverythingText" Style="{StaticResource Description}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ChooseButton" Content="Choose what to export" />
        </ui:RadioButtons>

        <StackPanel x:Name="PartsPanel" Margin="28,4,0,0" IsEnabled="False">
            <CheckBox IsChecked="True" IsEnabled="False" AutomationProperties.Name="Loops, macros, remaps and settings">
                <StackPanel>
                    <TextBlock Text="Loops, macros, remaps and settings" />
                    <TextBlock x:Name="DataText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="HistoryBox" IsChecked="True" AutomationProperties.Name="History">
                <StackPanel>
                    <TextBlock Text="History" />
                    <TextBlock x:Name="HistoryText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="AiActivityBox" IsChecked="True" AutomationProperties.Name="AI activity">
                <StackPanel>
                    <TextBlock Text="AI activity" />
                    <TextBlock x:Name="AiActivityText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="LogsBox" IsChecked="True" AutomationProperties.Name="Logs">
                <StackPanel>
                    <TextBlock Text="Logs" />
                    <TextBlock x:Name="LogsText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </StackPanel>
</UserControl>
