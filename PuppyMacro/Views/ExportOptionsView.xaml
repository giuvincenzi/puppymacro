<UserControl
    x:Class="PuppyMacro.Views.ExportOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:r="clr-namespace:PuppyMacro.Resources">

    <!-- What Export saves, shown in its ContentDialog: Everything, or the parts chosen below (approved design, ui.md) -->
    <UserControl.Resources>
        <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ui:RadioButtons x:Name="WhatBox" SelectedIndex="0" SelectionChanged="OnWhatChanged" AutomationProperties.Name="{x:Static r:Strings.Export_WhatToExport}">
            <RadioButton x:Name="EverythingButton" AutomationProperties.Name="{x:Static r:Strings.Export_Everything}">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Export_Everything}" />
                    <TextBlock x:Name="EverythingText" Style="{StaticResource Description}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ChooseButton" Content="{x:Static r:Strings.Export_Choose}" />
        </ui:RadioButtons>

        <StackPanel x:Name="PartsPanel" Margin="28,4,0,0" IsEnabled="False">
            <CheckBox IsChecked="True" IsEnabled="False" AutomationProperties.Name="{x:Static r:Strings.Export_PartData}">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Export_PartData}" />
                    <TextBlock x:Name="DataText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="HistoryBox" IsChecked="True" AutomationProperties.Name="{x:Static r:Strings.Export_PartHistory}">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Export_PartHistory}" />
                    <TextBlock x:Name="HistoryText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="AiActivityBox" IsChecked="True" AutomationProperties.Name="{x:Static r:Strings.Export_PartAiActivity}">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Export_PartAiActivity}" />
                    <TextBlock x:Name="AiActivityText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="LogsBox" IsChecked="True" AutomationProperties.Name="{x:Static r:Strings.Export_PartLogs}">
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Export_PartLogs}" />
                    <TextBlock x:Name="LogsText" Style="{StaticResource Description}" />
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </StackPanel>
</UserControl>
