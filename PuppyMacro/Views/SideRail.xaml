<UserControl
    x:Class="PuppyMacro.Views.SideRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:fsi="clr-namespace:iNKORE.UI.WPF.Modern.Common.IconKeys;assembly=iNKORE.UI.WPF.Modern"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    Width="72">

    <!-- The main window's side rail, always closed, as in Microsoft Store (approved, ui.md): the pages on top and
         Settings at the bottom, two standard ListViews (selection, its animated accent pill, hover, arrow keys).
         Each page: its outline icon over its name; selected, the name fades out and the icon, filled and in the
         accent color, slides down to the middle (as in Microsoft Store). -->
    <UserControl.Resources>
        <!-- No inset on top (the library insets an item's background by 4 on every side): the first page's
             background starts where the pages' content layer starts, as in Microsoft Store; 4 between items stays -->
        <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">4,0,4,4</Thickness>
        <!-- MinWidth 0: the library's ListViewItemMinWidth (88) is wider than the rail and would cut the item -->
        <Style x:Key="RailItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Shown while the item is not selected: the outline icon and the name -->
        <Style x:Key="WhenNotSelected" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Shown while the item is selected: the filled icon in the accent color -->
        <Style x:Key="WhenSelected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Selecting a page (approved, ui.md): its name fades out and its icon (a Grid with a TranslateTransform, Tag
             "Icon") slides down by half the name's height and its margin, so it ends in the middle; back when another page
             is selected. The distance is measured (SideRail.Slide): a long name is shrunk, so its height differs. -->
        <!-- A page's name on one line, shrunk to fit the rail when it is longer (approved, ui.md: Microsoft Store does the
             same with "Downloads"): never larger than the caption style, never wider than the item. -->
        <Style x:Key="NameBox" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="MaxWidth" Value="60" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Name" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" KeySpline="0,0,0,1" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" KeySpline="0,0,0,1" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Two fixed icons per page: in 0.10.2 a FontIcon whose Icon changes after load can clear it (ui.md) -->
        <ListView x:Name="Pages" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static r:Strings.Rail_Pages}">
            <ListViewItem x:Name="LoopsItem" Tag="Loops" Style="{StaticResource RailItem}" AutomationProperties.Name="{x:Static r:Strings.Rail_Loops}" ToolTip="{x:Static r:Strings.Rail_Loops}">
                <StackPanel>
                    <Grid Tag="Icon">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.ArrowClockwiseDashes_20_Regular}" Style="{StaticResource WhenNotSelected}" />
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.ArrowClockwiseDashes_20_Filled}" Style="{StaticResource WhenSelected}"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <Viewbox Style="{StaticResource NameBox}">
                        <TextBlock Style="{StaticResource Name}" Text="{x:Static r:Strings.Rail_Loops}" />
                    </Viewbox>
                </StackPanel>
            </ListViewItem>
            <ListViewItem x:Name="MacrosItem" Tag="Macros" Style="{StaticResource RailItem}" AutomationProperties.Name="{x:Static r:Strings.Rail_Macros}" ToolTip="{x:Static r:Strings.Rail_Macros}">
                <StackPanel>
                    <Grid Tag="Icon">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.Script_20_Regular}" Style="{StaticResource WhenNotSelected}" />
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.Script_20_Filled}" Style="{StaticResource WhenSelected}"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <Viewbox Style="{StaticResource NameBox}">
                        <TextBlock Style="{StaticResource Name}" Text="{x:Static r:Strings.Rail_Macros}" />
                    </Viewbox>
                </StackPanel>
            </ListViewItem>
            <ListViewItem x:Name="RemapItem" Tag="Remap" Style="{StaticResource RailItem}" AutomationProperties.Name="{x:Static r:Strings.Rail_Remap}" ToolTip="{x:Static r:Strings.Rail_Remap}">
                <StackPanel>
                    <Grid Tag="Icon">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.ArrowRouting_20_Regular}" Style="{StaticResource WhenNotSelected}" />
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.ArrowRouting_20_Filled}" Style="{StaticResource WhenSelected}"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <Viewbox Style="{StaticResource NameBox}">
                        <TextBlock Style="{StaticResource Name}" Text="{x:Static r:Strings.Rail_Remap}" />
                    </Viewbox>
                </StackPanel>
            </ListViewItem>
        </ListView>

        <ListView x:Name="Footer" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static r:Strings.Rail_SettingsAndHelp}">
            <!-- The library's 4 inset on every side, as Library in Microsoft Store (the rail's 4,0,4,4 is only for the top) -->
            <ListView.Resources>
                <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">4</Thickness>
            </ListView.Resources>
            <ListViewItem x:Name="AiItem" Tag="AI" Style="{StaticResource RailItem}" AutomationProperties.Name="{x:Static r:Strings.Rail_Ai}" ToolTip="{x:Static r:Strings.Rail_Ai}">
                <StackPanel>
                    <Grid Tag="Icon">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.BotSparkle_20_Regular}" Style="{StaticResource WhenNotSelected}" />
                        <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.BotSparkle_20_Filled}" Style="{StaticResource WhenSelected}"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <Viewbox Style="{StaticResource NameBox}">
                        <TextBlock Style="{StaticResource Name}" Text="{x:Static r:Strings.Rail_Ai}" />
                    </Viewbox>
                </StackPanel>
            </ListViewItem>
            <ListViewItem x:Name="SettingsItem" Tag="Settings" Style="{StaticResource RailItem}" AutomationProperties.Name="{x:Static r:Strings.Rail_Settings}" ToolTip="{x:Static r:Strings.Rail_Settings}">
                <Grid>
                    <StackPanel>
                        <Grid Tag="Icon">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <!-- As wide as the icon, so the dot sits on its top-right corner and moves with it -->
                            <Grid HorizontalAlignment="Center">
                                <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.Settings_20_Regular}" Style="{StaticResource WhenNotSelected}" />
                                <ui:FontIcon FontSize="20" Icon="{x:Static fsi:FluentSystemIcons.Settings_20_Filled}" Style="{StaticResource WhenSelected}"
                                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <!-- While an update is available, as the dot on Downloads in Microsoft Store (measured): 6 px,
                                     7 px right of the icon and 3 px above it -->
                                <ui:InfoBadge x:Name="UpdateDot" Width="6" Height="6" Margin="0,-3,-13,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Style="{StaticResource AttentionDotInfoBadgeStyle}" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <Viewbox Style="{StaticResource NameBox}">
                            <TextBlock Style="{StaticResource Name}" Text="{x:Static r:Strings.Rail_Settings}" />
                        </Viewbox>
                    </StackPanel>
                </Grid>
            </ListViewItem>
        </ListView>
    </Grid>
</UserControl>
