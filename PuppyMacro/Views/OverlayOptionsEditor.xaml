<UserControl
    x:Class="PuppyMacro.Views.OverlayOptionsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:views="clr-namespace:PuppyMacro.Views">

    <!-- Show in overlay expander, shared by the loop and macro editors -->
    <views:SwitchSettingsExpander x:Name="OverlayExpander" Header="{x:Static r:Strings.OverlayOptions_Show}"
                                  CanExpand="{Binding IsOn, ElementName=ShowSwitch}"
                                  Description="{x:Static r:Strings.OverlayOptions_ShowDescription}">
        <ui:ToggleSwitch x:Name="ShowSwitch" Toggled="OnShowSwitchChanged" AutomationProperties.Name="{x:Static r:Strings.OverlayOptions_Show}" />

        <ui:SettingsExpander.Items>
            <ui:SettingsCard Header="{x:Static r:Strings.OverlayOptions_HideWhenDisabled}" Description="{x:Static r:Strings.OverlayOptions_HideWhenDisabledDescription}">
                <ui:ToggleSwitch x:Name="HideWhenDisabledSwitch" AutomationProperties.Name="{x:Static r:Strings.OverlayOptions_HideWhenDisabled}" />
            </ui:SettingsCard>
            <ui:SettingsCard Header="{x:Static r:Strings.OverlayOptions_PassThrough}" Description="{x:Static r:Strings.OverlayOptions_PassThroughDescription}">
                <ui:ToggleSwitch x:Name="PassThroughSwitch" AutomationProperties.Name="{x:Static r:Strings.OverlayOptions_PassThrough}" />
            </ui:SettingsCard>
        </ui:SettingsExpander.Items>
    </views:SwitchSettingsExpander>
</UserControl>
