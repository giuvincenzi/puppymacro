<UserControl
    x:Class="PuppyMacro.Views.OverlayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White">

    <UserControl.Resources>
        <Style x:Key="HintKey" TargetType="Border">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="#4C4C4C" />
            <Setter Property="Background" Value="#373737" />
        </Style>
        <DataTemplate x:Key="PanelRow">
                    <Grid Margin="0,0,0,6">
                        <!-- Disabled: a dashed outline instead of the row's fill and border (a Border cannot be dashed) -->
                        <Rectangle x:Name="DisabledFrame" RadiusX="6" RadiusY="6" Stroke="#47FFFFFF" StrokeThickness="1"
                                   StrokeDashArray="4 3" Visibility="Collapsed" />
                        <Border x:Name="Row" Padding="10,7" CornerRadius="6" BorderThickness="1"
                                Background="#0AFFFFFF" BorderBrush="#0FFFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#6E6E6E" StrokeThickness="1.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="NameText" Grid.Column="1" Margin="8,0" FontSize="13" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2"
                                        BorderBrush="#4C4C4C" Background="#373737" VerticalAlignment="Center"
                                        Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock x:Name="HotkeyText" FontSize="11" Text="{Binding HotkeyText}" />
                                </Border>
                                <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="11" Foreground="#C5C5C5"
                                           Text="{Binding Status}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#246CCB5F" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="#736CCB5F" />
                                <Setter TargetName="Dot" Property="Fill" Value="#6CCB5F" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="#6CCB5F" />
                            </DataTrigger>
                            <!-- Disabled: dashed outline, hollow dot, grey name (no color of its own: it must not stand out) -->
                            <DataTrigger Binding="{Binding IsItemEnabled}" Value="False">
                                <Setter TargetName="DisabledFrame" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Row" Property="Background" Value="Transparent" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                                <Setter TargetName="Dot" Property="Stroke" Value="#9E9E9E" />
                                <Setter TargetName="NameText" Property="Foreground" Value="#8A8A8A" />
                                <Setter TargetName="HotkeyText" Property="Foreground" Value="#8A8A8A" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
    </UserControl.Resources>

    <!-- Fixed dark look: it sits on top of fullscreen apps in any theme. Background alpha comes from Settings. -->
    <Border x:Name="PanelBorder" Width="260" Padding="12" CornerRadius="8" BorderThickness="1"
            Background="#D9202020" BorderBrush="#1AFFFFFF">
        <StackPanel>
            <!-- Title, and the move, exit and open buttons on the right. As every button here, the input hook
                 handles them (PanelTarget): the window never gets the mouse and the app keeps the focus. -->
            <Grid Margin="2,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="14" Height="14" VerticalAlignment="Center" Source="pack://application:,,,/Assets/PuppyMacro-256.png" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Text="PuppyMacro"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- Press and drag to move the panel (PanelTarget.MoveOverlayId). -->
                <Border x:Name="MoveButton" Grid.Column="2" Width="26" Height="26" Margin="0,0,6,0" CornerRadius="5" BorderThickness="1"
                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" AutomationProperties.Name="Move the panel" ToolTip="Drag to move the panel">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.3"
                          Data="M6,1 V11 M1,6 H11 M4.5,2.5 L6,1 L7.5,2.5 M4.5,9.5 L6,11 L7.5,9.5 M2.5,4.5 L1,6 L2.5,7.5 M9.5,4.5 L11,6 L9.5,7.5" />
                </Border>
                <!-- Leaves overlay mode as the Overlay mode hotkey does (PanelTarget.ExitOverlayId). -->
                <Border x:Name="ExitButton" Grid.Column="3" Width="26" Height="26" Margin="0,0,6,0" CornerRadius="5" BorderThickness="1"
                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" AutomationProperties.Name="Exit overlay mode">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.3"
                          Data="M5,2 H2 V10 H5 M8,3.5 L10.5,6 L8,8.5 M10.5,6 H5" />
                </Border>
                <!-- Leaves overlay mode and opens the main window (PanelTarget.OpenMainOverlayId). The Fluent "Open" icon. -->
                <Border x:Name="OpenButton" Grid.Column="4" Width="26" Height="26" CornerRadius="5" BorderThickness="1"
                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" AutomationProperties.Name="Exit and open PuppyMacro"
                        ToolTip="Exit overlay mode and open PuppyMacro">
                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.3"
                          Data="M5,1.5 H2.5 A1,1 0 0 0 1.5,2.5 V9.5 A1,1 0 0 0 2.5,10.5 H9.5 A1,1 0 0 0 10.5,9.5 V7 M7,1.5 H10.5 V5 M10.5,1.5 L5.5,6.5" />
                </Border>
            </Grid>

            <TextBlock x:Name="EmptyText" Margin="2,0,0,6" FontSize="12" Foreground="#C5C5C5"
                       Text="Nothing to show." Visibility="Collapsed" />

            <ItemsControl x:Name="LoopList" ItemTemplate="{StaticResource PanelRow}" />

            <TextBlock x:Name="MacrosHeader" Margin="2,4,0,6" FontSize="11" Foreground="#9E9E9E" Text="Macros" Visibility="Collapsed" />
            <ItemsControl x:Name="MacroList" ItemTemplate="{StaticResource PanelRow}" />

            <!-- Stop all, with its hotkey: red while something runs and it can be clicked (PanelTarget.StopAllId) -->
            <Border x:Name="StopAllButton" Margin="0,4,0,0" Height="30" CornerRadius="5" BorderThickness="1"
                    Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" AutomationProperties.Name="Stop all">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="StopAllSquare" Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#9E9E9E" VerticalAlignment="Center" />
                    <TextBlock x:Name="StopAllLabel" Margin="8,0,8,0" FontSize="12" Foreground="#C5C5C5" Text="Stop all" VerticalAlignment="Center" />
                    <Border Style="{StaticResource HintKey}" MinWidth="0" VerticalAlignment="Center">
                        <TextBlock x:Name="StopAllHotkeyText" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- What the clicks do, while the rows can be clicked -->
            <TextBlock x:Name="ClickHint" Margin="2,8,2,0" FontSize="11" Foreground="#9E9E9E" TextAlignment="Center"
                       TextWrapping="Wrap" Text="Click: start / stop · Right-click: enable / disable" />
        </StackPanel>
    </Border>
</UserControl>
