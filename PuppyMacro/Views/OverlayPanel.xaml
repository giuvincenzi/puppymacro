<UserControl
    x:Class="PuppyMacro.Views.OverlayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PuppyMacro.Views"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="White">

    <UserControl.Resources>
        <Style x:Key="HintKey" TargetType="Border">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="#4C4C4C" />
            <Setter Property="Background" Value="#373737" />
        </Style>
        <DataTemplate x:Key="PanelRow">
                        <Border x:Name="Row" Margin="0,0,0,6" Padding="10,7" CornerRadius="6" BorderThickness="1"
                                Background="#0AFFFFFF" BorderBrush="#0FFFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#6E6E6E" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0" FontSize="13" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Padding="6,0" CornerRadius="4" BorderThickness="1,1,1,2"
                                        BorderBrush="#4C4C4C" Background="#373737" VerticalAlignment="Center"
                                        Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11" Text="{Binding HotkeyText}" />
                                </Border>
                                <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="11" Foreground="#C5C5C5"
                                           Text="{Binding Status}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#246CCB5F" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="#736CCB5F" />
                                <Setter TargetName="Dot" Property="Fill" Value="#6CCB5F" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="#6CCB5F" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
    </UserControl.Resources>

    <!-- Fixed dark look: it sits on top of fullscreen apps in any theme. Background alpha comes from Settings. -->
    <Border x:Name="PanelBorder" Width="260" Padding="12" CornerRadius="8" BorderThickness="1"
            Background="#D9202020" BorderBrush="#1AFFFFFF">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                <Image Width="14" Height="14" Source="pack://application:,,,/Assets/PuppyMacro-256.png" />
                <TextBlock x:Name="TitleText" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Text="PuppyMacro" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="EmptyText" Margin="2,0,0,6" FontSize="12" Foreground="#C5C5C5"
                       Text="No enabled loops." Visibility="Collapsed" />

            <ItemsControl x:Name="LoopList" ItemTemplate="{StaticResource PanelRow}" />

            <TextBlock x:Name="MacrosHeader" Margin="2,4,0,6" FontSize="11" Foreground="#9E9E9E" Text="Macros" Visibility="Collapsed" />
            <ItemsControl x:Name="MacroList" ItemTemplate="{StaticResource PanelRow}" />

            <!-- Global hotkeys, one per line -->
            <Border Margin="0,2,0,0" Padding="2,8,0,0" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource HintKey}">
                            <TextBlock x:Name="StopAllHotkeyText" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="#C5C5C5" Text="Stop all" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource HintKey}">
                            <TextBlock x:Name="ExitHotkeyText" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="#C5C5C5" Text="Exit overlay mode" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
