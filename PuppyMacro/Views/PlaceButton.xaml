<UserControl
    x:Class="PuppyMacro.Views.PlaceButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf">

    <!-- Every button that picks something on the screen (Pick on screen, Specific app's Pick: Bullseye) or moves the
         overlay (a floating button's Position, Settings' Position on screen: Move), the icon before its text. One
         FontIcon per icon, shown or hidden (ui.md: a FontIcon's Icon never changes). -->
    <Button x:Name="TheButton" Click="OnClick">
        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
            <Grid VerticalAlignment="Center">
                <ui:FontIcon x:Name="PickIcon" FontSize="14" Icon="{x:Static ui:SegoeFluentIcons.Bullseye}" />
                <ui:FontIcon x:Name="MoveIcon" FontSize="14" Icon="{x:Static ui:SegoeFluentIcons.Move}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="Label" VerticalAlignment="Center" />
        </ikw:SimpleStackPanel>
    </Button>
</UserControl>
