<UserControl
    x:Class="PuppyMacro.Views.MacroShortcutsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:PuppyMacro.Resources"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf">

    <!-- The macro editor's shortcuts, shown by Shortcuts in a ContentDialog: keys on the left, what they do on the right -->
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Keys" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,4,24,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="What" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Plus" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ikw:SimpleStackPanel MaxWidth="440" Grid.IsSharedSizeScope="True">
        <TextBlock Style="{StaticResource Section}" Margin="0,0,0,4" Text="{x:Static r:Strings.Shortcuts_Select}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Ctrl}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Shortcuts_Click}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_CtrlClick}" />
            <StackPanel Grid.Row="1" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Shift}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Shortcuts_Click}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_ShiftClick}" />
        </Grid>

        <TextBlock Style="{StaticResource Section}" Text="{x:Static r:Strings.Shortcuts_Move}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Style="{StaticResource Keys}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Shortcuts_Drag}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_DragWhat}" />
            <StackPanel Grid.Row="1" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Alt}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="↑" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="/" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="↓" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_MoveUpDown}" />
        </Grid>

        <TextBlock Style="{StaticResource Section}" Text="{x:Static r:Strings.Shortcuts_Edit}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Style="{StaticResource Keys}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Shortcuts_DoubleClick}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_DoubleClickWhat}" />
            <StackPanel Grid.Row="1" Style="{StaticResource Keys}">
                <TextBlock VerticalAlignment="Center" Text="{x:Static r:Strings.Shortcuts_RightClick}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_RightClickWhat}" />
            <StackPanel Grid.Row="2" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Ctrl}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="G" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_Group}" />
            <StackPanel Grid.Row="3" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Ctrl}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="D" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_Duplicate}" />
            <StackPanel Grid.Row="4" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Ctrl}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="C" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_Copy}" />
            <StackPanel Grid.Row="5" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Ctrl}" /></Border>
                <TextBlock Style="{StaticResource Plus}" Text="+" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="V" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_Paste}" />
            <StackPanel Grid.Row="6" Style="{StaticResource Keys}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{x:Static r:Strings.Keys_Delete}" /></Border>
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource What}" Text="{x:Static r:Strings.Shortcuts_Delete}" />
        </Grid>

        <TextBlock Margin="0,16,0,0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static r:Strings.Shortcuts_Note}" />
    </ikw:SimpleStackPanel>
</UserControl>
