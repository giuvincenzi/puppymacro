<Project Sdk="Microsoft.NET.Sdk">

  <!-- <Version>: in its own file, so that only a release changes it (Version.props). -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PuppyMacro</AssemblyName>
    <RootNamespace>PuppyMacro</RootNamespace>
    <Product>PuppyMacro</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PuppyMacro.ico</ApplicationIcon>
    <!-- Main is in App.xaml.cs: Velopack must run before WPF starts. -->
    <StartupObject>PuppyMacro.App</StartupObject>

    <!-- Framework-dependent (uses the .NET 10 Desktop Runtime).
         Publish with the Folder profile in Properties\PublishProfiles. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <!-- Services/Screen reads captured frames and GPU buffers through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- The macro editor's Code view (Monaco in Assets\Monaco). The runtime comes with Windows 11;
         the Setup installs it when missing (the vpk framework "webview2" in scripts\build.ps1). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- The MCP server AI apps use (Services/Ai): the official C# SDK, its core only (no generic host). -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- The macros' Image conditions (Services/Screen): template matching on the processor. The slim runtime: OpenCV's
         core and imgproc without video, dnn and GUI. -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
    <!-- Declarations of the Windows APIs Services/Screen uses (DXGI, Direct3D 11, display config), written at build time
         from NativeMethods.txt: nothing is shipped. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all" />
  </ItemGroup>

  <!-- The app's texts (i18n.md): Strings.resx in English, Strings.<language>.resx the translations. The Strings class
       (public, so XAML can use {x:Static r:Strings.Key}) is written from Strings.resx before the XAML is compiled: WPF
       compiles the XAML in a temporary project that runs before the usual resource step, so the class must exist
       earlier, and it is a plain Compile item so that project sees it too. -->
  <PropertyGroup>
    <!-- Under obj\ (BaseIntermediateOutputPath is set before this file; IntermediateOutputPath only after it). -->
    <StringsClassFile>$(BaseIntermediateOutputPath)generated\Strings.Designer.cs</StringsClassFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(StringsClassFile)" />
  </ItemGroup>
  <Target Name="GenerateStringsClass" BeforeTargets="MarkupCompilePass1;CoreCompile"
          Inputs="Resources\Strings.resx" Outputs="$(StringsClassFile)">
    <MakeDir Directories="$(BaseIntermediateOutputPath)generated" />
    <GenerateResource Sources="Resources\Strings.resx" OutputResources="$(BaseIntermediateOutputPath)generated\Strings.resources"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="PuppyMacro.Resources"
                      StronglyTypedClassName="Strings" StronglyTypedManifestPrefix="PuppyMacro.Resources"
                      StronglyTypedFileName="$(StringsClassFile)" PublicClass="true" ExecuteAsTool="false" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="PuppyMacro.Tests" />
  </ItemGroup>

  <!-- App.xaml as a Page, so WPF does not generate its own Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PuppyMacro-256.png" />
    <Resource Include="Assets\PuppyMacro.ico" />
    <Resource Include="Assets\Sounds\*.wav" />
  </ItemGroup>

  <!-- The user guide of this version, for the AI tool get_help (Services/Ai/AiHelp). -->
  <ItemGroup>
    <EmbeddedResource Include="..\site\guide\*.html" Exclude="..\site\guide\_page.html" LogicalName="PuppyMacro.Guide.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\site\guide\sections.txt" LogicalName="PuppyMacro.Guide.sections.txt" />
  </ItemGroup>

  <!-- Files the Code view's WebView2 loads from disk (AppPaths.WebAssetsFolder). -->
  <ItemGroup>
    <Content Include="Assets\CodeEditor\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Monaco\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The icons File Explorer shows for .puppyitems and .puppymacro files (Services/FileTypes, scripts/file-icons.ps1). -->
  <ItemGroup>
    <Content Include="Assets\FileIcons\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
